  (:NAME "REM-FIXTURE" :KIND :FUNCTION :LAMBDA-LIST "(key)" :ORIGIN "fiveam")
  (:NAME "REM-TEST" :KIND :FUNCTION :LAMBDA-LIST "(key)" :ORIGIN "fiveam")
  (:NAME "RESULTS-STATUS" :KIND :FUNCTION :LAMBDA-LIST "(result-list)" :DOCSTRING "Given a list of test results (generated while running a test)
  return true if no results are of type TEST-FAILURE.  Returns second
  and third values, which are the set of failed tests and skipped
  tests respectively." :ORIGIN "fiveam")
  (:NAME "RUN" :KIND :FUNCTION :LAMBDA-LIST "(test-spec &key ((:print-names *print-names*) *print-names*))" :DOCSTRING "Run the test specified by TEST-SPEC.

