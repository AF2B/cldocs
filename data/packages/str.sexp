  (:NAME "COUNT-SUBSTRING" :KIND :FUNCTION :LAMBDA-LIST "(substring s &key (start 0) (end nil) (ignore-case *ignore-case*))" :DOCSTRING "Return the non-overlapping occurrences of `substring' in `s'.
