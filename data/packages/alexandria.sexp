  (:NAME "BINOMIAL-COEFFICIENT" :KIND :FUNCTION :LAMBDA-LIST "(n k)" :DOCSTRING "Binomial coefficient of N and K, also expressed as N choose K. This is the
number of K element combinations given N choises. N must be equal to or
greater then K." :ORIGIN "alexandria")
  (:NAME "CIRCULAR-LIST" :KIND :FUNCTION :LAMBDA-LIST "(&rest elements)" :DOCSTRING "Creates a circular list of ELEMENTS." :ORIGIN "alexandria")
  (:NAME "CIRCULAR-LIST" :KIND :TYPE :DOCSTRING "Type designator for circular lists. Implemented as a SATISFIES type, so not
recommended for performance intensive use. Main usefullness as the
expected-type designator of a TYPE-ERROR." :ORIGIN "alexandria")
  (:NAME "CIRCULAR-LIST-P" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Returns true if OBJECT is a circular list, NIL otherwise." :ORIGIN "alexandria")
  (:NAME "CIRCULAR-TREE-P" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Returns true if OBJECT is a circular tree, NIL otherwise." :ORIGIN "alexandria")
  (:NAME "CLAMP" :KIND :FUNCTION :LAMBDA-LIST "(number min max)" :DOCSTRING "Clamps the NUMBER into [min, max] range. Returns MIN if NUMBER is lesser then
MIN and MAX if NUMBER is greater then MAX, otherwise returns NUMBER." :ORIGIN "alexandria")
  (:NAME "COERCEF" :KIND :MACRO :LAMBDA-LIST "(place type-spec)" :DOCSTRING "Modify-macro for COERCE." :ORIGIN "alexandria")
  (:NAME "COMPOSE" :KIND :FUNCTION :LAMBDA-LIST "(function &rest more-functions)" :DOCSTRING "Returns a function composed of FUNCTION and MORE-FUNCTIONS that applies its
arguments to to each in turn, starting from the rightmost of MORE-FUNCTIONS,
and then calling the next one with the primary value of the last." :ORIGIN "alexandria")
  (:NAME "CONJOIN" :KIND :FUNCTION :LAMBDA-LIST "(predicate &rest more-predicates)" :DOCSTRING "Returns a function that applies each of PREDICATE and MORE-PREDICATE
functions in turn to its arguments, returning NIL if any of the predicates
returns false, without calling the remaining predicates. If none of the
predicates returns false, returns the primary value of the last predicate." :ORIGIN "alexandria")
  (:NAME "COPY-ARRAY" :KIND :FUNCTION :LAMBDA-LIST "(array &key (element-type (array-element-type array)) (fill-pointer (and (array-has-fill-pointer-p array) (fill-pointer array))) (adjustable (adjustable-array-p array)))" :DOCSTRING "Returns an undisplaced copy of ARRAY, with same fill-pointer and
adjustability (if any) as the original, unless overridden by the keyword
arguments." :ORIGIN "alexandria")
  (:NAME "COPY-FILE" :KIND :FUNCTION :LAMBDA-LIST "(from to &key (if-to-exists :supersede) (element-type '(unsigned-byte 8)) finish-output)" :ORIGIN "alexandria")
  (:NAME "COPY-HASH-TABLE" :KIND :FUNCTION :LAMBDA-LIST "(table &key key test size rehash-size rehash-threshold)" :DOCSTRING "Returns a copy of hash table TABLE, with the same keys and values
as the TABLE. The copy has the same properties as the original, unless
overridden by the keyword arguments.

Before each of the original values is set into the new hash-table, KEY
is invoked on the value. As KEY defaults to CL:IDENTITY, a shallow
copy is returned by default." :ORIGIN "alexandria")
  (:NAME "COPY-SEQUENCE" :KIND :FUNCTION :LAMBDA-LIST "(type sequence)" :DOCSTRING "Returns a fresh sequence of TYPE, which has the same elements as
SEQUENCE." :ORIGIN "alexandria")
  (:NAME "COPY-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(input output &key (element-type (stream-element-type input)) (buffer-size 4096) (buffer (make-array buffer-size :element-type element-type)) (start 0) end finish-output)" :DOCSTRING "Reads data from INPUT and writes it to OUTPUT. Both INPUT and OUTPUT must
be streams, they will be passed to READ-SEQUENCE and WRITE-SEQUENCE and must have
compatible element-types." :ORIGIN "alexandria")
  (:NAME "COUNT-PERMUTATIONS" :KIND :FUNCTION :LAMBDA-LIST "(n &optional (k n))" :DOCSTRING "Number of K element permutations for a sequence of N objects.
K defaults to N" :ORIGIN "alexandria")
  (:NAME "CSWITCH" :KIND :MACRO :LAMBDA-LIST "((object &key (test 'eql) (key 'identity)) &body clauses)" :DOCSTRING "Like SWITCH, but signals a continuable error if no key matches." :ORIGIN "alexandria")
  (:NAME "CURRY" :KIND :FUNCTION :LAMBDA-LIST "(function &rest arguments)" :DOCSTRING "Returns a function that applies ARGUMENTS and the arguments
it is called with to FUNCTION." :ORIGIN "alexandria")
  (:NAME "DEFINE-CONSTANT" :KIND :MACRO :LAMBDA-LIST "(name initial-value &key (test ''eql) documentation)" :DOCSTRING "Ensures that the global variable named by NAME is a constant with a value
that is equal under TEST to the result of evaluating INITIAL-VALUE. TEST is a
/function designator/ that defaults to EQL. If DOCUMENTATION is given, it
becomes the documentation string of the constant.

Signals an error if NAME is already a bound non-constant variable.

Signals an error if NAME is already a constant variable whose value is not
equal under TEST to result of evaluating INITIAL-VALUE." :ORIGIN "alexandria")
  (:NAME "DELETE-FROM-PLIST" :KIND :FUNCTION :LAMBDA-LIST "(plist &rest keys)" :DOCSTRING "Just like REMOVE-FROM-PLIST, but this version may destructively modify the
provided PLIST." :ORIGIN "alexandria")
  (:NAME "DELETE-FROM-PLISTF" :KIND :MACRO :LAMBDA-LIST "(place &rest keys)" :DOCSTRING "Modify macro for DELETE-FROM-PLIST." :ORIGIN "alexandria")
  (:NAME "DELETEF" :KIND :MACRO :LAMBDA-LIST "(place item &rest keyword-arguments)" :DOCSTRING "Modify-macro for DELETE. Sets place designated by the first argument to
the result of calling DELETE with ITEM, place, and the KEYWORD-ARGUMENTS." :ORIGIN "alexandria")
  (:NAME "DESTRUCTURING-CASE" :KIND :MACRO :LAMBDA-LIST "(keyform &body clauses)" :DOCSTRING "DESTRUCTURING-CASE, -CCASE, and -ECASE are a combination of CASE and DESTRUCTURING-BIND.
KEYFORM must evaluate to a CONS.

Clauses are of the form:

  ((CASE-KEYS . DESTRUCTURING-LAMBDA-LIST) FORM*)

The clause whose CASE-KEYS matches CAR of KEY, as if by CASE, CCASE, or ECASE,
is selected, and FORMs are then executed with CDR of KEY is destructured and
bound by the DESTRUCTURING-LAMBDA-LIST.

Example:

 (defun dcase (x)
   (destructuring-case x
     ((:foo a b)
      (format nil \"foo: ~S, ~S\" a b))
     ((:bar &key a b)
      (format nil \"bar: ~S, ~S\" a b))
     (((:alt1 :alt2) a)
      (format nil \"alt: ~S\" a))
     ((t &rest rest)
      (format nil \"unknown: ~S\" rest))))

  (dcase (list :foo 1 2))        ; => \"foo: 1, 2\"
  (dcase (list :bar :a 1 :b 2))  ; => \"bar: 1, 2\"
  (dcase (list :alt1 1))         ; => \"alt: 1\"
  (dcase (list :alt2 2))         ; => \"alt: 2\"
  (dcase (list :quux 1 2 3))     ; => \"unknown: 1, 2, 3\"

 (defun decase (x)
   (destructuring-case x
     ((:foo a b)
      (format nil \"foo: ~S, ~S\" a b))
     ((:bar &key a b)
      (format nil \"bar: ~S, ~S\" a b))
     (((:alt1 :alt2) a)
      (format nil \"alt: ~S\" a))))

  (decase (list :foo 1 2))        ; => \"foo: 1, 2\"
  (decase (list :bar :a 1 :b 2))  ; => \"bar: 1, 2\"
  (decase (list :alt1 1))         ; => \"alt: 1\"
  (decase (list :alt2 2))         ; => \"alt: 2\"
  (decase (list :quux 1 2 3))     ; =| error
" :ORIGIN "alexandria")
  (:NAME "DESTRUCTURING-CCASE" :KIND :MACRO :LAMBDA-LIST "(keyform &body clauses)" :DOCSTRING "DESTRUCTURING-CASE, -CCASE, and -ECASE are a combination of CASE and DESTRUCTURING-BIND.
KEYFORM must evaluate to a CONS.

Clauses are of the form:

  ((CASE-KEYS . DESTRUCTURING-LAMBDA-LIST) FORM*)

The clause whose CASE-KEYS matches CAR of KEY, as if by CASE, CCASE, or ECASE,
is selected, and FORMs are then executed with CDR of KEY is destructured and
bound by the DESTRUCTURING-LAMBDA-LIST.

Example:

 (defun dcase (x)
   (destructuring-case x
     ((:foo a b)
      (format nil \"foo: ~S, ~S\" a b))
     ((:bar &key a b)
      (format nil \"bar: ~S, ~S\" a b))
     (((:alt1 :alt2) a)
      (format nil \"alt: ~S\" a))
     ((t &rest rest)
      (format nil \"unknown: ~S\" rest))))

  (dcase (list :foo 1 2))        ; => \"foo: 1, 2\"
  (dcase (list :bar :a 1 :b 2))  ; => \"bar: 1, 2\"
  (dcase (list :alt1 1))         ; => \"alt: 1\"
  (dcase (list :alt2 2))         ; => \"alt: 2\"
  (dcase (list :quux 1 2 3))     ; => \"unknown: 1, 2, 3\"

 (defun decase (x)
   (destructuring-case x
     ((:foo a b)
      (format nil \"foo: ~S, ~S\" a b))
     ((:bar &key a b)
      (format nil \"bar: ~S, ~S\" a b))
     (((:alt1 :alt2) a)
      (format nil \"alt: ~S\" a))))

  (decase (list :foo 1 2))        ; => \"foo: 1, 2\"
  (decase (list :bar :a 1 :b 2))  ; => \"bar: 1, 2\"
  (decase (list :alt1 1))         ; => \"alt: 1\"
  (decase (list :alt2 2))         ; => \"alt: 2\"
  (decase (list :quux 1 2 3))     ; =| error
" :ORIGIN "alexandria")
  (:NAME "DESTRUCTURING-ECASE" :KIND :MACRO :LAMBDA-LIST "(keyform &body clauses)" :DOCSTRING "DESTRUCTURING-CASE, -CCASE, and -ECASE are a combination of CASE and DESTRUCTURING-BIND.
KEYFORM must evaluate to a CONS.

Clauses are of the form:

  ((CASE-KEYS . DESTRUCTURING-LAMBDA-LIST) FORM*)

The clause whose CASE-KEYS matches CAR of KEY, as if by CASE, CCASE, or ECASE,
is selected, and FORMs are then executed with CDR of KEY is destructured and
bound by the DESTRUCTURING-LAMBDA-LIST.

Example:

 (defun dcase (x)
   (destructuring-case x
     ((:foo a b)
      (format nil \"foo: ~S, ~S\" a b))
     ((:bar &key a b)
      (format nil \"bar: ~S, ~S\" a b))
     (((:alt1 :alt2) a)
      (format nil \"alt: ~S\" a))
     ((t &rest rest)
      (format nil \"unknown: ~S\" rest))))

  (dcase (list :foo 1 2))        ; => \"foo: 1, 2\"
  (dcase (list :bar :a 1 :b 2))  ; => \"bar: 1, 2\"
  (dcase (list :alt1 1))         ; => \"alt: 1\"
  (dcase (list :alt2 2))         ; => \"alt: 2\"
  (dcase (list :quux 1 2 3))     ; => \"unknown: 1, 2, 3\"

 (defun decase (x)
   (destructuring-case x
     ((:foo a b)
      (format nil \"foo: ~S, ~S\" a b))
     ((:bar &key a b)
      (format nil \"bar: ~S, ~S\" a b))
     (((:alt1 :alt2) a)
      (format nil \"alt: ~S\" a))))

  (decase (list :foo 1 2))        ; => \"foo: 1, 2\"
  (decase (list :bar :a 1 :b 2))  ; => \"bar: 1, 2\"
  (decase (list :alt1 1))         ; => \"alt: 1\"
  (decase (list :alt2 2))         ; => \"alt: 2\"
  (decase (list :quux 1 2 3))     ; =| error
" :ORIGIN "alexandria")
  (:NAME "DISJOIN" :KIND :FUNCTION :LAMBDA-LIST "(predicate &rest more-predicates)" :DOCSTRING "Returns a function that applies each of PREDICATE and MORE-PREDICATE
functions in turn to its arguments, returning the primary value of the first
predicate that returns true, without calling the remaining predicates.
If none of the predicates returns true, NIL is returned." :ORIGIN "alexandria")
  (:NAME "DOPLIST" :KIND :MACRO :LAMBDA-LIST "((key val plist &optional values) &body body)" :DOCSTRING "Iterates over elements of PLIST. BODY can be preceded by
declarations, and is like a TAGBODY. RETURN may be used to terminate
the iteration early. If RETURN is not used, returns VALUES." :ORIGIN "alexandria")
  (:NAME "EMPTYP" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(sequence)" :DOCSTRING "Returns T if SEQUENCE is an empty sequence and NIL
   otherwise. Signals an error if SEQUENCE is not a sequence." :ORIGIN "alexandria")
  (:NAME "ENDS-WITH" :KIND :FUNCTION :LAMBDA-LIST "(object sequence &key (test (function eql)) (key (function identity)))" :DOCSTRING "Returns true if SEQUENCE is a sequence whose last element is EQL to OBJECT.
Returns NIL if the SEQUENCE is not a sequence or is an empty sequence. Signals
an error if SEQUENCE is an improper list." :ORIGIN "alexandria")
  (:NAME "ENDS-WITH-SUBSEQ" :KIND :FUNCTION :LAMBDA-LIST "(suffix sequence &key (test (function eql)))" :DOCSTRING "Test whether SEQUENCE ends with SUFFIX. In other words: return true if
the last (length SUFFIX) elements of SEQUENCE are equal to SUFFIX." :ORIGIN "alexandria")
  (:NAME "ENSURE-CAR" :KIND :FUNCTION :LAMBDA-LIST "(thing)" :DOCSTRING "If THING is a CONS, its CAR is returned. Otherwise THING is returned." :ORIGIN "alexandria")
  (:NAME "ENSURE-CONS" :KIND :FUNCTION :LAMBDA-LIST "(cons)" :DOCSTRING "If CONS is a cons, it is returned. Otherwise returns a fresh cons with CONS
  in the car, and NIL in the cdr." :ORIGIN "alexandria")
  (:NAME "ENSURE-FUNCTION" :KIND :FUNCTION :LAMBDA-LIST "(function-designator)" :DOCSTRING "Returns the function designated by FUNCTION-DESIGNATOR:
if FUNCTION-DESIGNATOR is a function, it is returned, otherwise
it must be a function name and its FDEFINITION is returned." :ORIGIN "alexandria")
  (:NAME "ENSURE-FUNCTIONF" :KIND :MACRO :LAMBDA-LIST "(&rest places)" :DOCSTRING "Multiple-place modify macro for ENSURE-FUNCTION: ensures that each of
PLACES contains a function." :ORIGIN "alexandria")
  (:NAME "ENSURE-GETHASH" :KIND :MACRO :LAMBDA-LIST "(key hash-table &optional default)" :DOCSTRING "Like GETHASH, but if KEY is not found in the HASH-TABLE saves the DEFAULT
under key before returning it. Secondary return value is true if key was
already in the table." :ORIGIN "alexandria")
  (:NAME "ENSURE-LIST" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "If LIST is a list, it is returned. Otherwise returns the list designated by LIST." :ORIGIN "alexandria")
  (:NAME "ENSURE-SYMBOL" :KIND :FUNCTION :LAMBDA-LIST "(name &optional (package *package*))" :DOCSTRING "Returns a symbol with name designated by NAME, accessible in package
designated by PACKAGE. If symbol is not already accessible in PACKAGE, it is
interned there. Returns a secondary value reflecting the status of the symbol
in the package, which matches the secondary return value of INTERN.

Example:

  (ensure-symbol :cons :cl) => cl:cons, :external
" :ORIGIN "alexandria")
  (:NAME "ESWITCH" :KIND :MACRO :LAMBDA-LIST "((object &key (test 'eql) (key 'identity)) &body clauses)" :DOCSTRING "Like SWITCH, but signals an error if no key matches." :ORIGIN "alexandria")
  (:NAME "EXTREMUM" :KIND :FUNCTION :LAMBDA-LIST "(sequence predicate &key key (start 0) end)" :DOCSTRING "Returns the element of SEQUENCE that would appear first if the subsequence
bounded by START and END was sorted using PREDICATE and KEY.

EXTREMUM determines the relationship between two elements of SEQUENCE by using
the PREDICATE function. PREDICATE should return true if and only if the first
argument is strictly less than the second one (in some appropriate sense). Two
arguments X and Y are considered to be equal if (FUNCALL PREDICATE X Y)
and (FUNCALL PREDICATE Y X) are both false.

The arguments to the PREDICATE function are computed from elements of SEQUENCE
using the KEY function, if supplied. If KEY is not supplied or is NIL, the
sequence element itself is used.

If SEQUENCE is empty, NIL is returned." :ORIGIN "alexandria")
  (:NAME "FACTORIAL" :KIND :FUNCTION :LAMBDA-LIST "(n)" :DOCSTRING "Factorial of non-negative integer N." :ORIGIN "alexandria")
  (:NAME "FEATUREP" :KIND :FUNCTION :LAMBDA-LIST "(feature-expression)" :DOCSTRING "Returns T if the argument matches the state of the *FEATURES*
list and NIL if it does not. FEATURE-EXPRESSION can be any atom
or list acceptable to the reader macros #+ and #-." :ORIGIN "alexandria")
  (:NAME "FIRST-ELT" :KIND :FUNCTION :LAMBDA-LIST "(sequence)" :DOCSTRING "Returns the first element of SEQUENCE. Signals a type-error if SEQUENCE is
not a sequence, or is an empty sequence." :ORIGIN "alexandria")
  (:NAME "FLATTEN" :KIND :FUNCTION :LAMBDA-LIST "(tree)" :DOCSTRING "Traverses the tree in order, collecting non-null leaves into a list." :ORIGIN "alexandria")
  (:NAME "FORMAT-SYMBOL" :KIND :FUNCTION :LAMBDA-LIST "(package control &rest arguments)" :DOCSTRING "Constructs a string by applying ARGUMENTS to string designator CONTROL as
if by FORMAT within WITH-STANDARD-IO-SYNTAX, and then creates a symbol named
by that string.

If PACKAGE is NIL, returns an uninterned symbol, if package is T, returns a
symbol interned in the current package, and otherwise returns a symbol
interned in the package designated by PACKAGE." :ORIGIN "alexandria")
  (:NAME "GAUSSIAN-RANDOM" :KIND :FUNCTION :LAMBDA-LIST "(&optional min max)" :DOCSTRING "Returns two gaussian random double floats as the primary and secondary value,
optionally constrained by MIN and MAX. Gaussian random numbers form a standard
normal distribution around 0.0d0.

Sufficiently positive MIN or negative MAX will cause the algorithm used to
take a very long time. If MIN is positive it should be close to zero, and
similarly if MAX is negative it should be close to zero." :ORIGIN "alexandria")
  (:NAME "HASH-TABLE-ALIST" :KIND :FUNCTION :LAMBDA-LIST "(table)" :DOCSTRING "Returns an association list containing the keys and values of hash table
TABLE." :ORIGIN "alexandria")
  (:NAME "HASH-TABLE-KEYS" :KIND :FUNCTION :LAMBDA-LIST "(table)" :DOCSTRING "Returns a list containing the keys of hash table TABLE." :ORIGIN "alexandria")
  (:NAME "HASH-TABLE-PLIST" :KIND :FUNCTION :LAMBDA-LIST "(table)" :DOCSTRING "Returns a property list containing the keys and values of hash table
TABLE." :ORIGIN "alexandria")
  (:NAME "HASH-TABLE-VALUES" :KIND :FUNCTION :LAMBDA-LIST "(table)" :DOCSTRING "Returns a list containing the values of hash table TABLE." :ORIGIN "alexandria")
  (:NAME "IF-LET" :KIND :MACRO :LAMBDA-LIST "(bindings &body (then-form &optional else-form))" :DOCSTRING "Creates new variable bindings, and conditionally executes either
THEN-FORM or ELSE-FORM. ELSE-FORM defaults to NIL.

BINDINGS must be either single binding of the form:

 (variable initial-form)

or a list of bindings of the form:

 ((variable-1 initial-form-1)
  (variable-2 initial-form-2)
  ...
  (variable-n initial-form-n))

All initial-forms are executed sequentially in the specified order. Then all
the variables are bound to the corresponding values.

If all variables were bound to true values, the THEN-FORM is executed with the
bindings in effect, otherwise the ELSE-FORM is executed with the bindings in
effect." :ORIGIN "alexandria")
  (:NAME "IGNORE-SOME-CONDITIONS" :KIND :MACRO :LAMBDA-LIST "((&rest conditions) &body body)" :DOCSTRING "Similar to CL:IGNORE-ERRORS but the (unevaluated) CONDITIONS
list determines which specific conditions are to be ignored." :ORIGIN "alexandria")
  (:NAME "IOTA" :KIND :FUNCTION :LAMBDA-LIST "(n &key (start 0) (step 1))" :DOCSTRING "Return a list of n numbers, starting from START (with numeric contagion
from STEP applied), each consequtive number being the sum of the previous one
and STEP. START defaults to 0 and STEP to 1.

Examples:

  (iota 4)                      => (0 1 2 3)
  (iota 3 :start 1 :step 1.0)   => (1.0 2.0 3.0)
  (iota 3 :start -1 :step -1/2) => (-1 -3/2 -2)
" :ORIGIN "alexandria")
  (:NAME "LAST-ELT" :KIND :FUNCTION :LAMBDA-LIST "(sequence)" :DOCSTRING "Returns the last element of SEQUENCE. Signals a type-error if SEQUENCE is
not a proper sequence, or is an empty sequence." :ORIGIN "alexandria")
  (:NAME "LASTCAR" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Returns the last element of LIST. Signals a type-error if LIST is not a
proper list." :ORIGIN "alexandria")
  (:NAME "LENGTH=" :KIND :FUNCTION :LAMBDA-LIST "(&rest sequences)" :DOCSTRING "Takes any number of sequences or integers in any order. Returns true iff
the length of all the sequences and the integers are equal. Hint: there's a
compiler macro that expands into more efficient code if the first argument
is a literal integer." :ORIGIN "alexandria")
  (:NAME "LERP" :KIND :FUNCTION :LAMBDA-LIST "(v a b)" :DOCSTRING "Returns the result of linear interpolation between A and B, using the
interpolation coefficient V." :ORIGIN "alexandria")
  (:NAME "MAKE-CIRCULAR-LIST" :KIND :FUNCTION :LAMBDA-LIST "(length &key initial-element)" :DOCSTRING "Creates a circular list of LENGTH with the given INITIAL-ELEMENT." :ORIGIN "alexandria")
  (:NAME "MAKE-GENSYM" :KIND :FUNCTION :LAMBDA-LIST "(name)" :DOCSTRING "If NAME is a non-negative integer, calls GENSYM using it. Otherwise NAME
must be a string designator, in which case calls GENSYM using the designated
string as the argument." :ORIGIN "alexandria")
  (:NAME "MAKE-GENSYM-LIST" :KIND :FUNCTION :LAMBDA-LIST "(length &optional (x \"G\"))" :DOCSTRING "Returns a list of LENGTH gensyms, each generated as if with a call to MAKE-GENSYM,
using the second (optional, defaulting to \"G\") argument." :ORIGIN "alexandria")
  (:NAME "MAKE-KEYWORD" :KIND :FUNCTION :LAMBDA-LIST "(name)" :DOCSTRING "Interns the string designated by NAME in the KEYWORD package." :ORIGIN "alexandria")
  (:NAME "MAP-COMBINATIONS" :KIND :FUNCTION :LAMBDA-LIST "(function sequence &key (start 0) end length (copy t))" :DOCSTRING "Calls FUNCTION with each combination of LENGTH constructable from the
elements of the subsequence of SEQUENCE delimited by START and END. START
defaults to 0, END to length of SEQUENCE, and LENGTH to the length of the
delimited subsequence. (So unless LENGTH is specified there is only a single
combination, which has the same elements as the delimited subsequence.) If
COPY is true (the default) each combination is freshly allocated. If COPY is
false all combinations are EQ to each other, in which case consequences are
unspecified if a combination is modified by FUNCTION." :ORIGIN "alexandria")
  (:NAME "MAP-DERANGEMENTS" :KIND :FUNCTION :LAMBDA-LIST "(function sequence &key (start 0) end (copy t))" :DOCSTRING "Calls FUNCTION with each derangement of the subsequence of SEQUENCE denoted
by the bounding index designators START and END. Derangement is a permutation
of the sequence where no element remains in place. SEQUENCE is not modified,
but individual derangements are EQ to each other. Consequences are unspecified
if calling FUNCTION modifies either the derangement or SEQUENCE." :ORIGIN "alexandria")
  (:NAME "MAP-IOTA" :KIND :FUNCTION :LAMBDA-LIST "(function n &key (start 0) (step 1))" :DOCSTRING "Calls FUNCTION with N numbers, starting from START (with numeric contagion
from STEP applied), each consequtive number being the sum of the previous one
and STEP. START defaults to 0 and STEP to 1. Returns N.

Examples:

  (map-iota #'print 3 :start 1 :step 1.0) => 3
    ;;; 1.0
    ;;; 2.0
    ;;; 3.0
" :ORIGIN "alexandria")
  (:NAME "MAP-PERMUTATIONS" :KIND :FUNCTION :LAMBDA-LIST "(function sequence &key (start 0) end length (copy t))" :DOCSTRING "Calls function with each permutation of LENGTH constructable
from the subsequence of SEQUENCE delimited by START and END. START
defaults to 0, END to length of the sequence, and LENGTH to the
length of the delimited subsequence." :ORIGIN "alexandria")
  (:NAME "MAP-PRODUCT" :KIND :FUNCTION :LAMBDA-LIST "(function list &rest more-lists)" :DOCSTRING "Returns a list containing the results of calling FUNCTION with one argument
from LIST, and one from each of MORE-LISTS for each combination of arguments.
In other words, returns the product of LIST and MORE-LISTS using FUNCTION.

Example:

 (map-product 'list '(1 2) '(3 4) '(5 6))
  => ((1 3 5) (1 3 6) (1 4 5) (1 4 6)
      (2 3 5) (2 3 6) (2 4 5) (2 4 6))
" :ORIGIN "alexandria")
  (:NAME "MAPHASH-KEYS" :KIND :FUNCTION :LAMBDA-LIST "(function table)" :DOCSTRING "Like MAPHASH, but calls FUNCTION with each key in the hash table TABLE." :ORIGIN "alexandria")
  (:NAME "MAPHASH-VALUES" :KIND :FUNCTION :LAMBDA-LIST "(function table)" :DOCSTRING "Like MAPHASH, but calls FUNCTION with each value in the hash table TABLE." :ORIGIN "alexandria")
  (:NAME "MAPPEND" :KIND :FUNCTION :LAMBDA-LIST "(function &rest lists)" :DOCSTRING "Applies FUNCTION to respective element(s) of each LIST, appending all the
