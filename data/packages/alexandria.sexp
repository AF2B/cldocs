  (:NAME "PROPER-LIST" :KIND :TYPE :DOCSTRING "Type designator for proper lists. Implemented as a SATISFIES type, hence
not recommended for performance intensive use. Main usefullness as a type
designator of the expected type in a TYPE-ERROR." :ORIGIN "alexandria")
  (:NAME "PROPER-LIST-LENGTH" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Returns length of LIST, signalling an error if it is not a proper list." :ORIGIN "alexandria")
  (:NAME "PROPER-LIST-P" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Returns true if OBJECT is a proper list." :ORIGIN "alexandria")
  (:NAME "PROPER-SEQUENCE" :KIND :TYPE :DOCSTRING "Type designator for proper sequences, that is proper lists and sequences
