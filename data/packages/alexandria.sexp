  (:NAME "READ-FILE-INTO-BYTE-VECTOR" :KIND :FUNCTION :LAMBDA-LIST "(pathname)" :DOCSTRING "Read PATHNAME into a freshly allocated (unsigned-byte 8) vector." :ORIGIN "alexandria")
  (:NAME "READ-FILE-INTO-STRING" :KIND :FUNCTION :LAMBDA-LIST "(pathname &key (buffer-size 4096) external-format)" :DOCSTRING "Return the contents of the file denoted by PATHNAME as a fresh string.

The EXTERNAL-FORMAT parameter will be passed directly to WITH-OPEN-FILE
unless it's NIL, which means the system default." :ORIGIN "alexandria")
  (:NAME "READ-STREAM-CONTENT-INTO-BYTE-VECTOR" :KIND :FUNCTION :LAMBDA-LIST "(stream &key ((%length length)) (initial-size 4096))" :DOCSTRING "Return \"content\" of STREAM as freshly allocated (unsigned-byte 8) vector." :ORIGIN "alexandria")
  (:NAME "READ-STREAM-CONTENT-INTO-STRING" :KIND :FUNCTION :LAMBDA-LIST "(stream &key (buffer-size 4096))" :DOCSTRING "Return the \"content\" of STREAM as a fresh string." :ORIGIN "alexandria")
  (:NAME "REMOVE-FROM-PLIST" :KIND :FUNCTION :LAMBDA-LIST "(plist &rest keys)" :DOCSTRING "Returns a property-list with same keys and values as PLIST, except that keys
in the list designated by KEYS and values corresponding to them are removed.
The returned property-list may share structure with the PLIST, but PLIST is
not destructively modified. Keys are compared using EQ." :ORIGIN "alexandria")
  (:NAME "REMOVE-FROM-PLISTF" :KIND :MACRO :LAMBDA-LIST "(place &rest keys)" :DOCSTRING "Modify macro for REMOVE-FROM-PLIST." :ORIGIN "alexandria")
  (:NAME "REMOVEF" :KIND :MACRO :LAMBDA-LIST "(place item &rest keyword-arguments)" :DOCSTRING "Modify-macro for REMOVE. Sets place designated by the first argument to
the result of calling REMOVE with ITEM, place, and the KEYWORD-ARGUMENTS." :ORIGIN "alexandria")
  (:NAME "REQUIRED-ARGUMENT" :KIND :FUNCTION :LAMBDA-LIST "(&optional name)" :DOCSTRING "Signals an error for a missing argument of NAME. Intended for
use as an initialization form for structure and class-slots, and
a default value for required keyword arguments." :ORIGIN "alexandria")
  (:NAME "REVERSEF" :KIND :MACRO :LAMBDA-LIST "(place)" :DOCSTRING "Modify-macro for REVERSE. Copies and reverses the list stored in the given
place and saves back the result into the place." :ORIGIN "alexandria")
  (:NAME "ROTATE" :KIND :FUNCTION :LAMBDA-LIST "(sequence &optional (n 1))" :DOCSTRING "Returns a sequence of the same type as SEQUENCE, with the elements of
SEQUENCE rotated by N: N elements are moved from the end of the sequence to
the front if N is positive, and -N elements moved from the front to the end if
N is negative. SEQUENCE must be a proper sequence. N must be an integer,
defaulting to 1.

If absolute value of N is greater then the length of the sequence, the results
are identical to calling ROTATE with

  (* (signum n) (mod n (length sequence))).

Note: the original sequence may be destructively altered, and result sequence may
share structure with it." :ORIGIN "alexandria")
  (:NAME "SEQUENCE-OF-LENGTH-P" :KIND :FUNCTION :LAMBDA-LIST "(sequence length)" :DOCSTRING "Return true if SEQUENCE is a sequence of length LENGTH. Signals an error if
SEQUENCE is not a sequence. Returns FALSE for circular lists." :ORIGIN "alexandria")
  (:NAME "SET-EQUAL" :KIND :FUNCTION :LAMBDA-LIST "(list1 list2 &key (test (function eql)) (key nil keyp))" :DOCSTRING "Returns true if every element of LIST1 matches some element of LIST2 and
every element of LIST2 matches some element of LIST1. Otherwise returns false." :ORIGIN "alexandria")
  (:NAME "SETP" :KIND :FUNCTION :LAMBDA-LIST "(object &key (test (function eql)) (key (function identity)))" :DOCSTRING "Returns true if OBJECT is a list that denotes a set, NIL otherwise. A list
denotes a set if each element of the list is unique under KEY and TEST." :ORIGIN "alexandria")
  (:NAME "SHUFFLE" :KIND :FUNCTION :LAMBDA-LIST "(sequence &key (start 0) end)" :DOCSTRING "Returns a random permutation of SEQUENCE bounded by START and END.
Original sequence may be destructively modified.
Signals an error if SEQUENCE is not a proper sequence." :ORIGIN "alexandria")
