  (:NAME "*ALLOW-QUOTING*" :KIND :VARIABLE :DOCSTRING "Whether the parser should support Perl's \\Q and \\E." :ORIGIN "cl-ppcre")
  (:NAME "*LOOK-AHEAD-FOR-SUFFIX*" :KIND :VARIABLE :DOCSTRING "Controls whether scanners will optimistically look ahead for a
