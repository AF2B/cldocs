  (:NAME "CHAR" :KIND :FUNCTION :LAMBDA-LIST "(string index)" :DOCSTRING "Given a string and a non-negative integer index less than the length of
the string, returns the character object representing the character at
that position in the string." :ORIGIN :SBCL :CLHS-PAGE "Body/f_char_.htm")
  (:NAME "CHAR-CODE" :KIND :FUNCTION :LAMBDA-LIST "(char)" :DOCSTRING "Return the integer code of CHAR." :ORIGIN :SBCL :CLHS-PAGE "Body/f_char_c.htm")
  (:NAME "CHAR-CODE-LIMIT" :KIND :CONSTANT :DOCSTRING "the upper exclusive bound on values produced by CHAR-CODE" :ORIGIN :SBCL :CLHS-PAGE "Body/v_char_c.htm")
  (:NAME "CHAR-DOWNCASE" :KIND :FUNCTION :LAMBDA-LIST "(char)" :DOCSTRING "Return CHAR converted to lower-case if that is possible." :ORIGIN :SBCL :CLHS-PAGE "Body/f_char_u.htm")
  (:NAME "CHAR-EQUAL" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if all of the arguments are the same character.
Case is ignored." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR-GREATERP" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if the arguments are in strictly decreasing alphabetic order.
Case is ignored." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR-INT" :KIND :FUNCTION :LAMBDA-LIST "(char)" :DOCSTRING "Return the integer code of CHAR. (In SBCL this is the same as CHAR-CODE, as
there are no character bits or fonts.)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_char_i.htm")
  (:NAME "CHAR-LESSP" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if the arguments are in strictly increasing alphabetic order.
Case is ignored." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR-NAME" :KIND :FUNCTION :LAMBDA-LIST "(character)" :DOCSTRING "Return the name (a STRING) for a CHARACTER object." :ORIGIN :SBCL :CLHS-PAGE "Body/f_char_n.htm")
  (:NAME "CHAR-NOT-EQUAL" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if no two of the arguments are the same character.
Case is ignored." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR-NOT-GREATERP" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if the arguments are in strictly non-decreasing alphabetic order.
Case is ignored." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR-NOT-LESSP" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if the arguments are in strictly non-increasing alphabetic order.
Case is ignored." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR-UPCASE" :KIND :FUNCTION :LAMBDA-LIST "(char)" :DOCSTRING "Return CHAR converted to upper-case if that is possible. Don't convert
lowercase eszet (U+DF)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_char_u.htm")
  (:NAME "CHAR/=" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if no two of the arguments are the same character." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR<" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if the arguments are in strictly increasing alphabetic order." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR<=" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if the arguments are in strictly non-decreasing alphabetic order." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR=" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if all of the arguments are the same character." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR>" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if the arguments are in strictly decreasing alphabetic order." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHAR>=" :KIND :FUNCTION :LAMBDA-LIST "(character &rest more-characters)" :DOCSTRING "Return T if the arguments are in strictly non-increasing alphabetic order." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chareq.htm")
  (:NAME "CHARACTER" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Coerce OBJECT into a CHARACTER if possible. Legal inputs are characters,
strings and symbols of length 1." :ORIGIN :SBCL :CLHS-PAGE "Body/a_ch.htm")
  (:NAME "CHARACTER" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_ch.htm")
  (:NAME "CHARACTERP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a CHARACTER, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_chp.htm")
  (:NAME "CHECK-TYPE" :KIND :MACRO :LAMBDA-LIST "(place type &optional type-string)" :DOCSTRING "Signal a restartable error of type TYPE-ERROR if the value of PLACE
is not of the specified type. If an error is signalled and the restart
is used to return, this can only return if the STORE-VALUE restart is
invoked. In that case it will store into PLACE and start over." :ORIGIN :SBCL :CLHS-PAGE "Body/m_check_.htm")
  (:NAME "CIS" :KIND :FUNCTION :LAMBDA-LIST "(theta)" :DOCSTRING "Return cos(Theta) + i sin(Theta), i.e. exp(i Theta)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cis.htm")
  (:NAME "CLASS" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_class.htm")
  (:NAME "CLASS-NAME" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(class)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_class_.htm")
  (:NAME "CLASS-OF" :KIND :FUNCTION :LAMBDA-LIST "(x)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_clas_1.htm")
  (:NAME "CLEAR-INPUT" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-input*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_clear_.htm")
  (:NAME "CLEAR-OUTPUT" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-output*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_finish.htm")
  (:NAME "CLOSE" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(stream &key abort)" :DOCSTRING "Close the given STREAM. No more I/O may be performed, but
inquiries may still be made. If :ABORT is true, an attempt is made
to clean up the side effects of having created the stream." :ORIGIN :SBCL :CLHS-PAGE "Body/f_close.htm")
  (:NAME "CLRHASH" :KIND :FUNCTION :LAMBDA-LIST "(hash-table)" :DOCSTRING "This removes all the entries from HASH-TABLE and returns the hash
table itself." :ORIGIN :SBCL :CLHS-PAGE "Body/f_clrhas.htm")
  (:NAME "CODE-CHAR" :KIND :FUNCTION :LAMBDA-LIST "(code)" :DOCSTRING "Return the character with the code CODE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_code_c.htm")
  (:NAME "COERCE" :KIND :FUNCTION :LAMBDA-LIST "(object output-type-spec)" :DOCSTRING "Coerce the Object to an object of type Output-Type-Spec." :ORIGIN :SBCL :CLHS-PAGE "Body/f_coerce.htm")
  (:NAME "COMPILATION-SPEED" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_optimi.htm")
  (:NAME "COMPILE" :KIND :FUNCTION :LAMBDA-LIST "(name &optional (definition (or (and (symbolp name) (macro-function name)) (fdefinition name)) defp))" :DOCSTRING "Produce a compiled function from DEFINITION. If DEFINITION is a
lambda-expression, it is coerced to a function. If DEFINITION is an
interpreted function, it is compiled. If DEFINITION is already a compiled
function, it is used as-is. (Future versions of SBCL might try to
recompile the existing definition, but this is not currently supported.)

If NAME is NIL, the compiled function is returned as the primary value.
Otherwise the resulting compiled function replaces existing function
definition of NAME, and NAME is returned as primary value; if NAME is a symbol
that names a macro, its macro function is replaced and NAME is returned as
primary value.

Also returns a secondary value which is true if any conditions of type
WARNING occur during the compilation, and NIL otherwise.

Tertiary value is true if any conditions of type ERROR, or WARNING that are
not STYLE-WARNINGs occur during compilation, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cmp.htm")
  (:NAME "COMPILE-FILE" :KIND :FUNCTION :LAMBDA-LIST "(input-file &key (output-file \"\" output-file-p) ((:verbose *compile-verbose*) *compile-verbose*) ((:print *compile-print*) *compile-print*) (external-format :default) ((:progress *compile-progress*) *compile-progress*) (trace-file nil) ((:block-compile *block-compile-argument*) *block-compile-default*) ((:entry-points *entry-points-argument*) nil) (emit-cfasl *emit-cfasl*))" :DOCSTRING "Compile INPUT-FILE, producing a corresponding fasl file and
returning its filename.

  :OUTPUT-FILE
     The name of the FASL to output.  The returned pathname of the
     output file may differ from the pathname of the :OUTPUT-FILE
     parameter, e.g. when the latter is a designator for a directory.

  :VERBOSE
     If true, information indicating what file is being compiled is printed
     to *STANDARD-OUTPUT*.

  :PRINT
     If true, each top level form in the file is printed to *STANDARD-OUTPUT*.

  :EXTERNAL-FORMAT
     The external format to use when opening the source file.
      The default is :DEFAULT which uses the SB-EXT:*DEFAULT-SOURCE-EXTERNAL-FORMAT*.

  :BLOCK-COMPILE {NIL | :SPECIFIED | T}
     Determines whether multiple functions are compiled together as a unit,
     resolving function references at compile time.  NIL means that global
     function names are never resolved at compilation time.  :SPECIFIED means
     that names are resolved at compile-time when convenient (as in a
     self-recursive call), but the compiler doesn't combine top-level DEFUNs.
     With :SPECIFIED, an explicit START-BLOCK declaration will enable block
     compilation.  A value of T indicates that all forms in the file(s) should
     be compiled as a unit.  The default is the value of
     SB-EXT:*BLOCK-COMPILE-DEFAULT*, which is initially NIL.

  :ENTRY-POINTS
     This specifies a list of function names for functions in the file(s) that
     must be given global definitions.  This only applies to block
     compilation, and is useful mainly when :BLOCK-COMPILE T is specified on a
     file that lacks START-BLOCK declarations.  If the value is NIL (the
     default) then all functions will be globally defined.

  :TRACE-FILE
     If given, internal data structures are dumped to the specified
     file, or if a value of T is given, to a file of *.trace type
     derived from the input file name. (non-standard)

  :EMIT-CFASL
     (Experimental). If true, outputs the toplevel compile-time effects
     of this file into a separate .cfasl file." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cmp_fi.htm")
  (:NAME "COMPILE-FILE-PATHNAME" :KIND :FUNCTION :LAMBDA-LIST "(input-file &key (output-file nil output-file-p) &allow-other-keys)" :DOCSTRING "Return a pathname describing what file COMPILE-FILE would write to given
these arguments." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cmp__1.htm")
  (:NAME "COMPILED-FUNCTION" :KIND :TYPE :ORIGIN :SBCL :CLHS-PAGE "Body/t_cmpd_f.htm")
  (:NAME "COMPILED-FUNCTION-P" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a COMPILED-FUNCTION, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cmpd_f.htm")
  (:NAME "COMPILER-MACRO" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/f_docume.htm")
  (:NAME "COMPILER-MACRO-FUNCTION" :KIND :FUNCTION :LAMBDA-LIST "(name &optional env)" :DOCSTRING "If NAME names a compiler-macro in ENV, return the expansion function, else
return NIL. Can be set with SETF when ENV is NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cmp_ma.htm")
  (:NAME "COMPLEMENT" :KIND :FUNCTION :LAMBDA-LIST "(function)" :DOCSTRING "Return a new function that returns T whenever FUNCTION returns NIL and
NIL whenever FUNCTION returns non-NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_comple.htm")
  (:NAME "COMPLEX" :KIND :FUNCTION :LAMBDA-LIST "(realpart &optional (imagpart 0))" :DOCSTRING "Return a complex number with the specified real and imaginary components." :ORIGIN :SBCL :CLHS-PAGE "Body/a_comple.htm")
  (:NAME "COMPLEX" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_comple.htm")
  (:NAME "COMPLEXP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a COMPLEX, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_comp_3.htm")
  (:NAME "COMPUTE-APPLICABLE-METHODS" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(generic-function arguments)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_comput.htm")
  (:NAME "COMPUTE-RESTARTS" :KIND :FUNCTION :LAMBDA-LIST "(&optional condition)" :DOCSTRING "Return a list of all the currently active restarts ordered from most recently
established to less recently established. If CONDITION is specified, then only
restarts associated with CONDITION (or with no condition) will be returned." :ORIGIN :SBCL :CLHS-PAGE "Body/f_comp_1.htm")
  (:NAME "CONCATENATE" :KIND :FUNCTION :LAMBDA-LIST "(result-type &rest sequences)" :DOCSTRING "Return a new sequence of all the argument sequences concatenated together
which shares no structure with the original argument sequences of the
specified RESULT-TYPE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_concat.htm")
  (:NAME "CONCATENATED-STREAM" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_concat.htm")
  (:NAME "CONCATENATED-STREAM-STREAMS" :KIND :FUNCTION :LAMBDA-LIST "(stream)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_conc_1.htm")
  (:NAME "COND" :KIND :MACRO :LAMBDA-LIST "(&rest clauses)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_cond.htm")
  (:NAME "CONDITION" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_cnd.htm")
  (:NAME "CONJUGATE" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Return the complex conjugate of NUMBER. For non-complex numbers, this is
an identity." :ORIGIN :SBCL :CLHS-PAGE "Body/f_conjug.htm")
  (:NAME "CONS" :KIND :FUNCTION :LAMBDA-LIST "(se1 se2)" :DOCSTRING "Return a list with SE1 as the CAR and SE2 as the CDR." :ORIGIN :SBCL :CLHS-PAGE "Body/a_cons.htm")
  (:NAME "CONS" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_cons.htm")
  (:NAME "CONSP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a CONS, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_consp.htm")
  (:NAME "CONSTANTLY" :KIND :FUNCTION :LAMBDA-LIST "(value)" :DOCSTRING "Return a function that always returns VALUE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cons_1.htm")
  (:NAME "CONSTANTP" :KIND :FUNCTION :LAMBDA-LIST "(form &optional (environment nil envp))" :DOCSTRING "True of any FORM that has a constant value: self-evaluating objects,
keywords, defined constants, quote forms. Additionally the
constant-foldability of some function calls and special forms is recognized.
If ENVIRONMENT is provided, the FORM is first macroexpanded in it." :ORIGIN :SBCL :CLHS-PAGE "Body/f_consta.htm")
  (:NAME "CONTINUE" :KIND :FUNCTION :LAMBDA-LIST "(&optional condition)" :DOCSTRING "Transfer control to a restart named CONTINUE, or return NIL if none exists." :ORIGIN :SBCL :CLHS-PAGE "Body/a_contin.htm")
  (:NAME "CONTROL-ERROR" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_contro.htm")
  (:NAME "COPY-ALIST" :KIND :FUNCTION :LAMBDA-LIST "(alist)" :DOCSTRING "Return a new association list which is EQUAL to ALIST." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cp_ali.htm")
  (:NAME "COPY-LIST" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return a new list which is EQUAL to LIST. LIST may be improper." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cp_lis.htm")
  (:NAME "COPY-PPRINT-DISPATCH" :KIND :FUNCTION :LAMBDA-LIST "(&optional (table *print-pprint-dispatch*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_cp_ppr.htm")
  (:NAME "COPY-READTABLE" :KIND :FUNCTION :LAMBDA-LIST "(&optional (from-readtable *readtable*) to-readtable)" :DOCSTRING "Copies FROM-READTABLE and returns the result. Uses TO-READTABLE as a target
for the copy when provided, otherwise a new readtable is created. The
FROM-READTABLE defaults to the standard readtable when NIL and to the current
readtable when not provided." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cp_rdt.htm")
  (:NAME "COPY-SEQ" :KIND :FUNCTION :LAMBDA-LIST "(sequence)" :DOCSTRING "Return a copy of SEQUENCE which is EQUAL to SEQUENCE but not EQ." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cp_seq.htm")
  (:NAME "COPY-STRUCTURE" :KIND :FUNCTION :LAMBDA-LIST "(structure)" :DOCSTRING "Return a copy of STRUCTURE with the same (EQL) slot values." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cp_stu.htm")
  (:NAME "COPY-SYMBOL" :KIND :FUNCTION :LAMBDA-LIST "(symbol &optional (copy-props nil))" :DOCSTRING "Make and return a new uninterned symbol with the same print name
as SYMBOL. If COPY-PROPS is false, the new symbol is neither bound
nor fbound and has no properties, else it has a copy of SYMBOL's
function, value and property list." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cp_sym.htm")
  (:NAME "COPY-TREE" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Recursively copy trees of conses." :ORIGIN :SBCL :CLHS-PAGE "Body/f_cp_tre.htm")
  (:NAME "COS" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Return the cosine of NUMBER." :ORIGIN :SBCL :CLHS-PAGE "Body/f_sin_c.htm")
  (:NAME "COSH" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Return the hyperbolic cosine of NUMBER." :ORIGIN :SBCL :CLHS-PAGE "Body/f_sinh_.htm")
  (:NAME "COUNT" :KIND :FUNCTION :LAMBDA-LIST "(item sequence &rest args &key from-end (start 0) (end nil) (key nil) (test (function eql) test-p) (test-not nil test-not-p))" :DOCSTRING "Return the number of elements in SEQUENCE satisfying a test with ITEM,
which defaults to EQL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_countc.htm")
  (:NAME "COUNT-IF" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) (end nil) (key nil))" :DOCSTRING "Return the number of elements in SEQUENCE satisfying PRED(el)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_countc.htm")
  (:NAME "COUNT-IF-NOT" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) (end nil) (key nil))" :DOCSTRING "Return the number of elements in SEQUENCE not satisfying TEST(el)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_countc.htm")
  (:NAME "CTYPECASE" :KIND :MACRO :LAMBDA-LIST "(keyform &body cases)" :DOCSTRING "CTYPECASE Keyform {(Type Form*)}*
Evaluates the Forms in the first clause for which TYPEP of Keyform and Type
is true. If no form is satisfied then a correctable error is signalled." :ORIGIN :SBCL :CLHS-PAGE "Body/m_tpcase.htm")
  (:NAME "DEBUG" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_optimi.htm")
  (:NAME "DECF" :KIND :MACRO :LAMBDA-LIST "(place &optional (delta 1))" :DOCSTRING "The first argument is some location holding a number. This number is
decremented by the second argument, DELTA, which defaults to 1." :ORIGIN :SBCL :CLHS-PAGE "Body/m_incf_.htm")
  (:NAME "DECLAIM" :KIND :MACRO :LAMBDA-LIST "(&rest specs)" :DOCSTRING "DECLAIM Declaration*
Do a declaration or declarations for the global environment." :ORIGIN :SBCL :CLHS-PAGE "Body/m_declai.htm")
  (:NAME "DECLARATION" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_declar.htm")
  (:NAME "DECLARE" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/s_declar.htm")
  (:NAME "DECODE-FLOAT" :KIND :FUNCTION :LAMBDA-LIST "(f)" :DOCSTRING "Return three values:
1) a floating-point number representing the significand. This is always
   between 0.5 (inclusive) and 1.0 (exclusive).
2) an integer representing the exponent.
3) -1.0 or 1.0 (i.e. the sign of the argument.)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_dec_fl.htm")
  (:NAME "DECODE-UNIVERSAL-TIME" :KIND :FUNCTION :LAMBDA-LIST "(universal-time &optional time-zone)" :DOCSTRING "Converts a universal-time to decoded time format returning the following
nine values: second, minute, hour, date, month, year, day of week (0 =
Monday), T (daylight savings time) or NIL (standard time), and timezone.
Completely ignores daylight-savings-time when time-zone is supplied." :ORIGIN :SBCL :CLHS-PAGE "Body/f_dec_un.htm")
  (:NAME "DEFCLASS" :KIND :MACRO :LAMBDA-LIST "(name direct-superclasses direct-slots &rest options)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_defcla.htm")
  (:NAME "DEFCONSTANT" :KIND :MACRO :LAMBDA-LIST "(name value &optional (doc nil))" :DOCSTRING "Define a global constant, saying that the value is constant and may be
compiled into code. If the variable already has a value, and this is not
EQL to the new value, the code is not portable (undefined behavior). The
third argument is an optional documentation string for the variable." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defcon.htm")
  (:NAME "DEFGENERIC" :KIND :MACRO :LAMBDA-LIST "(fun-name lambda-list &body options)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_defgen.htm")
  (:NAME "DEFINE-COMPILER-MACRO" :KIND :MACRO :LAMBDA-LIST "(name lambda-list &body body)" :DOCSTRING "Define a compiler-macro for NAME." :ORIGIN :SBCL :CLHS-PAGE "Body/m_define.htm")
  (:NAME "DEFINE-CONDITION" :KIND :MACRO :LAMBDA-LIST "(name (&rest parent-types) (&rest slot-specs) &body options)" :DOCSTRING "DEFINE-CONDITION Name (Parent-Type*) (Slot-Spec*) Option*
Define NAME as a condition type. This new type inherits slots and its
report function from the specified PARENT-TYPEs. A slot spec is a list of:
  (slot-name :reader <rname> :initarg <iname> {Option Value}*

The DEFCLASS slot options :ALLOCATION, :INITFORM, [slot]
:DOCUMENTATION and :TYPE and the overall options :DEFAULT-INITARGS
and [type] :DOCUMENTATION are also allowed.

The :REPORT option is peculiar to DEFINE-CONDITION. Its argument is either
a string or a two-argument lambda or function name. If a function, the
function is called with the condition and stream to report the condition.
If a string, the string is printed.

Condition types are classes, but (as allowed by ANSI and not as described in
CLtL2) are neither STANDARD-OBJECTs nor STRUCTURE-OBJECTs. WITH-SLOTS and
SLOT-VALUE may not be used on condition objects." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defi_5.htm")
  (:NAME "DEFINE-METHOD-COMBINATION" :KIND :MACRO :LAMBDA-LIST "(name . args)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_defi_4.htm")
  (:NAME "DEFINE-MODIFY-MACRO" :KIND :MACRO :LAMBDA-LIST "(name lambda-list function &optional doc-string)" :DOCSTRING "Creates a new read-modify-write macro like PUSH or INCF." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defi_2.htm")
  (:NAME "DEFINE-SETF-EXPANDER" :KIND :MACRO :LAMBDA-LIST "(access-fn lambda-list &body body)" :DOCSTRING "Syntax like DEFMACRO, but creates a setf expander function. The body
of the definition must be a form that returns five appropriate values." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defi_3.htm")
  (:NAME "DEFINE-SYMBOL-MACRO" :KIND :MACRO :LAMBDA-LIST "(name expansion)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_defi_1.htm")
  (:NAME "DEFMACRO" :KIND :MACRO :LAMBDA-LIST "(name lambda-list &body body)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_defmac.htm")
  (:NAME "DEFMETHOD" :KIND :MACRO :LAMBDA-LIST "(name &rest args)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_defmet.htm")
  (:NAME "DEFPACKAGE" :KIND :MACRO :LAMBDA-LIST "(package &rest options)" :DOCSTRING "Defines a new package called PACKAGE. Each of OPTIONS should be one of the
following:
 
    (:USE {package-name}*)
    (:EXPORT {symbol-name}*)
    (:IMPORT-FROM <package-name> {symbol-name}*)
    (:SHADOW {symbol-name}*)
    (:SHADOWING-IMPORT-FROM <package-name> {symbol-name}*)
    (:LOCAL-NICKNAMES {(local-nickname actual-package-name)}*)
    (:LOCK boolean)
    (:IMPLEMENT {package-name}*)
    (:DOCUMENTATION doc-string)
    (:INTERN {symbol-name}*)
    (:SIZE <integer>)
    (:NICKNAMES {package-name}*)

All options except :SIZE, :LOCK, and :DOCUMENTATION can be used multiple
times.

For the non-standard options LOCK and IMPLEMENT, see
SB-MANUAL:@PACKAGE-LOCKS. For LOCAL-NICKNAMES, see
SB-MANUAL:@PACKAGE-LOCAL-NICKNAMES." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defpkg.htm")
  (:NAME "DEFPARAMETER" :KIND :MACRO :LAMBDA-LIST "(var val &optional (doc nil))" :DOCSTRING "Define a parameter that is not normally changed by the program,
but that may be changed without causing an error. Declare the
variable special and sets its value to VAL, overwriting any
previous value. The third argument is an optional documentation
string for the parameter." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defpar.htm")
  (:NAME "DEFSETF" :KIND :MACRO :LAMBDA-LIST "(access-fn &rest rest)" :DOCSTRING "Associates a SETF update function or macro with the specified access
function or macro. The format is complex. See the manual for details." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defset.htm")
  (:NAME "DEFSTRUCT" :KIND :MACRO :LAMBDA-LIST "(name-and-options &rest slot-descriptions)" :DOCSTRING "DEFSTRUCT {Name | (Name Option*)} [Documentation] {Slot | (Slot [Default] {Key Value}*)}
Define the structure type Name. Instances are created by MAKE-<name>,
which takes &KEY arguments allowing initial slot values to the specified.
A SETF'able function <name>-<slot> is defined for each slot to read and
write slot values. <name>-p is a type predicate.

Popular DEFSTRUCT options (see manual for others):

(:CONSTRUCTOR Name)
(:PREDICATE Name)
    Specify the name for the constructor or predicate.

(:CONSTRUCTOR Name Lambda-List)
    Specify the name and arguments for a BOA constructor
    (which is more efficient when keyword syntax isn't necessary.)

(:INCLUDE Supertype Slot-Spec*)
    Make this type a subtype of the structure type Supertype. The optional
    Slot-Specs override inherited slot options.

Slot options:

:TYPE Type-Spec
    Asserts that the value of this slot is always of the specified type.

:READ-ONLY {T | NIL}
    If true, no setter function is defined for this slot." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defstr.htm")
  (:NAME "DEFTYPE" :KIND :MACRO :LAMBDA-LIST "(name lambda-list &body body)" :DOCSTRING "Define a new type, with syntax like DEFMACRO." :ORIGIN :SBCL :CLHS-PAGE "Body/m_deftp.htm")
  (:NAME "DEFUN" :KIND :MACRO :LAMBDA-LIST "(name lambda-list &body body)" :DOCSTRING "Define a function at top level." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defun.htm")
  (:NAME "DEFVAR" :KIND :MACRO :LAMBDA-LIST "(var &optional (val nil) (doc nil))" :DOCSTRING "Define a special variable at top level. Declare the variable
SPECIAL and, optionally, initialize it. If the variable already has a
value, the old value is not clobbered. The third argument is an optional
documentation string for the variable." :ORIGIN :SBCL :CLHS-PAGE "Body/m_defpar.htm")
  (:NAME "DELETE" :KIND :FUNCTION :LAMBDA-LIST "(item sequence &rest args &key from-end (test (function eql) test-p) (test-not nil test-not-p) (start 0) (end nil) (count nil) (key nil))" :DOCSTRING "Return a sequence formed by destructively removing the specified ITEM from
the given SEQUENCE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rm_rm.htm")
  (:NAME "DELETE-DUPLICATES" :KIND :FUNCTION :LAMBDA-LIST "(sequence &rest args &key (test (function eql) test-p) (test-not nil test-not-p) (start 0) (end nil) from-end (key nil))" :DOCSTRING "The elements of SEQUENCE are examined, and if any two match, one is
discarded. The resulting sequence, which may be formed by destroying the
given sequence, is returned.

The :TEST-NOT argument is deprecated." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rm_dup.htm")
  (:NAME "DELETE-FILE" :KIND :FUNCTION :LAMBDA-LIST "(file)" :DOCSTRING "Delete the specified FILE.

If FILE is a stream, on Windows the stream is closed immediately. On Unix
platforms the stream remains open, allowing IO to continue: the OS resources
associated with the deleted file remain available till the stream is closed as
per standard Unix unlink() behaviour." :ORIGIN :SBCL :CLHS-PAGE "Body/f_del_fi.htm")
  (:NAME "DELETE-IF" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) (key nil) (end nil) (count nil))" :DOCSTRING "Return a sequence formed by destructively removing the elements satisfying
the specified PREDICATE from the given SEQUENCE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rm_rm.htm")
  (:NAME "DELETE-IF-NOT" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) (end nil) (key nil) (count nil))" :DOCSTRING "Return a sequence formed by destructively removing the elements not
satisfying the specified PREDICATE from the given SEQUENCE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rm_rm.htm")
  (:NAME "DELETE-PACKAGE" :KIND :FUNCTION :LAMBDA-LIST "(package-designator)" :DOCSTRING "Delete the package designated by PACKAGE-DESIGNATOR from the package
system data structures." :ORIGIN :SBCL :CLHS-PAGE "Body/f_del_pk.htm")
  (:NAME "DENOMINATOR" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Return the denominator of NUMBER, which must be rational." :ORIGIN :SBCL :CLHS-PAGE "Body/f_numera.htm")
  (:NAME "DEPOSIT-FIELD" :KIND :FUNCTION :LAMBDA-LIST "(newbyte bytespec integer)" :DOCSTRING "Return new integer with newbyte in specified position, newbyte is not right justified." :ORIGIN :SBCL :CLHS-PAGE "Body/f_deposi.htm")
  (:NAME "DESCRIBE" :KIND :FUNCTION :LAMBDA-LIST "(object &optional (stream-designator *standard-output*))" :DOCSTRING "Print a description of OBJECT to STREAM-DESIGNATOR." :ORIGIN :SBCL :CLHS-PAGE "Body/f_descri.htm")
  (:NAME "DESCRIBE-OBJECT" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(object stream)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_desc_1.htm")
  (:NAME "DESTRUCTURING-BIND" :KIND :MACRO :LAMBDA-LIST "(lambda-list expression &body body)" :DOCSTRING "Bind the variables in LAMBDA-LIST to the corresponding values in the
tree structure resulting from the evaluation of EXPRESSION." :ORIGIN :SBCL :CLHS-PAGE "Body/m_destru.htm")
  (:NAME "DIGIT-CHAR" :KIND :FUNCTION :LAMBDA-LIST "(weight &optional (radix 10))" :DOCSTRING "All arguments must be integers. Returns a character object that represents
a digit of the given weight in the specified radix. Returns NIL if no such
character exists." :ORIGIN :SBCL :CLHS-PAGE "Body/f_digit_.htm")
  (:NAME "DIGIT-CHAR-P" :KIND :FUNCTION :LAMBDA-LIST "(char &optional (radix 10))" :DOCSTRING "If char is a digit in the specified radix, returns the fixnum for which
that digit stands, else returns NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_digi_1.htm")
  (:NAME "DIRECTORY" :KIND :FUNCTION :LAMBDA-LIST "(pathspec &key (resolve-symlinks t))" :DOCSTRING "Return a list of PATHNAMEs, each the TRUENAME of a file matching PATHSPEC.

Note that the interaction between this ANSI-specified TRUENAMEing and
the semantics of the Unix filesystem (symbolic links..) means this
function can sometimes return files which don't have the same
directory as PATHSPEC.

If :RESOLVE-SYMLINKS is NIL, don't resolve symbolic links in matching
filenames." :ORIGIN :SBCL :CLHS-PAGE "Body/f_dir.htm")
  (:NAME "DIRECTORY-NAMESTRING" :KIND :FUNCTION :LAMBDA-LIST "(pathname)" :DOCSTRING "Return a string representation of the directory in PATHNAME." :ORIGIN :SBCL :CLHS-PAGE "Body/f_namest.htm")
  (:NAME "DISASSEMBLE" :KIND :FUNCTION :LAMBDA-LIST "(object &key (stream *standard-output*) (use-labels t))" :DOCSTRING "Disassemble the compiled code associated with OBJECT, which can be a
function, a lambda expression, or a symbol with a function definition. If
it is not already compiled, the compiler is called to produce something to
disassemble." :ORIGIN :SBCL :CLHS-PAGE "Body/f_disass.htm")
  (:NAME "DIVISION-BY-ZERO" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_divisi.htm")
  (:NAME "DO" :KIND :MACRO :LAMBDA-LIST "(varlist endlist &body body)" :DOCSTRING "DO ({(Var [Init] [Step])}*) (Test Exit-Form*) Declaration* Form*
Iteration construct. Each Var is initialized in parallel to the value of the
specified Init form. On subsequent iterations, the Vars are assigned the
value of the Step form (if any) in parallel. The Test is evaluated before
each evaluation of the body Forms. When the Test is true, the Exit-Forms
are evaluated as a PROGN, with the result being the value of the DO. A block
named NIL is established around the entire expansion, allowing RETURN to be
used as an alternate exit mechanism." :ORIGIN :SBCL :CLHS-PAGE "Body/m_do_do.htm")
  (:NAME "DO*" :KIND :MACRO :LAMBDA-LIST "(varlist endlist &body body)" :DOCSTRING "DO* ({(Var [Init] [Step])}*) (Test Exit-Form*) Declaration* Form*
Iteration construct. Each Var is initialized sequentially (like LET*) to the
value of the specified Init form. On subsequent iterations, the Vars are
sequentially assigned the value of the Step form (if any). The Test is
evaluated before each evaluation of the body Forms. When the Test is true,
the Exit-Forms are evaluated as a PROGN, with the result being the value
of the DO. A block named NIL is established around the entire expansion,
allowing RETURN to be used as an alternate exit mechanism." :ORIGIN :SBCL :CLHS-PAGE "Body/m_do_do.htm")
  (:NAME "DO-ALL-SYMBOLS" :KIND :MACRO :LAMBDA-LIST "((var &optional result-form) &body body-decls)" :DOCSTRING "DO-ALL-SYMBOLS (VAR [RESULT-FORM]) {DECLARATION}* {TAG | FORM}*
Executes the FORMs once for each symbol in every package with VAR bound
to the current symbol." :ORIGIN :SBCL :CLHS-PAGE "Body/m_do_sym.htm")
  (:NAME "DO-EXTERNAL-SYMBOLS" :KIND :MACRO :LAMBDA-LIST "((var &optional (package '*package*) result-form) &body body-decls)" :DOCSTRING "DO-EXTERNAL-SYMBOLS (VAR [PACKAGE [RESULT-FORM]]) {DECL}* {TAG | FORM}*
Executes the FORMs once for each external symbol in the given PACKAGE with
VAR bound to the current symbol." :ORIGIN :SBCL :CLHS-PAGE "Body/m_do_sym.htm")
  (:NAME "DO-SYMBOLS" :KIND :MACRO :LAMBDA-LIST "((var &optional (package '*package*) result-form) &body body-decls)" :DOCSTRING "DO-SYMBOLS (VAR [PACKAGE [RESULT-FORM]]) {DECLARATION}* {TAG | FORM}*
Executes the FORMs at least once for each symbol accessible in the given
PACKAGE with VAR bound to the current symbol." :ORIGIN :SBCL :CLHS-PAGE "Body/m_do_sym.htm")
  (:NAME "DOCUMENTATION" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(object doc-type)" :DOCSTRING "Return the documentation string of DOC-TYPE for OBJECT,
or NIL if none exists. In addition to the DOC-TYPEs and methods
required by ANSI, SBCL's DOCUMENTATION (and its SETF) supports methods
with the following signatures:

- (OBJECT SYMBOL) (DOC-TYPE (EQL DECLARATION))

- (OBJECT SB-MOP:SLOT-DEFINITION) (DOC-TYPE (EQL T))

Since CONDITIONs are implemented as classes in SBCL, the following
also work:

- (OBJECT CONDITION) (DOC-TYPE (EQL T))

- (OBJECT CONDITION) (DOC-TYPE (EQL 'TYPE))

Function documentation is stored separately for function names and objects:
DEFUN, LAMBDA, &co create function objects with the specified documentation
strings.

    (setf (documentation name 'function) string)

sets the documentation string stored under the specified name, and

    (setf (documentation func t) string)

sets the documentation string stored in the function object.

    (documentation name 'function)

returns the documentation stored under the function name if any, and
falls back on the documentation in the function object if necessary." :ORIGIN :SBCL :CLHS-PAGE "Body/f_docume.htm")
  (:NAME "DOLIST" :KIND :MACRO :LAMBDA-LIST "((var list &optional (result nil)) &body body)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_dolist.htm")
  (:NAME "DOTIMES" :KIND :MACRO :LAMBDA-LIST "((var count &optional (result nil)) &body body)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_dotime.htm")
  (:NAME "DOUBLE-FLOAT" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_short_.htm")
  (:NAME "DOUBLE-FLOAT-EPSILON" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_short_.htm")
  (:NAME "DOUBLE-FLOAT-NEGATIVE-EPSILON" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_short_.htm")
  (:NAME "DPB" :KIND :FUNCTION :LAMBDA-LIST "(newbyte bytespec integer)" :DOCSTRING "Return new integer with newbyte in specified position, newbyte is right justified." :ORIGIN :SBCL :CLHS-PAGE "Body/f_dpb.htm")
  (:NAME "DRIBBLE" :KIND :FUNCTION :LAMBDA-LIST "(&optional pathname &key (if-exists :append))" :DOCSTRING "With a file name as an argument, dribble opens the file and sends a
record of further I/O to that file. Without an argument, it closes
the dribble file, and quits logging." :ORIGIN :SBCL :CLHS-PAGE "Body/f_dribbl.htm")
  (:NAME "DYNAMIC-EXTENT" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_dynami.htm")
  (:NAME "ECASE" :KIND :MACRO :LAMBDA-LIST "(keyform &body cases)" :DOCSTRING "ECASE Keyform {({(Key*) | Key} Form*)}*
Evaluates the Forms in the first clause with a Key EQL to the value of
Keyform. If none of the keys matches then an error is signalled." :ORIGIN :SBCL :CLHS-PAGE "Body/m_case_.htm")
  (:NAME "ECHO-STREAM" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_echo_s.htm")
  (:NAME "ECHO-STREAM-INPUT-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(instance)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_echo_s.htm")
  (:NAME "ECHO-STREAM-OUTPUT-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(instance)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_echo_s.htm")
  (:NAME "ED" :KIND :FUNCTION :LAMBDA-LIST "(&optional x)" :DOCSTRING "Starts the editor (on a file or a function if named).  Functions
from the list *ED-FUNCTIONS* are called in order with X as an argument
until one of them returns non-NIL; these functions are responsible for
signalling a FILE-ERROR to indicate failure to perform an operation on
the file system." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ed.htm")
  (:NAME "EIGHTH" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return the 8th object in a list or NIL if there is no 8th object." :ORIGIN :SBCL :CLHS-PAGE "Body/f_firstc.htm")
  (:NAME "ELT" :KIND :FUNCTION :LAMBDA-LIST "(sequence index)" :DOCSTRING "Return the element of SEQUENCE specified by INDEX." :ORIGIN :SBCL :CLHS-PAGE "Body/f_elt.htm")
  (:NAME "ENCODE-UNIVERSAL-TIME" :KIND :FUNCTION :LAMBDA-LIST "(second minute hour date month year &optional time-zone)" :DOCSTRING "The time values specified in decoded format are converted to
universal time, which is returned." :ORIGIN :SBCL :CLHS-PAGE "Body/f_encode.htm")
  (:NAME "END-OF-FILE" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_end_of.htm")
  (:NAME "ENDP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "This is the recommended way to test for the end of a proper list. It
returns true if OBJECT is NIL, false if OBJECT is a CONS, and an error
for any other type of OBJECT." :ORIGIN :SBCL :CLHS-PAGE "Body/f_endp.htm")
  (:NAME "ENOUGH-NAMESTRING" :KIND :FUNCTION :LAMBDA-LIST "(pathname &optional (defaults *default-pathname-defaults*))" :DOCSTRING "Return an abbreviated pathname sufficient to identify PATHNAME
relative to DEFAULTS." :ORIGIN :SBCL :CLHS-PAGE "Body/f_namest.htm")
  (:NAME "ENSURE-DIRECTORIES-EXIST" :KIND :FUNCTION :LAMBDA-LIST "(pathspec &key verbose (mode 511))" :DOCSTRING "Test whether the directories containing the specified file
actually exist, and attempt to create them if they do not.
The MODE argument is a CMUCL/SBCL-specific extension to control
the Unix permission bits." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ensu_1.htm")
  (:NAME "ENSURE-GENERIC-FUNCTION" :KIND :FUNCTION :LAMBDA-LIST "(fun-name &rest all-keys)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_ensure.htm")
  (:NAME "EQ" :KIND :FUNCTION :LAMBDA-LIST "(obj1 obj2)" :DOCSTRING "Return T if OBJ1 and OBJ2 are the same object, otherwise NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_eq.htm")
  (:NAME "EQL" :KIND :FUNCTION :LAMBDA-LIST "(x y)" :DOCSTRING "Return T if OBJ1 and OBJ2 represent the same object, otherwise NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/a_eql.htm")
  (:NAME "EQL" :KIND :TYPE :ORIGIN :SBCL :CLHS-PAGE "Body/a_eql.htm")
  (:NAME "EQUAL" :KIND :FUNCTION :LAMBDA-LIST "(x y)" :DOCSTRING "Return T if X and Y are EQL or if they are structured components whose
elements are EQUAL. Strings and bit-vectors are EQUAL if they are the same
length and have identical components. Other arrays must be EQ to be EQUAL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_equal.htm")
  (:NAME "EQUALP" :KIND :FUNCTION :LAMBDA-LIST "(x y)" :DOCSTRING "Just like EQUAL, but more liberal in several respects.
Numbers may be of different types, as long as the values are identical
after coercion. Characters may differ in alphabetic case. Vectors and
arrays must have identical dimensions and EQUALP elements, but may differ
in their type restriction. The elements of structured components
are compared with EQUALP." :ORIGIN :SBCL :CLHS-PAGE "Body/f_equalp.htm")
  (:NAME "ERROR" :KIND :FUNCTION :LAMBDA-LIST "(datum &rest arguments)" :DOCSTRING "Invoke the signal facility on a condition formed from DATUM and ARGUMENTS.
If the condition is not handled, the debugger is invoked." :ORIGIN :SBCL :CLHS-PAGE "Body/a_error.htm")
  (:NAME "ERROR" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/a_error.htm")
  (:NAME "ETYPECASE" :KIND :MACRO :LAMBDA-LIST "(keyform &body cases)" :DOCSTRING "ETYPECASE Keyform {(Type Form*)}*
Evaluates the Forms in the first clause for which TYPEP of Keyform and Type
is true. If no form is satisfied then an error is signalled." :ORIGIN :SBCL :CLHS-PAGE "Body/m_tpcase.htm")
  (:NAME "EVAL" :KIND :FUNCTION :LAMBDA-LIST "(original-exp)" :DOCSTRING "Evaluate the argument in a null lexical environment, returning the
result or results." :ORIGIN :SBCL :CLHS-PAGE "Body/f_eval.htm")
  (:NAME "EVAL-WHEN" :KIND :SPECIAL-OPERATOR :DOCSTRING "EVAL-WHEN (situation*) form*

Evaluate the FORMS in the specified SITUATIONS (any of :COMPILE-TOPLEVEL,
:LOAD-TOPLEVEL, or :EXECUTE, or (deprecated) COMPILE, LOAD, or EVAL)." :ORIGIN :SBCL :CLHS-PAGE "Body/s_eval_w.htm")
  (:NAME "EVENP" :KIND :FUNCTION :LAMBDA-LIST "(integer)" :DOCSTRING "Is this integer even?" :ORIGIN :SBCL :CLHS-PAGE "Body/f_evenpc.htm")
  (:NAME "EVERY" :KIND :FUNCTION :LAMBDA-LIST "(pred first-seq &rest more-seqs)" :DOCSTRING "Apply PREDICATE to the 0-indexed elements of the sequences, then
possibly to those with index 1, and so on. Return NIL as soon
as any invocation of PREDICATE returns NIL, or T if every invocation
is non-NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_everyc.htm")
  (:NAME "EXP" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Return e raised to the power NUMBER." :ORIGIN :SBCL :CLHS-PAGE "Body/f_exp_e.htm")
  (:NAME "EXPORT" :KIND :FUNCTION :LAMBDA-LIST "(symbols &optional (package (sane-package)))" :DOCSTRING "Exports SYMBOLS from PACKAGE, checking that no name conflicts result." :ORIGIN :SBCL :CLHS-PAGE "Body/f_export.htm")
  (:NAME "EXPT" :KIND :FUNCTION :LAMBDA-LIST "(base power)" :DOCSTRING "Return BASE raised to the POWER." :ORIGIN :SBCL :CLHS-PAGE "Body/f_exp_e.htm")
  (:NAME "EXTENDED-CHAR" :KIND :TYPE :DOCSTRING "Type of CHARACTERs that aren't BASE-CHARs." :ORIGIN :SBCL :CLHS-PAGE "Body/t_extend.htm")
  (:NAME "FBOUNDP" :KIND :FUNCTION :LAMBDA-LIST "(name)" :DOCSTRING "Return true if name has a global function definition." :ORIGIN :SBCL :CLHS-PAGE "Body/f_fbound.htm")
  (:NAME "FCEILING" :KIND :FUNCTION :LAMBDA-LIST "(number &optional (divisor 1))" :DOCSTRING "Same as CEILING, but returns first value as a float." :ORIGIN :SBCL :CLHS-PAGE "Body/f_floorc.htm")
  (:NAME "FDEFINITION" :KIND :FUNCTION :LAMBDA-LIST "(name)" :DOCSTRING "Return the global function associated with NAME. SETFable.

Note that encapsulations (e.g. by TRACE and SB-PROFILE:PROFILE)
can change the global function definition. FDEFINITION always returns
outermost encapsulation. SB-EXT:UNENCAPSULATED-FUNCTION may be used
to get the innermost function.

When SETFed, NAME's encapsulations are kept and the innermost
encapsulated function is replaced by the new value (stripped from
any encapsulations)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_fdefin.htm")
  (:NAME "FFLOOR" :KIND :FUNCTION :LAMBDA-LIST "(number &optional (divisor 1))" :DOCSTRING "Same as FLOOR, but returns first value as a float." :ORIGIN :SBCL :CLHS-PAGE "Body/f_floorc.htm")
  (:NAME "FIFTH" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return the 5th object in a list or NIL if there is no 5th object." :ORIGIN :SBCL :CLHS-PAGE "Body/f_firstc.htm")
  (:NAME "FILE-AUTHOR" :KIND :FUNCTION :LAMBDA-LIST "(pathspec)" :DOCSTRING "Return the author of the file specified by PATHSPEC. Signal an
error of type FILE-ERROR if no such file exists, or if PATHSPEC
is a wild pathname." :ORIGIN :SBCL :CLHS-PAGE "Body/f_file_a.htm")
  (:NAME "FILE-ERROR" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_file_e.htm")
  (:NAME "FILE-ERROR-PATHNAME" :KIND :FUNCTION :LAMBDA-LIST "(condition)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_file_e.htm")
  (:NAME "FILE-LENGTH" :KIND :FUNCTION :LAMBDA-LIST "(stream)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_file_l.htm")
  (:NAME "FILE-NAMESTRING" :KIND :FUNCTION :LAMBDA-LIST "(pathname)" :DOCSTRING "Return a string representation of the name in PATHNAME." :ORIGIN :SBCL :CLHS-PAGE "Body/f_namest.htm")
  (:NAME "FILE-POSITION" :KIND :FUNCTION :LAMBDA-LIST "(stream &optional (position 0 suppliedp))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_file_p.htm")
  (:NAME "FILE-STREAM" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_file_s.htm")
  (:NAME "FILE-STRING-LENGTH" :KIND :FUNCTION :LAMBDA-LIST "(stream object)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_file_s.htm")
  (:NAME "FILE-WRITE-DATE" :KIND :FUNCTION :LAMBDA-LIST "(pathspec)" :DOCSTRING "Return the write date of the file specified by PATHSPEC.
An error of type FILE-ERROR is signaled if no such file exists,
or if PATHSPEC is a wild pathname." :ORIGIN :SBCL :CLHS-PAGE "Body/f_file_w.htm")
  (:NAME "FILL" :KIND :FUNCTION :LAMBDA-LIST "(sequence item &key (start 0) end)" :DOCSTRING "Replace the specified elements of SEQUENCE with ITEM." :ORIGIN :SBCL :CLHS-PAGE "Body/f_fill.htm")
  (:NAME "FILL-POINTER" :KIND :FUNCTION :LAMBDA-LIST "(vector)" :DOCSTRING "Return the FILL-POINTER of the given VECTOR." :ORIGIN :SBCL :CLHS-PAGE "Body/f_fill_p.htm")
  (:NAME "FIND" :KIND :FUNCTION :LAMBDA-LIST "(item sequence &rest args &key from-end (start 0) end key test test-not)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_find_.htm")
  (:NAME "FIND-ALL-SYMBOLS" :KIND :FUNCTION :LAMBDA-LIST "(string-designator)" :DOCSTRING "Return a list of all symbols in the system having the specified name." :ORIGIN :SBCL :CLHS-PAGE "Body/f_find_a.htm")
  (:NAME "FIND-CLASS" :KIND :FUNCTION :LAMBDA-LIST "(symbol &optional (errorp t) environment)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_find_c.htm")
  (:NAME "FIND-IF" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) end key)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_find_.htm")
  (:NAME "FIND-IF-NOT" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) end key)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_find_.htm")
  (:NAME "FIND-METHOD" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(generic-function qualifiers specializers &optional errorp)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_find_m.htm")
  (:NAME "FIND-PACKAGE" :KIND :FUNCTION :LAMBDA-LIST "(package-designator)" :DOCSTRING "If PACKAGE-DESIGNATOR is a package, it is returned. Otherwise PACKAGE-DESIGNATOR
must be a string designator, in which case the package it names is located and returned.

As an SBCL extension, the current package may affect the way a package name is
resolved: if the current package has local nicknames specified, package names
matching those are resolved to the packages associated with them instead.

Example:

  (defpackage :a)
  (defpackage :example (:use :cl) (:local-nicknames (:x :a)))
  (let ((*package* (find-package :example)))
    (find-package :x)) => #<PACKAGE A>

See also: ADD-PACKAGE-LOCAL-NICKNAME, PACKAGE-LOCAL-NICKNAMES,
REMOVE-PACKAGE-LOCAL-NICKNAME, and the DEFPACKAGE option :LOCAL-NICKNAMES." :ORIGIN :SBCL :CLHS-PAGE "Body/f_find_p.htm")
  (:NAME "FIND-RESTART" :KIND :FUNCTION :LAMBDA-LIST "(identifier &optional condition)" :DOCSTRING "Return the first restart identified by IDENTIFIER. If IDENTIFIER is a symbol,
then the innermost applicable restart with that name is returned. If IDENTIFIER
is a restart, it is returned if it is currently active. Otherwise NIL is
returned. If CONDITION is specified and not NIL, then only restarts associated
with that condition (or with no condition) will be returned." :ORIGIN :SBCL :CLHS-PAGE "Body/f_find_r.htm")
  (:NAME "FIND-SYMBOL" :KIND :FUNCTION :LAMBDA-LIST "(name &optional (package (sane-package)))" :DOCSTRING "Return the symbol named NAME in PACKAGE. If such a symbol is found
then the second value is :INTERNAL, :EXTERNAL or :INHERITED to indicate
how the symbol is accessible. If no symbol is found then both values
are NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_find_s.htm")
  (:NAME "FINISH-OUTPUT" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-output*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_finish.htm")
  (:NAME "FIRST" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return the 1st object in a list or NIL if the list is empty." :ORIGIN :SBCL :CLHS-PAGE "Body/f_firstc.htm")
  (:NAME "FIXNUM" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_fixnum.htm")
  (:NAME "FLET" :KIND :SPECIAL-OPERATOR :DOCSTRING "FLET ({(name lambda-list declaration* form*)}*) declaration* body-form*

Evaluate the BODY-FORMs with local function definitions. The
bindings do not enclose the definitions; any use of NAME in the
FORMs will refer to the lexically apparent function definition in
the enclosing environment." :ORIGIN :SBCL :CLHS-PAGE "Body/s_flet_.htm")
  (:NAME "FLOAT" :KIND :FUNCTION :LAMBDA-LIST "(number &optional (other nil otherp))" :DOCSTRING "Converts any REAL to a float. If OTHER is not provided, it returns a
SINGLE-FLOAT if NUMBER is not already a FLOAT. If OTHER is provided, the
result is the same float format as OTHER." :ORIGIN :SBCL :CLHS-PAGE "Body/a_float.htm")
  (:NAME "FLOAT" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_float.htm")
  (:NAME "FLOAT-DIGITS" :KIND :FUNCTION :LAMBDA-LIST "(f)" :DOCSTRING "Return a non-negative number of radix-b digits used in the
representation of its argument." :ORIGIN :SBCL :CLHS-PAGE "Body/f_dec_fl.htm")
  (:NAME "FLOAT-PRECISION" :KIND :FUNCTION :LAMBDA-LIST "(f)" :DOCSTRING "Return a non-negative number of significant digits in its float argument.
Will be less than FLOAT-DIGITS if denormalized or zero." :ORIGIN :SBCL :CLHS-PAGE "Body/f_dec_fl.htm")
  (:NAME "FLOAT-RADIX" :KIND :FUNCTION :LAMBDA-LIST "(x)" :DOCSTRING "Return (as an integer) the radix b of its floating-point argument." :ORIGIN :SBCL :CLHS-PAGE "Body/f_dec_fl.htm")
  (:NAME "FLOAT-SIGN" :KIND :FUNCTION :LAMBDA-LIST "(float1 &optional (float2 (float 1 float1)))" :DOCSTRING "Return a floating-point number that has the same sign as
FLOAT1 and, if FLOAT2 is given, has the same absolute value
as FLOAT2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_dec_fl.htm")
  (:NAME "FLOATING-POINT-INEXACT" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_floa_1.htm")
  (:NAME "FLOATING-POINT-INVALID-OPERATION" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_floati.htm")
  (:NAME "FLOATING-POINT-OVERFLOW" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_floa_2.htm")
  (:NAME "FLOATING-POINT-UNDERFLOW" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_floa_3.htm")
  (:NAME "FLOATP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a FLOAT, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_floatp.htm")
  (:NAME "FLOOR" :KIND :FUNCTION :LAMBDA-LIST "(number &optional (divisor 1))" :DOCSTRING "Return number/divisor as an integer, rounded toward negative infinity.
The second returned value is the remainder." :ORIGIN :SBCL :CLHS-PAGE "Body/f_floorc.htm")
  (:NAME "FMAKUNBOUND" :KIND :FUNCTION :LAMBDA-LIST "(name)" :DOCSTRING "Make NAME have no global function definition." :ORIGIN :SBCL :CLHS-PAGE "Body/f_fmakun.htm")
  (:NAME "FORCE-OUTPUT" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-output*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_finish.htm")
  (:NAME "FORMAT" :KIND :FUNCTION :LAMBDA-LIST "(destination control-string &rest format-arguments)" :DOCSTRING "Provides various facilities for formatting output.
CONTROL-STRING contains a string to be output, possibly with embedded
directives, which are flagged with the escape character \"~\". Directives
generally expand into additional text to be output, usually consuming one
or more of the FORMAT-ARGUMENTS in the process. A few useful directives
are:
      ~A or ~nA   Prints one argument as if by PRINC
      ~S or ~nS   Prints one argument as if by PRIN1
      ~D or ~nD   Prints one argument as a decimal integer
      ~%          Does a TERPRI
      ~&          Does a FRESH-LINE
where n is the width of the field in which the object is printed.

DESTINATION controls where the result will go. If DESTINATION is T, then
the output is sent to the standard output stream. If it is NIL, then the
output is returned in a string as the value of the call. Otherwise,
DESTINATION must be a stream to which the output will be sent.

Example:   (FORMAT NIL \"The answer is ~D.\" 10) => \"The answer is 10.\"

FORMAT has many additional capabilities not described here. Consult the
manual for details." :ORIGIN :SBCL :CLHS-PAGE "Body/f_format.htm")
  (:NAME "FORMATTER" :KIND :MACRO :LAMBDA-LIST "(control-string)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_format.htm")
  (:NAME "FOURTH" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return the 4th object in a list or NIL if there is no 4th object." :ORIGIN :SBCL :CLHS-PAGE "Body/f_firstc.htm")
  (:NAME "FRESH-LINE" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-output*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_terpri.htm")
  (:NAME "FROUND" :KIND :FUNCTION :LAMBDA-LIST "(number &optional (divisor 1))" :DOCSTRING "Same as ROUND, but returns first value as a float." :ORIGIN :SBCL :CLHS-PAGE "Body/f_floorc.htm")
  (:NAME "FTRUNCATE" :KIND :FUNCTION :LAMBDA-LIST "(number &optional (divisor 1))" :DOCSTRING "Same as TRUNCATE, but returns first value as a float." :ORIGIN :SBCL :CLHS-PAGE "Body/f_floorc.htm")
  (:NAME "FTYPE" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_ftype.htm")
  (:NAME "FUNCALL" :KIND :FUNCTION :LAMBDA-LIST "(function &rest arguments)" :DOCSTRING "Call FUNCTION with the given ARGUMENTS." :ORIGIN :SBCL :CLHS-PAGE "Body/f_funcal.htm")
  (:NAME "FUNCTION" :KIND :SPECIAL-OPERATOR :DOCSTRING "FUNCTION name

Return the lexically apparent definition of the function NAME. NAME may also
be a lambda expression." :ORIGIN :SBCL :CLHS-PAGE "Body/a_fn.htm")
  (:NAME "FUNCTION" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_fn.htm")
  (:NAME "FUNCTION-KEYWORDS" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(method)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_fn_kwd.htm")
  (:NAME "FUNCTION-LAMBDA-EXPRESSION" :KIND :FUNCTION :LAMBDA-LIST "(fun)" :DOCSTRING "Return (VALUES DEFINING-LAMBDA-EXPRESSION CLOSURE-P NAME), where
DEFINING-LAMBDA-EXPRESSION is NIL if unknown, or a suitable argument
to COMPILE otherwise, CLOSURE-P is non-NIL if the function's definition
might have been enclosed in some non-null lexical environment, and
NAME is some name (for debugging only) or NIL if there is no name." :ORIGIN :SBCL :CLHS-PAGE "Body/f_fn_lam.htm")
  (:NAME "FUNCTIONP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a FUNCTION, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_fnp.htm")
  (:NAME "GCD" :KIND :FUNCTION :LAMBDA-LIST "(&rest integers)" :DOCSTRING "Return the greatest common divisor of the arguments, which must be
integers. GCD with no arguments is defined to be 0." :ORIGIN :SBCL :CLHS-PAGE "Body/f_gcd.htm")
  (:NAME "GENERIC-FUNCTION" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_generi.htm")
  (:NAME "GENSYM" :KIND :FUNCTION :LAMBDA-LIST "(&optional (thing \"G\"))" :DOCSTRING "Creates a new uninterned symbol whose name is a prefix string (defaults
to \"G\"), followed by a decimal number. Thing, when supplied, will
alter the prefix if it is a string, or be used for the decimal number
if it is a number, of this symbol. The default value of the number is
the current value of *gensym-counter* which is incremented each time
it is used." :ORIGIN :SBCL :CLHS-PAGE "Body/f_gensym.htm")
  (:NAME "GENTEMP" :KIND :FUNCTION :LAMBDA-LIST "(&optional (prefix \"T\") (package (sane-package)))" :DOCSTRING "Creates a new symbol interned in package PACKAGE with the given PREFIX." :ORIGIN :SBCL :CLHS-PAGE "Body/f_gentem.htm")
  (:NAME "GET" :KIND :FUNCTION :LAMBDA-LIST "(symbol indicator &optional (default nil))" :DOCSTRING "Look on the property list of SYMBOL for the specified INDICATOR. If this
is found, return the associated value, else return DEFAULT." :ORIGIN :SBCL :CLHS-PAGE "Body/f_get.htm")
  (:NAME "GET-DECODED-TIME" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return nine values specifying the current time as follows:
second, minute, hour, date, month, year, day of week (0 = Monday), T
(daylight savings times) or NIL (standard time), and timezone." :ORIGIN :SBCL :CLHS-PAGE "Body/f_get_un.htm")
  (:NAME "GET-DISPATCH-MACRO-CHARACTER" :KIND :FUNCTION :LAMBDA-LIST "(disp-char sub-char &optional (rt-designator *readtable*))" :DOCSTRING "Return the macro character function for SUB-CHAR under DISP-CHAR
or NIL if there is no associated function." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set__1.htm")
  (:NAME "GET-INTERNAL-REAL-TIME" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return the real time (\"wallclock time\") since startup in the internal
time format. (See INTERNAL-TIME-UNITS-PER-SECOND.)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_get_in.htm")
  (:NAME "GET-INTERNAL-RUN-TIME" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return the run time used by the process in the internal time format. (See
INTERNAL-TIME-UNITS-PER-SECOND.) This is useful for finding CPU usage.
Includes both \"system\" and \"user\" time." :ORIGIN :SBCL :CLHS-PAGE "Body/f_get__1.htm")
  (:NAME "GET-MACRO-CHARACTER" :KIND :FUNCTION :LAMBDA-LIST "(char &optional (rt-designator *readtable*))" :DOCSTRING "Return the function associated with the specified CHAR which is a macro
character, or NIL if there is no such function. As a second value, return
T if CHAR is a macro character which is non-terminating, i.e. which can
be embedded in a symbol name." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set_ma.htm")
  (:NAME "GET-OUTPUT-STREAM-STRING" :KIND :FUNCTION :LAMBDA-LIST "(stream)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_get_ou.htm")
  (:NAME "GET-PROPERTIES" :KIND :FUNCTION :LAMBDA-LIST "(place indicator-list)" :DOCSTRING "Like GETF, except that INDICATOR-LIST is a list of indicators which will
be looked for in the property list stored in PLACE. Three values are
returned, see manual for details." :ORIGIN :SBCL :CLHS-PAGE "Body/f_get_pr.htm")
  (:NAME "GET-SETF-EXPANSION" :KIND :FUNCTION :LAMBDA-LIST "(form &optional environment)" :DOCSTRING "Return five values needed by the SETF machinery: a list of temporary
variables, a list of values with which to fill them, a list of temporaries
for the new values, the setting function, and the accessing function." :ORIGIN :SBCL :CLHS-PAGE "Body/f_get_se.htm")
  (:NAME "GET-UNIVERSAL-TIME" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return a single integer for the current time of day in universal time
format." :ORIGIN :SBCL :CLHS-PAGE "Body/f_get_un.htm")
  (:NAME "GETF" :KIND :FUNCTION :LAMBDA-LIST "(place indicator &optional (default nil))" :DOCSTRING "Search the property list stored in PLACE for an indicator EQ to INDICATOR.
If one is found, return the corresponding value, else return DEFAULT." :ORIGIN :SBCL :CLHS-PAGE "Body/f_getf.htm")
  (:NAME "GETHASH" :KIND :FUNCTION :LAMBDA-LIST "(key hash-table &optional default)" :DOCSTRING "Finds the entry in HASH-TABLE whose key is KEY and returns the
associated value and T as multiple values, or returns DEFAULT and NIL
if there is no such entry. Entries can be added using SETF." :ORIGIN :SBCL :CLHS-PAGE "Body/f_gethas.htm")
  (:NAME "GO" :KIND :SPECIAL-OPERATOR :DOCSTRING "GO tag

Transfer control to the named TAG in the lexically enclosing TAGBODY. This is
constrained to be used only within the dynamic extent of the TAGBODY." :ORIGIN :SBCL :CLHS-PAGE "Body/s_go.htm")
  (:NAME "GRAPHIC-CHAR-P" :KIND :FUNCTION :LAMBDA-LIST "(char)" :DOCSTRING "The argument must be a character object. GRAPHIC-CHAR-P returns T if the
argument is a printing character (space through ~ in ASCII), otherwise returns
NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_graphi.htm")
  (:NAME "HANDLER-BIND" :KIND :MACRO :LAMBDA-LIST "(bindings &body forms)" :DOCSTRING "(HANDLER-BIND ( {(type handler)}* ) body)

Executes body in a dynamic context where the given handler bindings are in
effect. Each handler must take the condition being signalled as an argument.
The bindings are searched first to last in the event of a signalled
condition." :ORIGIN :SBCL :CLHS-PAGE "Body/m_handle.htm")
  (:NAME "HANDLER-CASE" :KIND :MACRO :LAMBDA-LIST "(form &rest cases)" :DOCSTRING "(HANDLER-CASE form { (type ([var]) body) }*)

Execute FORM in a context with handlers established for the condition types. A
peculiar property allows type to be :NO-ERROR. If such a clause occurs, and
form returns normally, all its values are passed to this clause as if by
MULTIPLE-VALUE-CALL. The :NO-ERROR clause accepts more than one var
specification." :ORIGIN :SBCL :CLHS-PAGE "Body/m_hand_1.htm")
  (:NAME "HASH-TABLE" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_hash_t.htm")
  (:NAME "HASH-TABLE-COUNT" :KIND :FUNCTION :LAMBDA-LIST "(hash-table)" :DOCSTRING "Return the number of entries in the given HASH-TABLE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_hash_1.htm")
  (:NAME "HASH-TABLE-P" :KIND :FUNCTION :LAMBDA-LIST "(object)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_hash_t.htm")
  (:NAME "HASH-TABLE-REHASH-SIZE" :KIND :FUNCTION :LAMBDA-LIST "(hash-table)" :DOCSTRING "Return the rehash-size HASH-TABLE was created with." :ORIGIN :SBCL :CLHS-PAGE "Body/f_hash_2.htm")
  (:NAME "HASH-TABLE-REHASH-THRESHOLD" :KIND :FUNCTION :LAMBDA-LIST "(hash-table)" :DOCSTRING "Return the rehash-threshold HASH-TABLE was created with." :ORIGIN :SBCL :CLHS-PAGE "Body/f_hash_3.htm")
  (:NAME "HASH-TABLE-SIZE" :KIND :FUNCTION :LAMBDA-LIST "(hash-table)" :DOCSTRING "Return a size that can be used with MAKE-HASH-TABLE to create a hash
table that can hold however many entries HASH-TABLE can hold without
having to be grown." :ORIGIN :SBCL :CLHS-PAGE "Body/f_hash_4.htm")
  (:NAME "HASH-TABLE-TEST" :KIND :FUNCTION :LAMBDA-LIST "(hash-table)" :DOCSTRING "Return the test HASH-TABLE was created with." :ORIGIN :SBCL :CLHS-PAGE "Body/f_hash_5.htm")
  (:NAME "HOST-NAMESTRING" :KIND :FUNCTION :LAMBDA-LIST "(pathname)" :DOCSTRING "Return a string representation of the name of the host in PATHNAME." :ORIGIN :SBCL :CLHS-PAGE "Body/f_namest.htm")
  (:NAME "IDENTITY" :KIND :FUNCTION :LAMBDA-LIST "(thing)" :DOCSTRING "This function simply returns what was passed to it." :ORIGIN :SBCL :CLHS-PAGE "Body/f_identi.htm")
  (:NAME "IF" :KIND :SPECIAL-OPERATOR :DOCSTRING "IF predicate then [else]

If PREDICATE evaluates to true, evaluate THEN and return its values,
otherwise evaluate ELSE and return its values. ELSE defaults to NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/s_if.htm")
  (:NAME "IGNORABLE" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_ignore.htm")
  (:NAME "IGNORE" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_ignore.htm")
  (:NAME "IGNORE-ERRORS" :KIND :MACRO :LAMBDA-LIST "(&rest forms)" :DOCSTRING "Execute FORMS handling ERROR conditions, returning the result of the last
form, or (VALUES NIL the-ERROR-that-was-caught) if an ERROR was handled." :ORIGIN :SBCL :CLHS-PAGE "Body/m_ignore.htm")
  (:NAME "IMAGPART" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Extract the imaginary part of a number." :ORIGIN :SBCL :CLHS-PAGE "Body/f_realpa.htm")
  (:NAME "IMPORT" :KIND :FUNCTION :LAMBDA-LIST "(symbols &optional (package (sane-package)))" :DOCSTRING "Make SYMBOLS accessible as internal symbols in PACKAGE. If a symbol is
already accessible then it has no effect. If a name conflict would result from
the importation, then a correctable error is signalled." :ORIGIN :SBCL :CLHS-PAGE "Body/f_import.htm")
  (:NAME "IN-PACKAGE" :KIND :MACRO :LAMBDA-LIST "(string-designator)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_in_pkg.htm")
  (:NAME "INCF" :KIND :MACRO :LAMBDA-LIST "(place &optional (delta 1))" :DOCSTRING "The first argument is some location holding a number. This number is
incremented by the second argument, DELTA, which defaults to 1." :ORIGIN :SBCL :CLHS-PAGE "Body/m_incf_.htm")
  (:NAME "INITIALIZE-INSTANCE" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(instance &rest initargs &key &allow-other-keys)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_init_i.htm")
  (:NAME "INLINE" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_inline.htm")
  (:NAME "INPUT-STREAM-P" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(stream)" :DOCSTRING "Can STREAM perform input operations?" :ORIGIN :SBCL :CLHS-PAGE "Body/f_in_stm.htm")
  (:NAME "INSPECT" :KIND :FUNCTION :LAMBDA-LIST "(object)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_inspec.htm")
  (:NAME "INTEGER" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_intege.htm")
  (:NAME "INTEGER-DECODE-FLOAT" :KIND :FUNCTION :LAMBDA-LIST "(x)" :DOCSTRING "Return three values:
1) an integer representation of the significand.
2) the exponent for the power of 2 that the significand must be multiplied
   by to get the actual value. This differs from the DECODE-FLOAT exponent
   by FLOAT-DIGITS, since the significand has been scaled to have all its
   digits before the radix point.
3) -1 or 1 (i.e. the sign of the argument.)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_dec_fl.htm")
  (:NAME "INTEGER-LENGTH" :KIND :FUNCTION :LAMBDA-LIST "(integer)" :DOCSTRING "Return the number of non-sign bits in the twos-complement representation
of INTEGER." :ORIGIN :SBCL :CLHS-PAGE "Body/f_intege.htm")
  (:NAME "INTEGERP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is an INTEGER, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_inte_1.htm")
  (:NAME "INTERACTIVE-STREAM-P" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(stream)" :DOCSTRING "Is STREAM an interactive stream?" :ORIGIN :SBCL :CLHS-PAGE "Body/f_intera.htm")
  (:NAME "INTERN" :KIND :FUNCTION :LAMBDA-LIST "(name &optional (package (sane-package)))" :DOCSTRING "Return a symbol in PACKAGE having the specified NAME, creating it
if necessary." :ORIGIN :SBCL :CLHS-PAGE "Body/f_intern.htm")
  (:NAME "INTERNAL-TIME-UNITS-PER-SECOND" :KIND :CONSTANT :DOCSTRING "The number of internal time units that fit into a second. See
GET-INTERNAL-REAL-TIME and GET-INTERNAL-RUN-TIME." :ORIGIN :SBCL :CLHS-PAGE "Body/v_intern.htm")
  (:NAME "INTERSECTION" :KIND :FUNCTION :LAMBDA-LIST "(list1 list2 &key key (test nil testp) (test-not nil notp))" :DOCSTRING "Return the intersection of LIST1 and LIST2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_isec_.htm")
  (:NAME "INVALID-METHOD-ERROR" :KIND :FUNCTION :LAMBDA-LIST "(method format-control &rest format-arguments)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_invali.htm")
  (:NAME "INVOKE-DEBUGGER" :KIND :FUNCTION :LAMBDA-LIST "(condition)" :DOCSTRING "Enter the debugger." :ORIGIN :SBCL :CLHS-PAGE "Body/f_invoke.htm")
  (:NAME "INVOKE-RESTART" :KIND :FUNCTION :LAMBDA-LIST "(restart &rest values)" :DOCSTRING "Calls the function associated with the given restart, passing any given
arguments. If the argument restart is not a restart or a currently active
non-nil restart name, then a CONTROL-ERROR is signalled." :ORIGIN :SBCL :CLHS-PAGE "Body/f_invo_1.htm")
  (:NAME "INVOKE-RESTART-INTERACTIVELY" :KIND :FUNCTION :LAMBDA-LIST "(restart)" :DOCSTRING "Calls the function associated with the given restart, prompting for any
necessary arguments. If the argument restart is not a restart or a
currently active non-NIL restart name, then a CONTROL-ERROR is signalled." :ORIGIN :SBCL :CLHS-PAGE "Body/f_invo_2.htm")
  (:NAME "ISQRT" :KIND :FUNCTION :LAMBDA-LIST "(n)" :DOCSTRING "Return the greatest integer less than or equal to the square root of N." :ORIGIN :SBCL :CLHS-PAGE "Body/f_sqrt_.htm")
  (:NAME "KEYWORD" :KIND :TYPE :ORIGIN :SBCL :CLHS-PAGE "Body/t_kwd.htm")
  (:NAME "KEYWORDP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if Object is a symbol in the \"KEYWORD\" package." :ORIGIN :SBCL :CLHS-PAGE "Body/f_kwdp.htm")
  (:NAME "LABELS" :KIND :SPECIAL-OPERATOR :DOCSTRING "LABELS ({(name lambda-list declaration* form*)}*) declaration* body-form*

Evaluate the BODY-FORMs with local function definitions. The
bindings enclose the new definitions, so the defined functions can
call themselves or each other." :ORIGIN :SBCL :CLHS-PAGE "Body/s_flet_.htm")
  (:NAME "LAMBDA" :KIND :MACRO :LAMBDA-LIST "(args &body body)" :ORIGIN :SBCL :CLHS-PAGE "Body/a_lambda.htm")
  (:NAME "LAMBDA-LIST-KEYWORDS" :KIND :CONSTANT :DOCSTRING "A list of symbols used as lambda list keywords in SBCL." :ORIGIN :SBCL :CLHS-PAGE "Body/v_lambda.htm")
  (:NAME "LAMBDA-PARAMETERS-LIMIT" :KIND :CONSTANT :DOCSTRING "The exclusive upper bound on the number of parameters which may be specified
in a given lambda list. This is actually the limit on required and &OPTIONAL
parameters. With &KEY and &AUX you can get more." :ORIGIN :SBCL :CLHS-PAGE "Body/v_lamb_1.htm")
  (:NAME "LAST" :KIND :FUNCTION :LAMBDA-LIST "(list &optional (n 1))" :DOCSTRING "Return the last N conses (not the last element!) of a list." :ORIGIN :SBCL :CLHS-PAGE "Body/f_last.htm")
  (:NAME "LCM" :KIND :FUNCTION :LAMBDA-LIST "(&rest integers)" :DOCSTRING "Return the least common multiple of one or more integers. LCM of no
arguments is defined to be 1." :ORIGIN :SBCL :CLHS-PAGE "Body/f_lcm.htm")
  (:NAME "LDB" :KIND :FUNCTION :LAMBDA-LIST "(bytespec integer)" :DOCSTRING "Extract the specified byte from integer, and right justify result." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ldb.htm")
  (:NAME "LDB-TEST" :KIND :FUNCTION :LAMBDA-LIST "(bytespec integer)" :DOCSTRING "Return T if any of the specified bits in integer are 1's." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ldb_te.htm")
  (:NAME "LDIFF" :KIND :FUNCTION :LAMBDA-LIST "(list object)" :DOCSTRING "Return a new list, whose elements are those of LIST that appear before
OBJECT. If OBJECT is not a tail of LIST, a copy of LIST is returned.
LIST must be a proper list or a dotted list." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ldiffc.htm")
  (:NAME "LEAST-NEGATIVE-DOUBLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-NEGATIVE-LONG-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-NEGATIVE-NORMALIZED-DOUBLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-NEGATIVE-NORMALIZED-LONG-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-NEGATIVE-NORMALIZED-SHORT-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-NEGATIVE-NORMALIZED-SINGLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-NEGATIVE-SHORT-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-NEGATIVE-SINGLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-POSITIVE-DOUBLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-POSITIVE-LONG-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-POSITIVE-NORMALIZED-DOUBLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-POSITIVE-NORMALIZED-LONG-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-POSITIVE-NORMALIZED-SHORT-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-POSITIVE-NORMALIZED-SINGLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-POSITIVE-SHORT-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LEAST-POSITIVE-SINGLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "LENGTH" :KIND :FUNCTION :LAMBDA-LIST "(sequence)" :DOCSTRING "Return an integer that is the length of SEQUENCE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_length.htm")
  (:NAME "LET" :KIND :SPECIAL-OPERATOR :DOCSTRING "LET ({(var [value]) | var}*) declaration* form*

During evaluation of the FORMS, bind the VARS to the result of evaluating the
VALUE forms. The variables are bound in parallel after all of the VALUES forms
have been evaluated." :ORIGIN :SBCL :CLHS-PAGE "Body/s_let_l.htm")
  (:NAME "LET*" :KIND :SPECIAL-OPERATOR :DOCSTRING "LET* ({(var [value]) | var}*) declaration* form*

Similar to LET, but the variables are bound sequentially, allowing each VALUE
form to reference any of the previous VARS." :ORIGIN :SBCL :CLHS-PAGE "Body/s_let_l.htm")
  (:NAME "LISP-IMPLEMENTATION-TYPE" :KIND :FUNCTION :LAMBDA-LIST "()" :ORIGIN :SBCL :CLHS-PAGE "Body/f_lisp_i.htm")
  (:NAME "LISP-IMPLEMENTATION-VERSION" :KIND :FUNCTION :LAMBDA-LIST "()" :ORIGIN :SBCL :CLHS-PAGE "Body/f_lisp_i.htm")
  (:NAME "LIST" :KIND :FUNCTION :LAMBDA-LIST "(&rest args)" :DOCSTRING "Construct and return a list containing the objects ARGS." :ORIGIN :SBCL :CLHS-PAGE "Body/a_list.htm")
  (:NAME "LIST" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_list.htm")
  (:NAME "LIST*" :KIND :FUNCTION :LAMBDA-LIST "(arg &rest others)" :DOCSTRING "Return a list of the arguments with last cons a dotted pair." :ORIGIN :SBCL :CLHS-PAGE "Body/f_list_.htm")
  (:NAME "LIST-ALL-PACKAGES" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return a list of all existing packages." :ORIGIN :SBCL :CLHS-PAGE "Body/f_list_a.htm")
  (:NAME "LIST-LENGTH" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return the length of LIST, or NIL if LIST is circular." :ORIGIN :SBCL :CLHS-PAGE "Body/f_list_l.htm")
  (:NAME "LISTEN" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-input*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_listen.htm")
  (:NAME "LISTP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a LIST, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_listp.htm")
  (:NAME "LOAD" :KIND :FUNCTION :LAMBDA-LIST "(filespec &key (verbose *load-verbose*) (print *load-print*) (if-does-not-exist :error) (external-format :default))" :DOCSTRING "Load the file given by FILESPEC into the Lisp environment, returning T on
success. The file type (a.k.a extension) is defaulted if missing. These
options are defined:

:IF-DOES-NOT-EXIST
    If :ERROR (the default), signal an error if the file can't be located.
    If NIL, simply return NIL (LOAD normally returns T.)

:VERBOSE
    If true, print a line describing each file loaded.

:PRINT
    If true, print information about loaded values.  When loading the
    source, the result of evaluating each top-level form is printed.

:EXTERNAL-FORMAT
    The external-format to use when opening the FILENAME. The default is
    :DEFAULT which uses the SB-EXT:*DEFAULT-SOURCE-EXTERNAL-FORMAT*." :ORIGIN :SBCL :CLHS-PAGE "Body/f_load.htm")
  (:NAME "LOAD-LOGICAL-PATHNAME-TRANSLATIONS" :KIND :FUNCTION :LAMBDA-LIST "(host)" :DOCSTRING "Reads logical pathname translations from SYS:SITE;HOST.TRANSLATIONS.NEWEST,
with HOST replaced by the supplied parameter. Returns T on success.

If HOST is already defined as logical pathname host, no file is loaded and NIL
is returned.

The file should contain a single form, suitable for use with
(SETF LOGICAL-PATHNAME-TRANSLATIONS).

Note: behaviour of this function is highly implementation dependent, and
historically it used to be a no-op in SBCL -- the current approach is somewhat
experimental and subject to change." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ld_log.htm")
  (:NAME "LOAD-TIME-VALUE" :KIND :SPECIAL-OPERATOR :DOCSTRING "Arrange for FORM to be evaluated at load-time and use the value produced as
if it were a constant. If READ-ONLY-P is non-NIL, then the resultant object is
guaranteed to never be modified, so it can be put in read-only storage." :ORIGIN :SBCL :CLHS-PAGE "Body/s_ld_tim.htm")
  (:NAME "LOCALLY" :KIND :SPECIAL-OPERATOR :DOCSTRING "LOCALLY declaration* form*

Sequentially evaluate the FORMS in a lexical environment where the
DECLARATIONs have effect. If LOCALLY is a top level form, then the
FORMs are also processed as top level forms." :ORIGIN :SBCL :CLHS-PAGE "Body/s_locall.htm")
  (:NAME "LOG" :KIND :FUNCTION :LAMBDA-LIST "(number &optional (base nil base-p))" :DOCSTRING "Return the logarithm of NUMBER in the base BASE, which defaults to e." :ORIGIN :SBCL :CLHS-PAGE "Body/f_log.htm")
  (:NAME "LOGAND" :KIND :FUNCTION :LAMBDA-LIST "(&rest integers)" :DOCSTRING "Return the bit-wise and of its arguments. Args must be integers." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGANDC1" :KIND :FUNCTION :LAMBDA-LIST "(integer1 integer2)" :DOCSTRING "Bitwise AND (LOGNOT INTEGER1) with INTEGER2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGANDC2" :KIND :FUNCTION :LAMBDA-LIST "(integer1 integer2)" :DOCSTRING "Bitwise AND INTEGER1 with (LOGNOT INTEGER2)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGBITP" :KIND :FUNCTION :LAMBDA-LIST "(index integer)" :DOCSTRING "Predicate returns T if bit index of integer is a 1." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logbtp.htm")
  (:NAME "LOGCOUNT" :KIND :FUNCTION :LAMBDA-LIST "(integer)" :DOCSTRING "Count the number of 1 bits if INTEGER is non-negative,
and the number of 0 bits if INTEGER is negative." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logcou.htm")
  (:NAME "LOGEQV" :KIND :FUNCTION :LAMBDA-LIST "(&rest integers)" :DOCSTRING "Return the bit-wise equivalence of its arguments. Args must be integers." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGICAL-PATHNAME" :KIND :FUNCTION :LAMBDA-LIST "(pathspec)" :DOCSTRING "Converts the pathspec argument to a logical-pathname and returns it." :ORIGIN :SBCL :CLHS-PAGE "Body/a_logica.htm")
  (:NAME "LOGICAL-PATHNAME" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_logica.htm")
  (:NAME "LOGICAL-PATHNAME-TRANSLATIONS" :KIND :FUNCTION :LAMBDA-LIST "(host)" :DOCSTRING "Return the (logical) host object argument's list of translations." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logica.htm")
  (:NAME "LOGIOR" :KIND :FUNCTION :LAMBDA-LIST "(&rest integers)" :DOCSTRING "Return the bit-wise or of its arguments. Args must be integers." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGNAND" :KIND :FUNCTION :LAMBDA-LIST "(integer1 integer2)" :DOCSTRING "Complement the logical AND of INTEGER1 and INTEGER2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGNOR" :KIND :FUNCTION :LAMBDA-LIST "(integer1 integer2)" :DOCSTRING "Complement the logical OR of INTEGER1 and INTEGER2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGNOT" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Return the bit-wise logical not of integer." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGORC1" :KIND :FUNCTION :LAMBDA-LIST "(integer1 integer2)" :DOCSTRING "Bitwise OR (LOGNOT INTEGER1) with INTEGER2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGORC2" :KIND :FUNCTION :LAMBDA-LIST "(integer1 integer2)" :DOCSTRING "Bitwise OR INTEGER1 with (LOGNOT INTEGER2)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LOGTEST" :KIND :FUNCTION :LAMBDA-LIST "(integer1 integer2)" :DOCSTRING "Predicate which returns T if logand of integer1 and integer2 is not zero." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logtes.htm")
  (:NAME "LOGXOR" :KIND :FUNCTION :LAMBDA-LIST "(&rest integers)" :DOCSTRING "Return the bit-wise exclusive or of its arguments. Args must be integers." :ORIGIN :SBCL :CLHS-PAGE "Body/f_logand.htm")
  (:NAME "LONG-FLOAT" :KIND :TYPE :ORIGIN :SBCL :CLHS-PAGE "Body/t_short_.htm")
  (:NAME "LONG-FLOAT-EPSILON" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_short_.htm")
  (:NAME "LONG-FLOAT-NEGATIVE-EPSILON" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_short_.htm")
  (:NAME "LONG-SITE-NAME" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return a string with the long form of the site name, or NIL if not known." :ORIGIN :SBCL :CLHS-PAGE "Body/f_short_.htm")
  (:NAME "LOOP" :KIND :MACRO :LAMBDA-LIST "(&rest keywords-and-forms)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_loop.htm")
  (:NAME "LOOP-FINISH" :KIND :MACRO :LAMBDA-LIST "()" :DOCSTRING "Cause the iteration to terminate \"normally\", the same as implicit
termination by an iteration driving clause, or by use of WHILE or
UNTIL -- the epilogue code (if any) will be run, and any implicitly
collected result will be returned as the value of the LOOP." :ORIGIN :SBCL :CLHS-PAGE "Body/m_loop_f.htm")
  (:NAME "LOWER-CASE-P" :KIND :FUNCTION :LAMBDA-LIST "(char)" :DOCSTRING "The argument must be a character object; LOWER-CASE-P returns T if the
argument is a lower-case character, NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_upper_.htm")
  (:NAME "MACHINE-INSTANCE" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return a string giving the name of the local machine." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mach_i.htm")
  (:NAME "MACHINE-TYPE" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return a string describing the type of the local machine." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mach_t.htm")
  (:NAME "MACHINE-VERSION" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return a string describing the version of the computer hardware we
are running on, or NIL if we can't find any useful information." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mach_v.htm")
  (:NAME "MACRO-FUNCTION" :KIND :FUNCTION :LAMBDA-LIST "(symbol &optional env)" :DOCSTRING "If SYMBOL names a macro in ENV, returns the expansion function,
else returns NIL. If ENV is unspecified or NIL, use the global environment
only." :ORIGIN :SBCL :CLHS-PAGE "Body/f_macro_.htm")
  (:NAME "MACROEXPAND" :KIND :FUNCTION :LAMBDA-LIST "(form &optional env)" :DOCSTRING "Repetitively call MACROEXPAND-1 until the form can no longer be expanded.
Returns the final resultant form, and T if it was expanded. ENV is the
lexical environment to expand in, or NIL (the default) for the null
environment." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mexp_.htm")
  (:NAME "MACROEXPAND-1" :KIND :FUNCTION :LAMBDA-LIST "(form &optional env)" :DOCSTRING "If form is a macro (or symbol macro), expand it once. Return two values,
the expanded form and a T-or-NIL flag indicating whether the form was, in
fact, a macro. ENV is the lexical environment to expand in, which defaults
to the null environment." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mexp_.htm")
  (:NAME "MACROLET" :KIND :SPECIAL-OPERATOR :DOCSTRING "MACROLET ({(name lambda-list form*)}*) body-form*

Evaluate BODY-FORMs in an environment with the specified local
macros defined. NAME is the local macro name, LAMBDA-LIST is a
DEFMACRO style destructuring lambda list, and the FORMs evaluate to
the expansion." :ORIGIN :SBCL :CLHS-PAGE "Body/s_flet_.htm")
  (:NAME "MAKE-ARRAY" :KIND :FUNCTION :LAMBDA-LIST "(dimensions &rest args &key (element-type t) initial-element initial-contents adjustable fill-pointer displaced-to displaced-index-offset)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_ar.htm")
  (:NAME "MAKE-BROADCAST-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(&rest streams)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_bro.htm")
  (:NAME "MAKE-CONCATENATED-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(&rest streams)" :DOCSTRING "Return a stream which takes its input from each of the streams in turn,
going on to the next at EOF." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_con.htm")
  (:NAME "MAKE-CONDITION" :KIND :FUNCTION :LAMBDA-LIST "(type &rest initargs)" :DOCSTRING "Make an instance of a condition object using the specified initargs." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_cnd.htm")
  (:NAME "MAKE-DISPATCH-MACRO-CHARACTER" :KIND :FUNCTION :LAMBDA-LIST "(char &optional (non-terminating-p nil) (rt *readtable*))" :DOCSTRING "Cause CHAR to become a dispatching macro character in readtable (which
defaults to the current readtable). If NON-TERMINATING-P, the char will
be non-terminating." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_dis.htm")
  (:NAME "MAKE-ECHO-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(input-stream output-stream)" :DOCSTRING "Return a bidirectional stream which gets its input from INPUT-STREAM and
sends its output to OUTPUT-STREAM. In addition, all input is echoed to
the output stream." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_ech.htm")
  (:NAME "MAKE-HASH-TABLE" :KIND :FUNCTION :LAMBDA-LIST "(&key (test 'eql) (size 7) (rehash-size 1.5) (rehash-threshold 1) (hash-function nil user-hashfun-p) (weakness nil) (synchronized))" :DOCSTRING "Create and return a new hash table. The keywords are as follows:

- :TEST

    Determines how keys are compared. Must be a designator for one of
    the standard hash table tests, or a hash table test defined
    using SB-EXT:DEFINE-HASH-TABLE-TEST. Additionally, when an
    explicit HASH-FUNCTION is provided (see below), any two argument
    equivalence predicate can be used as the TEST.

- :SIZE

    A hint as to how many elements will be put in this hash table.

- :REHASH-SIZE

    Indicates how to expand the table when it fills up. If an
    integer, add space for that many elements. If a floating point
    number (which must be greater than 1.0), multiply the size by
    that amount.

- :REHASH-THRESHOLD

    Indicates how dense the table can become before forcing a
    rehash. Can be any positive number <=1, with density approaching
    zero as the threshold approaches 0. Density 1 means an average
    of one entry per bucket.

- :HASH-FUNCTION

    If unsupplied, a hash function based on the TEST argument is
    used, which then must be one of the standardized hash table test
    functions, or one for which a default hash function has been
    defined using SB-EXT:DEFINE-HASH-TABLE-TEST. If HASH-FUNCTION is
    specified, the TEST argument can be any two argument predicate
    consistent with it. The HASH-FUNCTION is expected to return a
    non-negative fixnum hash code. If TEST is neither standard nor
    defined by DEFINE-HASH-TABLE-TEST, then the HASH-FUNCTION must
    be specified.

- :WEAKNESS

    When :WEAKNESS is not NIL, garbage collection may remove entries
    from the hash table. The value of :WEAKNESS specifies how the
    presence of a key or value in the hash table preserves their
    entries from garbage collection.

    Valid values are:

    - :KEY means that the key of an entry must be live to guarantee
      that the entry is preserved.

    - :VALUE means that the value of an entry must be live to
      guarantee that the entry is preserved.

    - :KEY-AND-VALUE means that both the key and the value must be
      live to guarantee that the entry is preserved.

    - :KEY-OR-VALUE means that either the key or the value must be
      live to guarantee that the entry is preserved.

    - NIL (the default) means that entries are always preserved.

- :SYNCHRONIZED

    If NIL (the default), the hash-table may have multiple
    concurrent readers, but results are undefined if a thread writes
    to the hash-table concurrently with another reader or writer. If
    T, all concurrent accesses are safe, but note that CLHS
    3.6 (Traversal Rules and Side Effects) remains in force. See
    also: SB-EXT:WITH-LOCKED-HASH-TABLE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_has.htm")
  (:NAME "MAKE-INSTANCE" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(class &rest initargs &key &allow-other-keys)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_ins.htm")
  (:NAME "MAKE-INSTANCES-OBSOLETE" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(class)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_i_1.htm")
  (:NAME "MAKE-LIST" :KIND :FUNCTION :LAMBDA-LIST "(size &key initial-element)" :DOCSTRING "Construct and return a list with SIZE elements each set to INITIAL-ELEMENT." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_lis.htm")
  (:NAME "MAKE-LOAD-FORM" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(object &optional environment)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_ld_.htm")
  (:NAME "MAKE-LOAD-FORM-SAVING-SLOTS" :KIND :FUNCTION :LAMBDA-LIST "(object &key (slot-names nil slot-names-p) environment)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_l_1.htm")
  (:NAME "MAKE-METHOD" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/m_call_m.htm")
  (:NAME "MAKE-PACKAGE" :KIND :FUNCTION :LAMBDA-LIST "(name &key (use 'nil) nicknames (internal-symbols 10) (external-symbols 10))" :DOCSTRING "Make a new package having the specified NAME, NICKNAMES, and USE
list. :INTERNAL-SYMBOLS and :EXTERNAL-SYMBOLS are estimates for the number of
internal and external symbols which will ultimately be present in the package.
The default value of USE is implementation-dependent, and in this
implementation it is NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_pkg.htm")
  (:NAME "MAKE-PATHNAME" :KIND :FUNCTION :LAMBDA-LIST "(&key host (device nil devp) (directory nil dirp) (name nil namep) (type nil typep) (version nil versionp) defaults (case :local))" :DOCSTRING "Makes a new pathname from the component arguments. Note that host is
a host-structure or string." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_pn.htm")
  (:NAME "MAKE-RANDOM-STATE" :KIND :FUNCTION :LAMBDA-LIST "(&optional state)" :DOCSTRING "Make a random state object. The optional STATE argument specifies a seed
for deterministic pseudo-random number generation.

As per the Common Lisp standard,
- If STATE is NIL or not supplied, return a copy of the default
  *RANDOM-STATE*.
- If STATE is a random state, return a copy of it.
- If STATE is T, return a randomly initialized state (using operating-system
  provided randomness where available, otherwise a poor substitute based on
  internal time and PID).

See SB-EXT:SEED-RANDOM-STATE for a SBCL extension to this functionality." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_rnd.htm")
  (:NAME "MAKE-SEQUENCE" :KIND :FUNCTION :LAMBDA-LIST "(result-type length &key (initial-element nil iep))" :DOCSTRING "Return a sequence of the given RESULT-TYPE and LENGTH, with
elements initialized to INITIAL-ELEMENT." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_seq.htm")
  (:NAME "MAKE-STRING" :KIND :FUNCTION :LAMBDA-LIST "(count &key (element-type 'character) (initial-element nil iep))" :DOCSTRING "Given a character count and an optional fill character, makes and returns a
new string COUNT long filled with the fill character." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_stg.htm")
  (:NAME "MAKE-STRING-INPUT-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(string &optional (start 0) end)" :DOCSTRING "Return an input stream which will supply the characters of STRING between
START and END in order." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_s_1.htm")
  (:NAME "MAKE-STRING-OUTPUT-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(&key (element-type 'character))" :DOCSTRING "Return an output stream which will accumulate all output given it for the
benefit of the function GET-OUTPUT-STREAM-STRING." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_s_2.htm")
  (:NAME "MAKE-SYMBOL" :KIND :FUNCTION :LAMBDA-LIST "(string)" :DOCSTRING "Make and return a new symbol with the STRING as its print name." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_sym.htm")
  (:NAME "MAKE-SYNONYM-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(symbol)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_syn.htm")
  (:NAME "MAKE-TWO-WAY-STREAM" :KIND :FUNCTION :LAMBDA-LIST "(input-stream output-stream)" :DOCSTRING "Return a bidirectional stream which gets its input from INPUT-STREAM and
sends its output to OUTPUT-STREAM." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mk_two.htm")
  (:NAME "MAKUNBOUND" :KIND :FUNCTION :LAMBDA-LIST "(symbol)" :DOCSTRING "Make SYMBOL unbound, removing any value it may currently have." :ORIGIN :SBCL :CLHS-PAGE "Body/f_makunb.htm")
  (:NAME "MAP" :KIND :FUNCTION :LAMBDA-LIST "(result-type function first-sequence &rest more-sequences)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_map.htm")
  (:NAME "MAP-INTO" :KIND :FUNCTION :LAMBDA-LIST "(result-sequence function &rest sequences)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_map_in.htm")
  (:NAME "MAPC" :KIND :FUNCTION :LAMBDA-LIST "(function list &rest more-lists)" :DOCSTRING "Apply FUNCTION to successive tuples of elements of LIST and MORE-LISTS.
Return LIST." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mapc_.htm")
  (:NAME "MAPCAN" :KIND :FUNCTION :LAMBDA-LIST "(function list &rest more-lists)" :DOCSTRING "Apply FUNCTION to successive tuples of elements of LIST and MORE-LISTS.
Return NCONC of FUNCTION return values." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mapc_.htm")
  (:NAME "MAPCAR" :KIND :FUNCTION :LAMBDA-LIST "(function list &rest more-lists)" :DOCSTRING "Apply FUNCTION to successive tuples of elements of LIST and MORE-LISTS.
Return list of FUNCTION return values." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mapc_.htm")
  (:NAME "MAPCON" :KIND :FUNCTION :LAMBDA-LIST "(function list &rest more-lists)" :DOCSTRING "Apply FUNCTION to successive tuples of CDRs of LIST and MORE-LISTS.
Return NCONC of results." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mapc_.htm")
  (:NAME "MAPHASH" :KIND :FUNCTION :LAMBDA-LIST "(function-designator hash-table)" :DOCSTRING "For each entry in HASH-TABLE, call the designated two-argument function on
the key and value of the entry. Return NIL.

Consequences are undefined if HASH-TABLE is mutated during the call to
MAPHASH, except for changing or removing elements corresponding to the
current key. The applies to all threads, not just the current one --
even for synchronized hash-tables. If the table may be mutated by
another thread during iteration, use eg. SB-EXT:WITH-LOCKED-HASH-TABLE
to protect the MAPHASH call." :ORIGIN :SBCL :CLHS-PAGE "Body/f_maphas.htm")
  (:NAME "MAPL" :KIND :FUNCTION :LAMBDA-LIST "(function list &rest more-lists)" :DOCSTRING "Apply FUNCTION to successive tuples of CDRs of LIST and MORE-LISTS.
Return LIST." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mapc_.htm")
  (:NAME "MAPLIST" :KIND :FUNCTION :LAMBDA-LIST "(function list &rest more-lists)" :DOCSTRING "Apply FUNCTION to successive tuples of CDRs of LIST and MORE-LISTS.
Return list of results." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mapc_.htm")
  (:NAME "MASK-FIELD" :KIND :FUNCTION :LAMBDA-LIST "(bytespec integer)" :DOCSTRING "Extract the specified byte from integer,  but do not right justify result." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mask_f.htm")
  (:NAME "MAX" :KIND :FUNCTION :LAMBDA-LIST "(number &rest more-numbers)" :DOCSTRING "Return the greatest of its arguments; among EQUALP greatest, return
the first." :ORIGIN :SBCL :CLHS-PAGE "Body/f_max_m.htm")
  (:NAME "MEMBER" :KIND :FUNCTION :LAMBDA-LIST "(item list &key key (test nil testp) (test-not nil notp))" :DOCSTRING "Return the tail of LIST beginning with first element satisfying EQLity,
:TEST, or :TEST-NOT with the given ITEM." :ORIGIN :SBCL :CLHS-PAGE "Body/a_member.htm")
  (:NAME "MEMBER-IF" :KIND :FUNCTION :LAMBDA-LIST "(test list &key key)" :DOCSTRING "Return tail of LIST beginning with first element satisfying TEST." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mem_m.htm")
  (:NAME "MEMBER-IF-NOT" :KIND :FUNCTION :LAMBDA-LIST "(test list &key key)" :DOCSTRING "Return tail of LIST beginning with first element not satisfying TEST." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mem_m.htm")
  (:NAME "MERGE" :KIND :FUNCTION :LAMBDA-LIST "(result-type sequence1 sequence2 predicate &key key)" :DOCSTRING "Merge the sequences SEQUENCE1 and SEQUENCE2 destructively into a
sequence of type RESULT-TYPE using PREDICATE to order the elements." :ORIGIN :SBCL :CLHS-PAGE "Body/f_merge.htm")
  (:NAME "MERGE-PATHNAMES" :KIND :FUNCTION :LAMBDA-LIST "(pathname &optional (defaults *default-pathname-defaults*) (default-version :newest))" :DOCSTRING "Construct a filled in pathname by completing the unspecified components
from the defaults." :ORIGIN :SBCL :CLHS-PAGE "Body/f_merge_.htm")
  (:NAME "METHOD" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_method.htm")
  (:NAME "METHOD-COMBINATION" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_method.htm")
  (:NAME "METHOD-COMBINATION-ERROR" :KIND :FUNCTION :LAMBDA-LIST "(format-control &rest format-arguments)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_meth_1.htm")
  (:NAME "METHOD-QUALIFIERS" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(m)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_method.htm")
  (:NAME "MIN" :KIND :FUNCTION :LAMBDA-LIST "(number &rest more-numbers)" :DOCSTRING "Return the least of its arguments; among EQUALP least, return
the first." :ORIGIN :SBCL :CLHS-PAGE "Body/f_max_m.htm")
  (:NAME "MINUSP" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Is this real number strictly negative?" :ORIGIN :SBCL :CLHS-PAGE "Body/f_minusp.htm")
  (:NAME "MISMATCH" :KIND :FUNCTION :LAMBDA-LIST "(sequence1 sequence2 &rest args &key from-end (test (function eql) test-p) (test-not nil test-not-p) (start1 0) (end1 nil) (start2 0) (end2 nil) (key nil))" :DOCSTRING "The specified subsequences of SEQUENCE1 and SEQUENCE2 are compared
element-wise. If they are of equal length and match in every element, the
result is NIL. Otherwise, the result is a non-negative integer, the index
within SEQUENCE1 of the leftmost position at which they fail to match; or,
if one is shorter than and a matching prefix of the other, the index within
SEQUENCE1 beyond the last position tested is returned. If a non-NIL
:FROM-END argument is given, then one plus the index of the rightmost
position in which the sequences differ is returned." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mismat.htm")
  (:NAME "MOD" :KIND :FUNCTION :LAMBDA-LIST "(number divisor)" :DOCSTRING "Return second result of FLOOR." :ORIGIN :SBCL :CLHS-PAGE "Body/a_mod.htm")
  (:NAME "MOD" :KIND :TYPE :ORIGIN :SBCL :CLHS-PAGE "Body/a_mod.htm")
  (:NAME "MOST-NEGATIVE-DOUBLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "MOST-NEGATIVE-FIXNUM" :KIND :CONSTANT :DOCSTRING "the fixnum closest in value to negative infinity" :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_p.htm")
  (:NAME "MOST-NEGATIVE-LONG-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "MOST-NEGATIVE-SHORT-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "MOST-NEGATIVE-SINGLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "MOST-POSITIVE-DOUBLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "MOST-POSITIVE-FIXNUM" :KIND :CONSTANT :DOCSTRING "the fixnum closest in value to positive infinity" :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_p.htm")
  (:NAME "MOST-POSITIVE-LONG-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "MOST-POSITIVE-SHORT-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "MOST-POSITIVE-SINGLE-FLOAT" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_most_1.htm")
  (:NAME "MUFFLE-WARNING" :KIND :FUNCTION :LAMBDA-LIST "(&optional condition)" :DOCSTRING "Transfer control to a restart named MUFFLE-WARNING, signalling a
CONTROL-ERROR if none exists." :ORIGIN :SBCL :CLHS-PAGE "Body/a_muffle.htm")
  (:NAME "MULTIPLE-VALUE-BIND" :KIND :MACRO :LAMBDA-LIST "(vars value-form &body body)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_multip.htm")
  (:NAME "MULTIPLE-VALUE-CALL" :KIND :SPECIAL-OPERATOR :DOCSTRING "MULTIPLE-VALUE-CALL function values-form*

Call FUNCTION, passing all the values of each VALUES-FORM as arguments,
values from the first VALUES-FORM making up the first argument, etc." :ORIGIN :SBCL :CLHS-PAGE "Body/s_multip.htm")
  (:NAME "MULTIPLE-VALUE-LIST" :KIND :MACRO :LAMBDA-LIST "(value-form)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_mult_1.htm")
  (:NAME "MULTIPLE-VALUE-PROG1" :KIND :SPECIAL-OPERATOR :DOCSTRING "MULTIPLE-VALUE-PROG1 values-form form*

Evaluate VALUES-FORM and then the FORMS, but return all the values of
VALUES-FORM." :ORIGIN :SBCL :CLHS-PAGE "Body/s_mult_1.htm")
  (:NAME "MULTIPLE-VALUE-SETQ" :KIND :MACRO :LAMBDA-LIST "(vars value-form)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_mult_2.htm")
  (:NAME "MULTIPLE-VALUES-LIMIT" :KIND :CONSTANT :DOCSTRING "The exclusive upper bound on the number of multiple VALUES that you can
return." :ORIGIN :SBCL :CLHS-PAGE "Body/v_multip.htm")
  (:NAME "NAME-CHAR" :KIND :FUNCTION :LAMBDA-LIST "(name)" :DOCSTRING "Given an argument acceptable to STRING, NAME-CHAR returns a character whose
name is that string, if one exists. Otherwise, NIL is returned." :ORIGIN :SBCL :CLHS-PAGE "Body/f_name_c.htm")
  (:NAME "NAMESTRING" :KIND :FUNCTION :LAMBDA-LIST "(pathname)" :DOCSTRING "Construct the full (name)string form PATHNAME." :ORIGIN :SBCL :CLHS-PAGE "Body/f_namest.htm")
  (:NAME "NBUTLAST" :KIND :FUNCTION :LAMBDA-LIST "(list &optional (n 1))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_butlas.htm")
  (:NAME "NCONC" :KIND :FUNCTION :LAMBDA-LIST "(&rest lists)" :DOCSTRING "Concatenates the lists given as arguments (by changing them)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_nconc.htm")
  (:NAME "NEXT-METHOD-P" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/f_next_m.htm")
  (:NAME "NIL" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/a_nil.htm")
  (:NAME "NIL" :KIND :TYPE :ORIGIN :SBCL :CLHS-PAGE "Body/a_nil.htm")
  (:NAME "NINTERSECTION" :KIND :FUNCTION :LAMBDA-LIST "(list1 list2 &key key (test nil testp) (test-not nil notp))" :DOCSTRING "Destructively return the intersection of LIST1 and LIST2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_isec_.htm")
  (:NAME "NINTH" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return the 9th object in a list or NIL if there is no 9th object." :ORIGIN :SBCL :CLHS-PAGE "Body/f_firstc.htm")
  (:NAME "NO-APPLICABLE-METHOD" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(generic-function &rest args)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_no_app.htm")
  (:NAME "NO-NEXT-METHOD" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(generic-function method &rest args)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_no_nex.htm")
  (:NAME "NOT" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return T if X is NIL, otherwise return NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/a_not.htm")
  (:NAME "NOTANY" :KIND :FUNCTION :LAMBDA-LIST "(pred first-seq &rest more-seqs)" :DOCSTRING "Apply PREDICATE to the 0-indexed elements of the sequences, then
possibly to those with index 1, and so on. Return NIL as soon
as any invocation of PREDICATE returns a non-NIL value, or T if the end
of any sequence is reached." :ORIGIN :SBCL :CLHS-PAGE "Body/f_everyc.htm")
  (:NAME "NOTEVERY" :KIND :FUNCTION :LAMBDA-LIST "(pred first-seq &rest more-seqs)" :DOCSTRING "Apply PREDICATE to 0-indexed elements of the sequences, then
possibly to those with index 1, and so on. Return T as soon
as any invocation of PREDICATE returns NIL, or NIL if every invocation
is non-NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_everyc.htm")
  (:NAME "NOTINLINE" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_inline.htm")
  (:NAME "NRECONC" :KIND :FUNCTION :LAMBDA-LIST "(x y)" :DOCSTRING "Return (NCONC (NREVERSE X) Y)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_revapp.htm")
  (:NAME "NREVERSE" :KIND :FUNCTION :LAMBDA-LIST "(sequence)" :DOCSTRING "Return a sequence of the same elements in reverse order; the argument
is destroyed." :ORIGIN :SBCL :CLHS-PAGE "Body/f_revers.htm")
  (:NAME "NSET-DIFFERENCE" :KIND :FUNCTION :LAMBDA-LIST "(list1 list2 &key key (test nil testp) (test-not nil notp))" :DOCSTRING "Destructively return the elements of LIST1 which are not in LIST2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set_di.htm")
  (:NAME "NSET-EXCLUSIVE-OR" :KIND :FUNCTION :LAMBDA-LIST "(list1 list2 &key key (test (function eql) testp) (test-not (function eql) notp))" :DOCSTRING "Destructively return a list with elements which appear but once in LIST1
and LIST2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set_ex.htm")
  (:NAME "NSTRING-CAPITALIZE" :KIND :FUNCTION :LAMBDA-LIST "(string &key (start 0) end)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_stg_up.htm")
  (:NAME "NSTRING-DOWNCASE" :KIND :FUNCTION :LAMBDA-LIST "(string &key (start 0) end)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_stg_up.htm")
  (:NAME "NSTRING-UPCASE" :KIND :FUNCTION :LAMBDA-LIST "(string &key (start 0) end)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_stg_up.htm")
  (:NAME "NSUBLIS" :KIND :FUNCTION :LAMBDA-LIST "(alist tree &key key (test (function eql) testp) (test-not (function eql) notp))" :DOCSTRING "Substitute from ALIST into TREE destructively." :ORIGIN :SBCL :CLHS-PAGE "Body/f_sublis.htm")
  (:NAME "NSUBST" :KIND :FUNCTION :LAMBDA-LIST "(new old tree &key key (test (function eql) testp) (test-not (function eql) notp))" :DOCSTRING "Substitute NEW for subtrees matching OLD." :ORIGIN :SBCL :CLHS-PAGE "Body/f_substc.htm")
  (:NAME "NSUBST-IF" :KIND :FUNCTION :LAMBDA-LIST "(new test tree &key key)" :DOCSTRING "Substitute NEW for subtrees of TREE for which TEST is true." :ORIGIN :SBCL :CLHS-PAGE "Body/f_substc.htm")
  (:NAME "NSUBST-IF-NOT" :KIND :FUNCTION :LAMBDA-LIST "(new test tree &key key)" :DOCSTRING "Substitute NEW for subtrees of TREE for which TEST is false." :ORIGIN :SBCL :CLHS-PAGE "Body/f_substc.htm")
  (:NAME "NSUBSTITUTE" :KIND :FUNCTION :LAMBDA-LIST "(new old sequence &rest args &key from-end (test (function eql) test-p) (test-not nil test-not-p) (end nil) (count nil) (key nil) (start 0))" :DOCSTRING "Return a sequence of the same kind as SEQUENCE with the same elements
except that all elements equal to OLD are replaced with NEW. SEQUENCE
may be destructively modified." :ORIGIN :SBCL :CLHS-PAGE "Body/f_sbs_s.htm")
  (:NAME "NSUBSTITUTE-IF" :KIND :FUNCTION :LAMBDA-LIST "(new predicate sequence &rest args &key from-end (start 0) (end nil) (count nil) (key nil))" :DOCSTRING "Return a sequence of the same kind as SEQUENCE with the same elements
except that all elements satisfying PREDICATE are replaced with NEW.
SEQUENCE may be destructively modified." :ORIGIN :SBCL :CLHS-PAGE "Body/f_sbs_s.htm")
  (:NAME "NSUBSTITUTE-IF-NOT" :KIND :FUNCTION :LAMBDA-LIST "(new predicate sequence &rest args &key from-end (start 0) (end nil) (count nil) (key nil))" :DOCSTRING "Return a sequence of the same kind as SEQUENCE with the same elements
except that all elements not satisfying PREDICATE are replaced with NEW.
SEQUENCE may be destructively modified." :ORIGIN :SBCL :CLHS-PAGE "Body/f_sbs_s.htm")
  (:NAME "NTH" :KIND :FUNCTION :LAMBDA-LIST "(n list)" :DOCSTRING "Return the nth object in a list where the car is the zero-th element." :ORIGIN :SBCL :CLHS-PAGE "Body/f_nth.htm")
  (:NAME "NTH-VALUE" :KIND :MACRO :LAMBDA-LIST "(n form)" :DOCSTRING "Evaluate FORM and return the Nth value (zero based)
without consing a temporary list of values." :ORIGIN :SBCL :CLHS-PAGE "Body/m_nth_va.htm")
  (:NAME "NTHCDR" :KIND :FUNCTION :LAMBDA-LIST "(n list)" :DOCSTRING "Performs the cdr function n times on a list." :ORIGIN :SBCL :CLHS-PAGE "Body/f_nthcdr.htm")
  (:NAME "NULL" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a NULL, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/a_null.htm")
  (:NAME "NULL" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_null.htm")
  (:NAME "NUMBER" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_number.htm")
  (:NAME "NUMBERP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a NUMBER, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_nump.htm")
  (:NAME "NUMERATOR" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Return the numerator of NUMBER, which must be rational." :ORIGIN :SBCL :CLHS-PAGE "Body/f_numera.htm")
  (:NAME "NUNION" :KIND :FUNCTION :LAMBDA-LIST "(list1 list2 &key key (test nil testp) (test-not nil notp))" :DOCSTRING "Destructively return the union of LIST1 and LIST2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_unionc.htm")
  (:NAME "ODDP" :KIND :FUNCTION :LAMBDA-LIST "(integer)" :DOCSTRING "Is this integer odd?" :ORIGIN :SBCL :CLHS-PAGE "Body/f_evenpc.htm")
  (:NAME "OPEN" :KIND :FUNCTION :LAMBDA-LIST "(filename &key (direction :input) (element-type 'character) (if-exists nil if-exists-given) (if-does-not-exist nil if-does-not-exist-given) (external-format :default) (class 'fd-stream) (auto-close t))" :DOCSTRING "Return a stream which reads from or writes to FILENAME.
Defined keywords:
 :DIRECTION - one of :INPUT, :OUTPUT, :IO, or :PROBE
 :ELEMENT-TYPE - the type of object to read or write, default CHARACTER
 :IF-EXISTS - one of :ERROR, :NEW-VERSION, :RENAME, :RENAME-AND-DELETE,
                     :OVERWRITE, :APPEND, :SUPERSEDE or NIL
 :IF-DOES-NOT-EXIST - one of :ERROR, :CREATE or NIL
See the manual for details." :ORIGIN :SBCL :CLHS-PAGE "Body/f_open.htm")
  (:NAME "OPEN-STREAM-P" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(stream)" :DOCSTRING "Return true if STREAM is not closed. A default method is provided
by class FUNDAMENTAL-STREAM which returns true if CLOSE has not been
called on the stream." :ORIGIN :SBCL :CLHS-PAGE "Body/f_open_s.htm")
  (:NAME "OPTIMIZE" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_optimi.htm")
  (:NAME "OR" :KIND :MACRO :LAMBDA-LIST "(&rest forms)" :ORIGIN :SBCL :CLHS-PAGE "Body/a_or.htm")
  (:NAME "OTHERWISE" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/m_case_.htm")
  (:NAME "OUTPUT-STREAM-P" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(stream)" :DOCSTRING "Can STREAM perform output operations?" :ORIGIN :SBCL :CLHS-PAGE "Body/f_in_stm.htm")
  (:NAME "PACKAGE" :KIND :CLASS :DOCSTRING "the standard structure for the description of a package" :ORIGIN :SBCL :CLHS-PAGE "Body/t_pkg.htm")
  (:NAME "PACKAGE-ERROR" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_pkg_er.htm")
  (:NAME "PACKAGE-ERROR-PACKAGE" :KIND :FUNCTION :LAMBDA-LIST "(condition)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pkg_er.htm")
  (:NAME "PACKAGE-NAME" :KIND :FUNCTION :LAMBDA-LIST "(package-designator)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pkg_na.htm")
  (:NAME "PACKAGE-NICKNAMES" :KIND :FUNCTION :LAMBDA-LIST "(package-designator)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pkg_ni.htm")
  (:NAME "PACKAGE-SHADOWING-SYMBOLS" :KIND :FUNCTION :LAMBDA-LIST "(package-designator)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pkg_sh.htm")
  (:NAME "PACKAGE-USE-LIST" :KIND :FUNCTION :LAMBDA-LIST "(package-designator)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pkg_us.htm")
  (:NAME "PACKAGE-USED-BY-LIST" :KIND :FUNCTION :LAMBDA-LIST "(package-designator)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pkg__1.htm")
  (:NAME "PACKAGEP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pkgp.htm")
  (:NAME "PAIRLIS" :KIND :FUNCTION :LAMBDA-LIST "(keys data &optional (alist 'nil))" :DOCSTRING "Construct an association list from KEYS and DATA (adding to ALIST)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_pairli.htm")
  (:NAME "PARSE-ERROR" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_parse_.htm")
  (:NAME "PARSE-INTEGER" :KIND :FUNCTION :LAMBDA-LIST "(string &key (start 0) end (radix 10) junk-allowed)" :DOCSTRING "Examine the substring of string delimited by start and end
(default to the beginning and end of the string)  It skips over
whitespace characters and then tries to parse an integer. The
radix parameter must be between 2 and 36." :ORIGIN :SBCL :CLHS-PAGE "Body/f_parse_.htm")
  (:NAME "PARSE-NAMESTRING" :KIND :FUNCTION :LAMBDA-LIST "(thing &optional host (defaults *default-pathname-defaults*) &key (start 0) end junk-allowed)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pars_1.htm")
  (:NAME "PATHNAME" :KIND :FUNCTION :LAMBDA-LIST "(pathspec)" :DOCSTRING "Convert PATHSPEC (a pathname designator) into a pathname." :ORIGIN :SBCL :CLHS-PAGE "Body/a_pn.htm")
  (:NAME "PATHNAME" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_pn.htm")
  (:NAME "PATHNAME-DEVICE" :KIND :FUNCTION :LAMBDA-LIST "(pathname &key (case :local))" :DOCSTRING "Return PATHNAME's device." :ORIGIN :SBCL :CLHS-PAGE "Body/f_pn_hos.htm")
  (:NAME "PATHNAME-DIRECTORY" :KIND :FUNCTION :LAMBDA-LIST "(pathname &key (case :local))" :DOCSTRING "Return PATHNAME's directory." :ORIGIN :SBCL :CLHS-PAGE "Body/f_pn_hos.htm")
  (:NAME "PATHNAME-HOST" :KIND :FUNCTION :LAMBDA-LIST "(pathname &key (case :local))" :DOCSTRING "Return PATHNAME's host." :ORIGIN :SBCL :CLHS-PAGE "Body/f_pn_hos.htm")
  (:NAME "PATHNAME-MATCH-P" :KIND :FUNCTION :LAMBDA-LIST "(in-pathname in-wildname)" :DOCSTRING "Pathname matches the wildname template?" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pn_mat.htm")
  (:NAME "PATHNAME-NAME" :KIND :FUNCTION :LAMBDA-LIST "(pathname &key (case :local))" :DOCSTRING "Return PATHNAME's name." :ORIGIN :SBCL :CLHS-PAGE "Body/f_pn_hos.htm")
  (:NAME "PATHNAME-TYPE" :KIND :FUNCTION :LAMBDA-LIST "(pathname &key (case :local))" :DOCSTRING "Return PATHNAME's type." :ORIGIN :SBCL :CLHS-PAGE "Body/f_pn_hos.htm")
  (:NAME "PATHNAME-VERSION" :KIND :FUNCTION :LAMBDA-LIST "(pathname)" :DOCSTRING "Return PATHNAME's version." :ORIGIN :SBCL :CLHS-PAGE "Body/f_pn_hos.htm")
  (:NAME "PATHNAMEP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pnp.htm")
  (:NAME "PEEK-CHAR" :KIND :FUNCTION :LAMBDA-LIST "(&optional (peek-type nil) (stream *standard-input*) (eof-error-p t) eof-value recursive-p)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_peek_c.htm")
  (:NAME "PHASE" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Return the angle part of the polar representation of a complex number.
For complex numbers, this is (atan (imagpart number) (realpart number)).
For non-complex positive numbers, this is 0. For non-complex negative
numbers this is PI." :ORIGIN :SBCL :CLHS-PAGE "Body/f_phase.htm")
  (:NAME "PI" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_pi.htm")
  (:NAME "PLUSP" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Is this real number strictly positive?" :ORIGIN :SBCL :CLHS-PAGE "Body/f_minusp.htm")
  (:NAME "POP" :KIND :MACRO :LAMBDA-LIST "(place)" :DOCSTRING "The argument is a location holding a list. Pops one item off the front
of the list and returns it." :ORIGIN :SBCL :CLHS-PAGE "Body/m_pop.htm")
  (:NAME "POSITION" :KIND :FUNCTION :LAMBDA-LIST "(item sequence &rest args &key from-end (start 0) end key test test-not)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pos_p.htm")
  (:NAME "POSITION-IF" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) end key)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pos_p.htm")
  (:NAME "POSITION-IF-NOT" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) end key)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pos_p.htm")
  (:NAME "PPRINT" :KIND :FUNCTION :LAMBDA-LIST "(object &optional stream)" :DOCSTRING "Prettily output OBJECT preceded by a newline." :ORIGIN :SBCL :CLHS-PAGE "Body/f_wr_pr.htm")
  (:NAME "PPRINT-DISPATCH" :KIND :FUNCTION :LAMBDA-LIST "(object &optional (table *print-pprint-dispatch*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_ppr_di.htm")
  (:NAME "PPRINT-EXIT-IF-LIST-EXHAUSTED" :KIND :MACRO :LAMBDA-LIST "()" :DOCSTRING "Cause the closest enclosing use of PPRINT-LOGICAL-BLOCK to return
if its list argument is exhausted. Can only be used inside
PPRINT-LOGICAL-BLOCK, and only when the LIST argument to
PPRINT-LOGICAL-BLOCK is supplied." :ORIGIN :SBCL :CLHS-PAGE "Body/m_ppr_ex.htm")
  (:NAME "PPRINT-FILL" :KIND :FUNCTION :LAMBDA-LIST "(stream list &optional (colon? t) atsign?)" :DOCSTRING "Output LIST to STREAM putting :FILL conditional newlines between each
element. If COLON? is NIL (defaults to T), then no parens are
printed around the output. ATSIGN? is ignored (but allowed so
that PPRINT-FILL can be used with the ~/.../ format directive." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ppr_fi.htm")
  (:NAME "PPRINT-INDENT" :KIND :FUNCTION :LAMBDA-LIST "(relative-to n &optional stream)" :DOCSTRING "Specify the indentation to use in the current logical block if
STREAM (which defaults to *STANDARD-OUTPUT*) is a pretty-printing
stream and do nothing if not. (See PPRINT-LOGICAL-BLOCK.) N is the
indentation to use (in ems, the width of an m'') and RELATIVE-TO can
be either:

     :BLOCK - Indent relative to the column the current logical block
        started on.

     :CURRENT - Indent relative to the current column.

The new indentation value does not take effect until the following
line break." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ppr_in.htm")
  (:NAME "PPRINT-LINEAR" :KIND :FUNCTION :LAMBDA-LIST "(stream list &optional (colon? t) atsign?)" :DOCSTRING "Output LIST to STREAM putting :LINEAR conditional newlines between each
element. If COLON? is NIL (defaults to T), then no parens are
printed around the output. ATSIGN? is ignored (but allowed so
that PPRINT-LINEAR can be used with the ~/.../ format directive." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ppr_fi.htm")
  (:NAME "PPRINT-LOGICAL-BLOCK" :KIND :MACRO :LAMBDA-LIST "((stream-symbol object &rest keys &key (prefix nil) (per-line-prefix nil) (suffix \"\")) &body body)" :DOCSTRING "Group some output into a logical block. STREAM-SYMBOL should be either a
stream, T (for *TERMINAL-IO*), or NIL (for *STANDARD-OUTPUT*). The printer
control variable *PRINT-LEVEL* is automatically handled." :ORIGIN :SBCL :CLHS-PAGE "Body/m_ppr_lo.htm")
  (:NAME "PPRINT-NEWLINE" :KIND :FUNCTION :LAMBDA-LIST "(kind &optional stream)" :DOCSTRING "Output a conditional newline to STREAM (which defaults to
*STANDARD-OUTPUT*) if it is a pretty-printing stream, and do
nothing if not. KIND can be one of:
  :LINEAR - A line break is inserted if and only if the immediately
     containing section cannot be printed on one line.
  :MISER - Same as LINEAR, but only if miser-style'' is in effect.
     (See *PRINT-MISER-WIDTH*.)
  :FILL - A line break is inserted if and only if either:
    (a) the following section cannot be printed on the end of the
        current line,
    (b) the preceding section was not printed on a single line, or
    (c) the immediately containing section cannot be printed on one
        line and miser-style is in effect.
  :MANDATORY - A line break is always inserted.
When a line break is inserted by any type of conditional newline, any
blanks that immediately precede the conditional newline are omitted
from the output and indentation is introduced at the beginning of the
next line. (See PPRINT-INDENT.)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_ppr_nl.htm")
  (:NAME "PPRINT-POP" :KIND :MACRO :LAMBDA-LIST "()" :DOCSTRING "Return the next element from LIST argument to the closest enclosing
use of PPRINT-LOGICAL-BLOCK, automatically handling *PRINT-LENGTH*
and *PRINT-CIRCLE*. Can only be used inside PPRINT-LOGICAL-BLOCK.
If the LIST argument to PPRINT-LOGICAL-BLOCK was NIL, then nothing
is popped, but the *PRINT-LENGTH* testing still happens." :ORIGIN :SBCL :CLHS-PAGE "Body/m_ppr_po.htm")
  (:NAME "PPRINT-TAB" :KIND :FUNCTION :LAMBDA-LIST "(kind colnum colinc &optional stream)" :DOCSTRING "If STREAM (which defaults to *STANDARD-OUTPUT*) is a pretty-printing
stream, perform tabbing based on KIND, otherwise do nothing. KIND can
be one of:
  :LINE - Tab to column COLNUM. If already past COLNUM tab to the next
    multiple of COLINC.
  :SECTION - Same as :LINE, but count from the start of the current
    section, not the start of the line.
  :LINE-RELATIVE - Output COLNUM spaces, then tab to the next multiple of
    COLINC.
  :SECTION-RELATIVE - Same as :LINE-RELATIVE, but count from the start
    of the current section, not the start of the line." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ppr_ta.htm")
  (:NAME "PPRINT-TABULAR" :KIND :FUNCTION :LAMBDA-LIST "(stream list &optional (colon? t) atsign? tabsize)" :DOCSTRING "Output LIST to STREAM tabbing to the next column that is an even multiple
of TABSIZE (which defaults to 16) between each element. :FILL style
conditional newlines are also output between each element. If
COLON? is NIL (defaults to T), then no parens are printed around
the output. ATSIGN? is ignored (but allowed so that
PPRINT-TABULAR can be used with the ~/.../ format directive." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ppr_fi.htm")
  (:NAME "PRIN1" :KIND :FUNCTION :LAMBDA-LIST "(object &optional stream)" :DOCSTRING "Output a mostly READable printed representation of OBJECT on the specified
STREAM." :ORIGIN :SBCL :CLHS-PAGE "Body/f_wr_pr.htm")
  (:NAME "PRIN1-TO-STRING" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return the printed representation of OBJECT as a string with
slashification on." :ORIGIN :SBCL :CLHS-PAGE "Body/f_wr_to_.htm")
  (:NAME "PRINC" :KIND :FUNCTION :LAMBDA-LIST "(object &optional stream)" :DOCSTRING "Output an aesthetic but not necessarily READable printed representation
of OBJECT on the specified STREAM." :ORIGIN :SBCL :CLHS-PAGE "Body/f_wr_pr.htm")
  (:NAME "PRINC-TO-STRING" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return the printed representation of OBJECT as a string with
slashification off." :ORIGIN :SBCL :CLHS-PAGE "Body/f_wr_to_.htm")
  (:NAME "PRINT" :KIND :FUNCTION :LAMBDA-LIST "(object &optional stream)" :DOCSTRING "Output a newline, the mostly READable printed representation of OBJECT, and
space to the specified STREAM." :ORIGIN :SBCL :CLHS-PAGE "Body/f_wr_pr.htm")
  (:NAME "PRINT-NOT-READABLE" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_pr_not.htm")
  (:NAME "PRINT-NOT-READABLE-OBJECT" :KIND :FUNCTION :LAMBDA-LIST "(condition)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pr_not.htm")
  (:NAME "PRINT-OBJECT" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(object stream)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_pr_obj.htm")
  (:NAME "PRINT-UNREADABLE-OBJECT" :KIND :MACRO :LAMBDA-LIST "((object stream &key type identity) &body body)" :DOCSTRING "Output OBJECT to STREAM with \"#<\" prefix, \">\" suffix, optionally
with object-type prefix and object-identity suffix, and executing the
code in BODY to provide possible further output." :ORIGIN :SBCL :CLHS-PAGE "Body/m_pr_unr.htm")
  (:NAME "PROBE-FILE" :KIND :FUNCTION :LAMBDA-LIST "(pathspec)" :DOCSTRING "Return the truename of PATHSPEC if the truename can be found,
or NIL otherwise.  See TRUENAME for more information." :ORIGIN :SBCL :CLHS-PAGE "Body/f_probe_.htm")
  (:NAME "PROCLAIM" :KIND :FUNCTION :LAMBDA-LIST "(raw-form)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_procla.htm")
  (:NAME "PROG" :KIND :MACRO :LAMBDA-LIST "(varlist &body body-decls)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_prog_.htm")
  (:NAME "PROG*" :KIND :MACRO :LAMBDA-LIST "(varlist &body body-decls)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_prog_.htm")
  (:NAME "PROG1" :KIND :MACRO :LAMBDA-LIST "(result &body body)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_prog1c.htm")
  (:NAME "PROG2" :KIND :MACRO :LAMBDA-LIST "(form1 result &body body)" :ORIGIN :SBCL :CLHS-PAGE "Body/m_prog1c.htm")
  (:NAME "PROGN" :KIND :SPECIAL-OPERATOR :DOCSTRING "PROGN form*

Evaluates each FORM in order, returning the values of the last form. With no
forms, returns NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/s_progn.htm")
  (:NAME "PROGRAM-ERROR" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_progra.htm")
  (:NAME "PROGV" :KIND :SPECIAL-OPERATOR :ORIGIN :SBCL :CLHS-PAGE "Body/s_progv.htm")
  (:NAME "PROVIDE" :KIND :FUNCTION :LAMBDA-LIST "(module-name)" :DOCSTRING "Adds a new module name to *MODULES* indicating that it has been loaded.
Module-name is a string designator" :ORIGIN :SBCL :CLHS-PAGE "Body/f_provid.htm")
  (:NAME "PSETF" :KIND :MACRO :LAMBDA-LIST "(&rest pairs)" :DOCSTRING "This is to SETF as PSETQ is to SETQ. Args are alternating place
expressions and values to go into those places. All of the subforms and
values are determined, left to right, and only then are the locations
updated. Returns NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/m_setf_.htm")
  (:NAME "PSETQ" :KIND :MACRO :LAMBDA-LIST "(&rest pairs)" :DOCSTRING "PSETQ {var value}*
Set the variables to the values, like SETQ, except that assignments
happen in parallel, i.e. no assignments take place until all the
forms have been evaluated." :ORIGIN :SBCL :CLHS-PAGE "Body/m_psetq.htm")
  (:NAME "PUSH" :KIND :MACRO :LAMBDA-LIST "(obj place)" :DOCSTRING "Takes an object and a location holding a list. Conses the object onto
the list, returning the modified list. OBJ is evaluated before PLACE." :ORIGIN :SBCL :CLHS-PAGE "Body/m_push.htm")
  (:NAME "PUSHNEW" :KIND :MACRO :LAMBDA-LIST "(obj place &key key test test-not)" :DOCSTRING "Takes an object and a location holding a list. If the object is
already in the list, does nothing; otherwise, conses the object onto
the list. Keyword arguments are accepted as per the ADJOIN function." :ORIGIN :SBCL :CLHS-PAGE "Body/m_pshnew.htm")
  (:NAME "QUOTE" :KIND :SPECIAL-OPERATOR :DOCSTRING "QUOTE value

Return VALUE without evaluating it." :ORIGIN :SBCL :CLHS-PAGE "Body/s_quote.htm")
  (:NAME "RANDOM" :KIND :FUNCTION :LAMBDA-LIST "(arg &optional (state *random-state*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_random.htm")
  (:NAME "RANDOM-STATE" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_rnd_st.htm")
  (:NAME "RANDOM-STATE-P" :KIND :FUNCTION :LAMBDA-LIST "(object)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_rnd_st.htm")
  (:NAME "RASSOC" :KIND :FUNCTION :LAMBDA-LIST "(item alist &key key (test nil testp) (test-not nil notp))" :DOCSTRING "Return the cons in ALIST whose CDR is equal (by a given test or EQL) to
the ITEM." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rassoc.htm")
  (:NAME "RASSOC-IF" :KIND :FUNCTION :LAMBDA-LIST "(predicate alist &key key)" :DOCSTRING "Return the first cons in ALIST whose CDR satisfies PREDICATE. If KEY
is supplied, apply it to the CDR of each cons before testing." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rassoc.htm")
  (:NAME "RASSOC-IF-NOT" :KIND :FUNCTION :LAMBDA-LIST "(predicate alist &key key)" :DOCSTRING "Return the first cons in ALIST whose CDR does not satisfy PREDICATE.
If KEY is supplied, apply it to the CDR of each cons before testing." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rassoc.htm")
  (:NAME "RATIO" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_ratio.htm")
  (:NAME "RATIONAL" :KIND :FUNCTION :LAMBDA-LIST "(x)" :DOCSTRING "RATIONAL produces a rational number for any real numeric argument. This is
more efficient than RATIONALIZE, but it assumes that floating-point is
completely accurate, giving a result that isn't as pretty." :ORIGIN :SBCL :CLHS-PAGE "Body/a_ration.htm")
  (:NAME "RATIONAL" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/a_ration.htm")
  (:NAME "RATIONALIZE" :KIND :FUNCTION :LAMBDA-LIST "(x)" :DOCSTRING "Converts any REAL to a RATIONAL.  Floats are converted to a simple rational
representation exploiting the assumption that floats are only accurate to
their precision.  RATIONALIZE (and also RATIONAL) preserve the invariant:
    (= x (float (rationalize x) x))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_ration.htm")
  (:NAME "RATIONALP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a RATIONAL, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rati_1.htm")
  (:NAME "READ" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-input*) (eof-error-p t) (eof-value nil) (recursive-p nil))" :DOCSTRING "Read the next Lisp value from STREAM, and return it." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rd_rd.htm")
  (:NAME "READ-BYTE" :KIND :FUNCTION :LAMBDA-LIST "(stream &optional (eof-error-p t) eof-value)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_rd_by.htm")
  (:NAME "READ-CHAR" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-input*) (eof-error-p t) eof-value recursive-p)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_rd_cha.htm")
  (:NAME "READ-CHAR-NO-HANG" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-input*) (eof-error-p t) eof-value recursive-p)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_rd_c_1.htm")
  (:NAME "READ-DELIMITED-LIST" :KIND :FUNCTION :LAMBDA-LIST "(endchar &optional (input-stream *standard-input*) recursive-p)" :DOCSTRING "Read Lisp values from INPUT-STREAM until the next character after a
value's representation is ENDCHAR, and return the objects as a list." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rd_del.htm")
  (:NAME "READ-FROM-STRING" :KIND :FUNCTION :LAMBDA-LIST "(string &optional (eof-error-p t) eof-value &key (start 0) end preserve-whitespace)" :DOCSTRING "The characters of string are successively given to the lisp reader
and the lisp object built by the reader is returned. Macro chars
will take effect." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rd_fro.htm")
  (:NAME "READ-LINE" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-input*) (eof-error-p t) eof-value recursive-p)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_rd_lin.htm")
  (:NAME "READ-PRESERVING-WHITESPACE" :KIND :FUNCTION :LAMBDA-LIST "(&optional (stream *standard-input*) (eof-error-p t) (eof-value nil) (recursive-p nil))" :DOCSTRING "Read from STREAM and return the value read, preserving any whitespace
that followed the object." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rd_rd.htm")
  (:NAME "READ-SEQUENCE" :KIND :FUNCTION :LAMBDA-LIST "(seq stream &key (start 0) end)" :DOCSTRING "Destructively modify SEQ by reading elements from STREAM.
That part of SEQ bounded by START and END is destructively modified by
copying successive elements into it from STREAM. If the end of file
for STREAM is reached before copying all elements of the subsequence,
then the extra elements near the end of sequence are not updated, and
the index of the next element is returned." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rd_seq.htm")
  (:NAME "READER-ERROR" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_rder_e.htm")
  (:NAME "READTABLE" :KIND :CLASS :DOCSTRING "A READTABLE is a data structure that maps characters into syntax
types for the Common Lisp expression reader." :ORIGIN :SBCL :CLHS-PAGE "Body/t_rdtabl.htm")
  (:NAME "READTABLE-CASE" :KIND :FUNCTION :LAMBDA-LIST "(readtable)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_rdtabl.htm")
  (:NAME "READTABLEP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_rdta_1.htm")
  (:NAME "REAL" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_real.htm")
  (:NAME "REALP" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a REAL, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_realp.htm")
  (:NAME "REALPART" :KIND :FUNCTION :LAMBDA-LIST "(number)" :DOCSTRING "Extract the real part of a number." :ORIGIN :SBCL :CLHS-PAGE "Body/f_realpa.htm")
  (:NAME "REDUCE" :KIND :FUNCTION :LAMBDA-LIST "(function sequence &rest args &key key from-end (start 0) end (initial-value nil ivp))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_reduce.htm")
  (:NAME "REINITIALIZE-INSTANCE" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(instance &rest initargs &key &allow-other-keys)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_reinit.htm")
  (:NAME "REM" :KIND :FUNCTION :LAMBDA-LIST "(number divisor)" :DOCSTRING "Return second result of TRUNCATE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_mod_r.htm")
  (:NAME "REMF" :KIND :MACRO :LAMBDA-LIST "(place indicator)" :DOCSTRING "Place may be any place expression acceptable to SETF, and is expected
to hold a property list or (). This list is destructively altered to
remove the property specified by the indicator. Returns T if such a
property was present, NIL if not." :ORIGIN :SBCL :CLHS-PAGE "Body/m_remf.htm")
  (:NAME "REMHASH" :KIND :FUNCTION :LAMBDA-LIST "(key hash-table)" :DOCSTRING "Remove the entry in HASH-TABLE associated with KEY. Return T if
there was such an entry, or NIL if not." :ORIGIN :SBCL :CLHS-PAGE "Body/f_remhas.htm")
  (:NAME "REMOVE" :KIND :FUNCTION :LAMBDA-LIST "(item sequence &rest args &key from-end (test (function eql) test-p) (test-not nil test-not-p) (start 0) (end nil) (count nil) (key nil))" :DOCSTRING "Return a copy of SEQUENCE with elements satisfying the test (default is
EQL) with ITEM removed." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rm_rm.htm")
  (:NAME "REMOVE-DUPLICATES" :KIND :FUNCTION :LAMBDA-LIST "(sequence &rest args &key (test (function eql) test-p) (test-not nil test-not-p) (start 0) (end nil) from-end (key nil))" :DOCSTRING "The elements of SEQUENCE are compared pairwise, and if any two match,
the one occurring earlier is discarded, unless FROM-END is true, in
which case the one later in the sequence is discarded. The resulting
sequence is returned.

The :TEST-NOT argument is deprecated." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rm_dup.htm")
  (:NAME "REMOVE-IF" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) (end nil) (count nil) (key nil))" :DOCSTRING "Return a copy of sequence with elements satisfying PREDICATE removed." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rm_rm.htm")
  (:NAME "REMOVE-IF-NOT" :KIND :FUNCTION :LAMBDA-LIST "(predicate sequence &rest args &key from-end (start 0) (end nil) (count nil) (key nil))" :DOCSTRING "Return a copy of sequence with elements not satisfying PREDICATE removed." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rm_rm.htm")
  (:NAME "REMOVE-METHOD" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(generic-function method)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_rm_met.htm")
  (:NAME "REMPROP" :KIND :FUNCTION :LAMBDA-LIST "(symbol indicator)" :DOCSTRING "Look on property list of SYMBOL for property with specified
INDICATOR. If found, splice this indicator and its value out of
the plist, and return the tail of the original list starting with
INDICATOR. If not found, return () with no side effects.

NOTE: The ANSI specification requires REMPROP to return true (not false)
or false (the symbol NIL). Portable code should not rely on any other value." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rempro.htm")
  (:NAME "RENAME-FILE" :KIND :FUNCTION :LAMBDA-LIST "(file new-name)" :DOCSTRING "Rename FILE to have the specified NEW-NAME. If FILE is a stream open to a
file, then the associated file is renamed." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rn_fil.htm")
  (:NAME "RENAME-PACKAGE" :KIND :FUNCTION :LAMBDA-LIST "(package-designator name &optional (nicknames nil))" :DOCSTRING "Changes the name and nicknames for a package." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rn_pkg.htm")
  (:NAME "REPLACE" :KIND :FUNCTION :LAMBDA-LIST "(target-sequence1 source-sequence2 &rest args &key (start1 0) (end1 nil) (start2 0) (end2 nil))" :DOCSTRING "Destructively modifies SEQUENCE1 by copying successive elements
into it from the SEQUENCE2.

Elements are copied to the subsequence bounded by START1 and END1,
from the subsequence bounded by START2 and END2. If these subsequences
are not of the same length, then the shorter length determines how
many elements are copied." :ORIGIN :SBCL :CLHS-PAGE "Body/f_replac.htm")
  (:NAME "REQUIRE" :KIND :FUNCTION :LAMBDA-LIST "(module-name &optional pathnames)" :DOCSTRING "Loads a module, unless it already has been loaded. PATHNAMES, if supplied,
is a designator for a list of pathnames to be loaded if the module
needs to be. If PATHNAMES is not supplied, functions from the list
*MODULE-PROVIDER-FUNCTIONS* are called in order with MODULE-NAME
as an argument, until one of them returns non-NIL.  User code is
responsible for calling PROVIDE to indicate a successful load of the
module." :ORIGIN :SBCL :CLHS-PAGE "Body/f_provid.htm")
  (:NAME "REST" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Means the same as the cdr of a list." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rest.htm")
  (:NAME "RESTART" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_rst.htm")
  (:NAME "RESTART-BIND" :KIND :MACRO :LAMBDA-LIST "(bindings &body forms)" :DOCSTRING "(RESTART-BIND ({(case-name function {keyword value}*)}*) forms)
Executes forms in a dynamic context where the given bindings are in
effect. Users probably want to use RESTART-CASE. A case-name of NIL
indicates an anonymous restart. When bindings contain the same
restart name, FIND-RESTART will find the first such binding." :ORIGIN :SBCL :CLHS-PAGE "Body/m_rst_bi.htm")
  (:NAME "RESTART-CASE" :KIND :MACRO :LAMBDA-LIST "(expression &body clauses)" :DOCSTRING "(RESTART-CASE form {(case-name arg-list {keyword value}* body)}*)
The form is evaluated in a dynamic context where the clauses have
special meanings as points to which control may be transferred (see
INVOKE-RESTART).  When clauses contain the same case-name,
FIND-RESTART will find the first such clause. If form is a call to
SIGNAL, ERROR, CERROR or WARN (or macroexpands into such) then the
signalled condition will be associated with the new restarts." :ORIGIN :SBCL :CLHS-PAGE "Body/m_rst_ca.htm")
  (:NAME "RESTART-NAME" :KIND :FUNCTION :LAMBDA-LIST "(instance)" :DOCSTRING "Return the name of the given restart object." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rst_na.htm")
  (:NAME "RETURN" :KIND :MACRO :LAMBDA-LIST "(&optional (value nil))" :ORIGIN :SBCL :CLHS-PAGE "Body/m_return.htm")
  (:NAME "RETURN-FROM" :KIND :SPECIAL-OPERATOR :DOCSTRING "RETURN-FROM name value

Evaluate the VALUE, returning its values from the lexically enclosing
block NAME. This is constrained to be used only within the dynamic
extent of the block." :ORIGIN :SBCL :CLHS-PAGE "Body/s_ret_fr.htm")
  (:NAME "REVAPPEND" :KIND :FUNCTION :LAMBDA-LIST "(x y)" :DOCSTRING "Return (append (reverse x) y)." :ORIGIN :SBCL :CLHS-PAGE "Body/f_revapp.htm")
  (:NAME "REVERSE" :KIND :FUNCTION :LAMBDA-LIST "(sequence)" :DOCSTRING "Return a new sequence containing the same elements but in reverse order." :ORIGIN :SBCL :CLHS-PAGE "Body/f_revers.htm")
  (:NAME "ROOM" :KIND :FUNCTION :LAMBDA-LIST "(&optional (verbosity :default))" :DOCSTRING "Print to *STANDARD-OUTPUT* information about the state of internal
storage and its management. The optional argument controls the
verbosity of output. If it is T, ROOM prints out a maximal amount of
information. If it is NIL, ROOM prints out a minimal amount of
information. If it is :DEFAULT or it is not supplied, ROOM prints out
an intermediate amount of information." :ORIGIN :SBCL :CLHS-PAGE "Body/f_room.htm")
  (:NAME "ROTATEF" :KIND :MACRO :LAMBDA-LIST "(&rest args)" :DOCSTRING "Takes any number of SETF-style place expressions. Evaluates all of the
expressions in turn, then assigns to each place the value of the form to
its right. The rightmost form gets the value of the leftmost.
Returns NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/m_rotate.htm")
  (:NAME "ROUND" :KIND :FUNCTION :LAMBDA-LIST "(number &optional (divisor 1))" :DOCSTRING "Rounds number (or number/divisor) to nearest integer.
The second returned value is the remainder." :ORIGIN :SBCL :CLHS-PAGE "Body/f_floorc.htm")
  (:NAME "ROW-MAJOR-AREF" :KIND :FUNCTION :LAMBDA-LIST "(array index)" :DOCSTRING "Return the element of array corresponding to the row-major index. This is
SETFable." :ORIGIN :SBCL :CLHS-PAGE "Body/f_row_ma.htm")
  (:NAME "RPLACA" :KIND :FUNCTION :LAMBDA-LIST "(cons x)" :DOCSTRING "Change the CAR of CONS to X and return the CONS." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rplaca.htm")
  (:NAME "RPLACD" :KIND :FUNCTION :LAMBDA-LIST "(cons x)" :DOCSTRING "Change the CDR of CONS to X and return the CONS." :ORIGIN :SBCL :CLHS-PAGE "Body/f_rplaca.htm")
  (:NAME "SAFETY" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/d_optimi.htm")
  (:NAME "SATISFIES" :KIND :SYMBOL :ORIGIN :SBCL :CLHS-PAGE "Body/t_satisf.htm")
  (:NAME "SBIT" :KIND :FUNCTION :LAMBDA-LIST "(simple-bit-array &rest subscripts)" :DOCSTRING "Return the bit from SIMPLE-BIT-ARRAY at the specified SUBSCRIPTS." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_sb.htm")
  (:NAME "SCALE-FLOAT" :KIND :FUNCTION :LAMBDA-LIST "(f ex)" :DOCSTRING "Return the value (* f (expt (float 2 f) ex)), but with no unnecessary loss
of precision or overflow." :ORIGIN :SBCL :CLHS-PAGE "Body/f_dec_fl.htm")
  (:NAME "SCHAR" :KIND :FUNCTION :LAMBDA-LIST "(string index)" :DOCSTRING "SCHAR returns the character object at an indexed position in a string
just as CHAR does, except the string must be a simple-string." :ORIGIN :SBCL :CLHS-PAGE "Body/f_char_.htm")
  (:NAME "SEARCH" :KIND :FUNCTION :LAMBDA-LIST "(sub-sequence1 main-sequence2 &rest args &key from-end (test (function eql) test-p) (test-not nil test-not-p) (start1 0) (end1 nil) (start2 0) (end2 nil) (key nil))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_search.htm")
  (:NAME "SECOND" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return the 2nd object in a list or NIL if there is no 2nd object." :ORIGIN :SBCL :CLHS-PAGE "Body/f_firstc.htm")
  (:NAME "SEQUENCE" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_seq.htm")
  (:NAME "SERIOUS-CONDITION" :KIND :CONDITION :ORIGIN :SBCL :CLHS-PAGE "Body/e_seriou.htm")
  (:NAME "SET" :KIND :FUNCTION :LAMBDA-LIST "(symbol new-value)" :DOCSTRING "Set SYMBOL's value cell to NEW-VALUE." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set.htm")
  (:NAME "SET-DIFFERENCE" :KIND :FUNCTION :LAMBDA-LIST "(list1 list2 &key key (test nil testp) (test-not nil notp))" :DOCSTRING "Return the elements of LIST1 which are not in LIST2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set_di.htm")
  (:NAME "SET-DISPATCH-MACRO-CHARACTER" :KIND :FUNCTION :LAMBDA-LIST "(disp-char sub-char function &optional (rt-designator *readtable*))" :DOCSTRING "Cause FUNCTION to be called whenever the reader reads DISP-CHAR
followed by SUB-CHAR." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set__1.htm")
  (:NAME "SET-EXCLUSIVE-OR" :KIND :FUNCTION :LAMBDA-LIST "(list1 list2 &key key (test nil testp) (test-not nil notp))" :DOCSTRING "Return new list of elements appearing exactly once in LIST1 and LIST2." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set_ex.htm")
  (:NAME "SET-MACRO-CHARACTER" :KIND :FUNCTION :LAMBDA-LIST "(char function &optional (non-terminatingp nil) (rt-designator *readtable*))" :DOCSTRING "Causes CHAR to be a macro character which invokes FUNCTION when seen
by the reader. The NON-TERMINATINGP flag can be used to make the macro
character non-terminating, i.e. embeddable in a symbol name." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set_ma.htm")
  (:NAME "SET-PPRINT-DISPATCH" :KIND :FUNCTION :LAMBDA-LIST "(type function &optional (priority 0) (table *print-pprint-dispatch*))" :ORIGIN :SBCL :CLHS-PAGE "Body/f_set_pp.htm")
  (:NAME "SET-SYNTAX-FROM-CHAR" :KIND :FUNCTION :LAMBDA-LIST "(to-char from-char &optional (to-readtable *readtable*) (from-readtable nil))" :DOCSTRING "Causes the syntax of TO-CHAR in TO-READTABLE to be the same as
FROM-CHAR in FROM-READTABLE. TO-READTABLE defaults to *READTABLE*, and
FROM-READTABLE defaults to the standard Lisp readtable when NIL." :ORIGIN :SBCL :CLHS-PAGE "Body/f_set_sy.htm")
  (:NAME "SETF" :KIND :MACRO :LAMBDA-LIST "(&rest args)" :DOCSTRING "Takes pairs of arguments like SETQ. The first is a place and the second
is the value that is supposed to go into that place. Returns the last
value. The place argument may be any of the access forms for which SETF
knows a corresponding setting form." :ORIGIN :SBCL :CLHS-PAGE "Body/a_setf.htm")
  (:NAME "SETQ" :KIND :SPECIAL-OPERATOR :ORIGIN :SBCL :CLHS-PAGE "Body/s_setq.htm")
  (:NAME "SEVENTH" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return the 7th object in a list or NIL if there is no 7th object." :ORIGIN :SBCL :CLHS-PAGE "Body/f_firstc.htm")
  (:NAME "SHADOW" :KIND :FUNCTION :LAMBDA-LIST "(symbols &optional (package (sane-package)))" :DOCSTRING "Make an internal symbol in PACKAGE with the same name as each of the
specified SYMBOLS. If a symbol with the given name is already present in
PACKAGE, then the existing symbol is placed in the shadowing symbols list if
it is not already present." :ORIGIN :SBCL :CLHS-PAGE "Body/f_shadow.htm")
  (:NAME "SHADOWING-IMPORT" :KIND :FUNCTION :LAMBDA-LIST "(symbols &optional (package (sane-package)))" :DOCSTRING "Import SYMBOLS into package, disregarding any name conflict. If
a symbol of the same name is present, then it is uninterned." :ORIGIN :SBCL :CLHS-PAGE "Body/f_shdw_i.htm")
  (:NAME "SHARED-INITIALIZE" :KIND :GENERIC-FUNCTION :LAMBDA-LIST "(instance slot-names &rest initargs &key &allow-other-keys)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_shared.htm")
  (:NAME "SHIFTF" :KIND :MACRO :LAMBDA-LIST "(&rest args)" :DOCSTRING "One or more SETF-style place expressions, followed by a single
value expression. Evaluates all of the expressions in turn, then
assigns the value of each expression to the place on its left,
returning the value of the leftmost." :ORIGIN :SBCL :CLHS-PAGE "Body/m_shiftf.htm")
  (:NAME "SHORT-FLOAT" :KIND :TYPE :ORIGIN :SBCL :CLHS-PAGE "Body/t_short_.htm")
  (:NAME "SHORT-FLOAT-EPSILON" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_short_.htm")
  (:NAME "SHORT-FLOAT-NEGATIVE-EPSILON" :KIND :CONSTANT :ORIGIN :SBCL :CLHS-PAGE "Body/v_short_.htm")
  (:NAME "SHORT-SITE-NAME" :KIND :FUNCTION :LAMBDA-LIST "()" :DOCSTRING "Return a string with the abbreviated site name, or NIL if not known." :ORIGIN :SBCL :CLHS-PAGE "Body/f_short_.htm")
  (:NAME "SIGNAL" :KIND :FUNCTION :LAMBDA-LIST "(datum &rest arguments)" :DOCSTRING "Invokes the signal facility on a condition formed from DATUM and
ARGUMENTS. If the condition is not handled, NIL is returned. If
(TYPEP condition *BREAK-ON-SIGNALS*) is true, the debugger is invoked
before any signalling is done." :ORIGIN :SBCL :CLHS-PAGE "Body/f_signal.htm")
  (:NAME "SIGNED-BYTE" :KIND :TYPE :ORIGIN :SBCL :CLHS-PAGE "Body/t_sgn_by.htm")
