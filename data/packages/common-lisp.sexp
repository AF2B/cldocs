  (:NAME "BIT" :KIND :FUNCTION :LAMBDA-LIST "(bit-array &rest subscripts)" :DOCSTRING "Return the bit from the BIT-ARRAY at the specified SUBSCRIPTS." :ORIGIN :SBCL :CLHS-PAGE "Body/a_bit.htm")
