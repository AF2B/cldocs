  (:NAME "BIT-AND" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGAND on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-ANDC1" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGANDC1 on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-ANDC2" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGANDC2 on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-EQV" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGEQV on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-IOR" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGIOR on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-NAND" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGNAND on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-NOR" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGNOR on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-NOT" :KIND :FUNCTION :LAMBDA-LIST "(bit-array &optional result-bit-array)" :DOCSTRING "Performs a bit-wise logical NOT on the elements of BIT-ARRAY,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. Both arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-ORC1" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGORC1 on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-ORC2" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGORC2 on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BIT-VECTOR" :KIND :CLASS :ORIGIN :SBCL :CLHS-PAGE "Body/t_bt_vec.htm")
  (:NAME "BIT-VECTOR-P" :KIND :FUNCTION :LAMBDA-LIST "(object)" :DOCSTRING "Return true if OBJECT is a BIT-VECTOR, and NIL otherwise." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_vec.htm")
  (:NAME "BIT-XOR" :KIND :FUNCTION :LAMBDA-LIST "(bit-array-1 bit-array-2 &optional result-bit-array)" :DOCSTRING "Perform a bit-wise LOGXOR on the elements of BIT-ARRAY-1 and BIT-ARRAY-2,
putting the results in RESULT-BIT-ARRAY. If RESULT-BIT-ARRAY is T,
BIT-ARRAY-1 is used. If RESULT-BIT-ARRAY is NIL or omitted, a new array is
created. All the arrays must have the same rank and dimensions." :ORIGIN :SBCL :CLHS-PAGE "Body/f_bt_and.htm")
  (:NAME "BLOCK" :KIND :SPECIAL-OPERATOR :DOCSTRING "BLOCK name form*

Evaluate the FORMS as a PROGN. Within the lexical scope of the body,
RETURN-FROM can be used to exit the form." :ORIGIN :SBCL :CLHS-PAGE "Body/s_block.htm")
  (:NAME "BOOLE" :KIND :FUNCTION :LAMBDA-LIST "(op integer1 integer2)" :DOCSTRING "Bit-wise boolean function on two integers. Function chosen by OP:
0       BOOLE-CLR
1       BOOLE-SET
2       BOOLE-1
3       BOOLE-2
4       BOOLE-C1
5       BOOLE-C2
6       BOOLE-AND
7       BOOLE-IOR
8       BOOLE-XOR
9       BOOLE-EQV
10      BOOLE-NAND
11      BOOLE-NOR
12      BOOLE-ANDC1
13      BOOLE-ANDC2
14      BOOLE-ORC1
15      BOOLE-ORC2" :ORIGIN :SBCL :CLHS-PAGE "Body/f_boole.htm")
  (:NAME "BOOLE-1" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return integer1." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-2" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-AND" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return logand of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-ANDC1" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return logandc1 of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-ANDC2" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return logandc2 of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-C1" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return complement of integer1." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-C2" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return complement of integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-CLR" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return 0." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-EQV" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return logeqv of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-IOR" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return logior of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-NAND" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return log nand of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-NOR" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return lognor of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-ORC1" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return logorc1 of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-ORC2" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return logorc2 of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-SET" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return -1." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLE-XOR" :KIND :CONSTANT :DOCSTRING "Boole function op, makes BOOLE return logxor of integer1 and integer2." :ORIGIN :SBCL :CLHS-PAGE "Body/v_b_1_b.htm")
  (:NAME "BOOLEAN" :KIND :TYPE :ORIGIN :SBCL :CLHS-PAGE "Body/t_ban.htm")
  (:NAME "BOTH-CASE-P" :KIND :FUNCTION :LAMBDA-LIST "(char)" :DOCSTRING "The argument must be a character object. BOTH-CASE-P returns T if the
argument is an alphabetic character and if the character exists in both upper
and lower case. For ASCII, this is the same as ALPHA-CHAR-P." :ORIGIN :SBCL :CLHS-PAGE "Body/f_upper_.htm")
  (:NAME "BOUNDP" :KIND :FUNCTION :LAMBDA-LIST "(symbol)" :DOCSTRING "Return non-NIL if SYMBOL is bound to a value." :ORIGIN :SBCL :CLHS-PAGE "Body/f_boundp.htm")
