  (:NAME "CDDR" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return all but the 1st two objects of a list." :ORIGIN :SBCL :CLHS-PAGE "Body/f_car_c.htm")
  (:NAME "CDR" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return all but the first object in a list." :ORIGIN :SBCL :CLHS-PAGE "Body/f_car_c.htm")
  (:NAME "CEILING" :KIND :FUNCTION :LAMBDA-LIST "(number &optional (divisor 1))" :DOCSTRING "Return number/divisor as an integer, rounded toward positive infinity.
The second returned value is the remainder." :ORIGIN :SBCL :CLHS-PAGE "Body/f_floorc.htm")
