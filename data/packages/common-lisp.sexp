  (:NAME "CDDAAR" :KIND :FUNCTION :LAMBDA-LIST "(list)" :DOCSTRING "Return the cdr of the cdaar of a list." :ORIGIN :SBCL :CLHS-PAGE "Body/f_car_c.htm")
