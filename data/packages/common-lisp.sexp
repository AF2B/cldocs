  (:NAME "STRING-NOT-LESSP" :KIND :FUNCTION :LAMBDA-LIST "(string1 string2 &key (start1 0) end1 (start2 0) end2)" :DOCSTRING "Given two strings, if the first string is lexicographically greater
than or equal to the second string, returns the longest common prefix
(using char-equal) of the two strings. Otherwise, returns ()." :ORIGIN :SBCL :CLHS-PAGE "Body/f_stgeq_.htm")
  (:NAME "STRING-RIGHT-TRIM" :KIND :FUNCTION :LAMBDA-LIST "(char-bag string)" :ORIGIN :SBCL :CLHS-PAGE "Body/f_stg_tr.htm")
