  (:NAME "ASH" :KIND :FUNCTION :LAMBDA-LIST "(integer count)" :DOCSTRING "Shifts integer left by count places preserving sign. - count shifts right." :ORIGIN :SBCL :CLHS-PAGE "Body/f_ash.htm")
