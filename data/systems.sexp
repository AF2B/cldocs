;;;; Systems ingested besides the SBCL image: ASDF system and the packages it exports.
;;;; A system without a declared license is refused; see CLDOCS/CONDITIONS:SYSTEM-WITHOUT-LICENSE.
((:system "alexandria" :packages ("ALEXANDRIA"))
 (:system "anaphora" :packages ("ANAPHORA"))
 (:system "babel" :packages ("BABEL"))
 (:system "bordeaux-threads" :packages ("BORDEAUX-THREADS"))
 (:system "cl-ppcre" :packages ("CL-PPCRE"))
 (:system "fiveam" :packages ("FIVEAM"))
 (:system "iterate" :packages ("ITERATE"))
 (:system "local-time" :packages ("LOCAL-TIME"))
 (:system "named-readtables" :packages ("EDITOR-HINTS.NAMED-READTABLES"))
 (:system "split-sequence" :packages ("SPLIT-SEQUENCE"))
 (:system "str" :packages ("STR"))
 (:system "trivial-garbage" :packages ("TRIVIAL-GARBAGE")))
