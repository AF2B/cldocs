    (:FORM "(let* ((lock (make-lock))
       (cv (make-condition-variable))
       (done nil)
       (waiter (make-thread
                (lambda ()
                  (with-lock-held (lock)
                    (loop until done do (condition-wait cv lock))
                    :woken)))))
  (with-lock-held (lock)
    (setf done t)
    (condition-notify cv))
  (join-thread waiter))" :VALUES (":WOKEN"))))
