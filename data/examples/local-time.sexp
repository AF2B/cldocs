    (:FORM "(let ((new-york (progn (reread-timezone-repository)
                        (find-timezone-by-location-name \"America/New_York\"))))
  (format-timestring nil (parse-timestring \"2024-03-15T10:30:00Z\") :timezone new-york))" :VALUES ("\"2024-03-15T06:30:00.000000-04:00\""))))
