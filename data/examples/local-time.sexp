  (:symbol "FORMAT-TIMESTRING" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(format-timestring nil (parse-timestring \"2024-03-15T10:30:00Z\"))" :VALUES ("\"2024-03-15T10:30:00.000000Z\""))
    (:FORM "(format-timestring nil (parse-timestring \"2024-03-15T10:30:00Z\")
                   :format '((:year 4) #\\/ (:month 2) #\\/ (:day 2)))" :VALUES ("\"2024/03/15\""))
    (:FORM "(format-timestring nil (parse-timestring \"2024-03-15T10:30:00Z\")
