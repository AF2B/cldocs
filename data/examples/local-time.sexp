  (:symbol "PARSE-TIMESTRING" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(parse-timestring \"2024-03-15T10:30:00Z\")" :VALUES ("@2024-03-15T10:30:00.000000Z"))
    (:FORM "(parse-timestring \"2024-03-15T10:30:00+03:00\")" :VALUES ("@2024-03-15T07:30:00.000000Z"))
    (:FORM "(parse-timestring \"2024-03-15\")" :VALUES ("@2024-03-15T00:00:00.000000Z"))
    (:FORM "(parse-timestring \"not a date\" :fail-on-error nil)" :VALUES ("NIL"))))
  (:symbol "PARSE-RFC3339-TIMESTRING" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(parse-rfc3339-timestring \"2024-03-15T10:30:00.250Z\")" :VALUES ("@2024-03-15T10:30:00.250000Z"))
    (:FORM "(parse-rfc3339-timestring \"2024-03-15\" :allow-missing-time-part t)" :VALUES ("@2024-03-15T00:00:00.000000Z"))
    (:FORM "(parse-rfc3339-timestring \"garbage\" :fail-on-error nil)" :VALUES ("NIL"))))
  (:symbol "ENABLE-READ-MACROS" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(let ((*readtable* (copy-readtable)))
  (enable-read-macros)
  (timestamp= (values (read-from-string \"@2024-03-15T10:30:00Z\"))
              (parse-timestring \"2024-03-15T10:30:00Z\")))" :VALUES ("T"))
    (:FORM "(let ((*readtable* (copy-readtable)))
  (enable-read-macros)
  (values (read-from-string \"@2024-03-15T10:30:00Z\")))" :VALUES ("@2024-03-15T10:30:00.000000Z"))))
  (:symbol "REREAD-TIMEZONE-REPOSITORY" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(reread-timezone-repository)" :VALUES ("NIL"))
    (:FORM "(not (null (find-timezone-by-location-name \"America/New_York\")))" :VALUES ("T"))))
  (:symbol "FIND-TIMEZONE-BY-LOCATION-NAME" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(reread-timezone-repository)" :VALUES ("NIL"))
    (:FORM "(zone-name (find-timezone-by-location-name \"America/New_York\"))" :VALUES ("\"America/New_York\""))
    (:FORM "(find-timezone-by-location-name \"Nowhere/Land\")" :VALUES ("NIL" "NIL"))))
  (:symbol "ZONE-NAME" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(zone-name +utc-zone+)" :VALUES ("\"Coordinated Universal Time\""))
    (:FORM "(progn (reread-timezone-repository)
       (zone-name (find-timezone-by-location-name \"Europe/Paris\")))" :VALUES ("\"Europe/Paris\""))))
  (:symbol "TIMESTAMP-SUBTIMEZONE" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(multiple-value-list (timestamp-subtimezone (parse-timestring \"2024-03-15T10:30:00Z\") +utc-zone+))" :VALUES ("(0 NIL \"UTC\")"))
    (:FORM "(progn (reread-timezone-repository)
       (let ((new-york (find-timezone-by-location-name \"America/New_York\")))
         (list (multiple-value-list (timestamp-subtimezone (parse-timestring \"2024-01-15T12:00:00Z\") new-york))
               (multiple-value-list (timestamp-subtimezone (parse-timestring \"2024-07-15T12:00:00Z\") new-york)))))" :VALUES ("((-18000 NIL \"EST\") (-14400 T \"EDT\"))"))))
  (:symbol "TIMEZONES-MATCHING-SUBZONE" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(progn (reread-timezone-repository)
       (let ((matches (timezones-matching-subzone \"EST\" (parse-timestring \"2024-01-15T12:00:00Z\"))))
         (not (null (find \"America/New_York\" matches
                          :key (lambda (match) (zone-name (first match)))
                          :test #'string=)))))" :VALUES ("T"))))
  (:symbol "ALL-TIMEZONES-MATCHING-SUBZONE" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(setf *default-timezone* +utc-zone+)" :SILENT T)
    (:FORM "(progn (reread-timezone-repository)
       (let ((matches (all-timezones-matching-subzone \"CET\")))
         (not (null (find \"Europe/Paris\" matches
                          :key (lambda (match) (zone-name (first match)))
                          :test #'string=)))))" :VALUES ("T"))))
  (:symbol "DEFINE-TIMEZONE" :uses ("LOCAL-TIME") :system "local-time"
   :steps
   (
    (:FORM "(macroexpand-1 '(define-timezone demo-zone \"/tmp/demo-zone\" :load nil))" :VALUES ("(PROGN (DEFPARAMETER DEMO-ZONE (LOCAL-TIME::MAKE-TIMEZONE :PATH \"/tmp/demo-zone\" :NAME \"demo-zone\")) DEMO-ZONE)" "T"))
    (:FORM "(progn (define-timezone demo-utc
         (asdf:system-relative-pathname :local-time \"zoneinfo/Etc/UTC\")
         :load t)
       (zone-name demo-utc))" :VALUES ("\"demo-utc\"")))))
 )
