;;;; manifest.lisp --- Provenance and integrity record of the ingested data.

(defpackage #:cldocs/manifest
  (:use #:cl)
  (:import-from #:cldocs/store
                #:data-directory
                #:package-data-pathname
                #:read-data-file
                #:stored-package-names)
  (:export #:quicklisp-dist-version
           #:build-manifest
           #:write-manifest
           #:read-manifest
           #:manifest-stale-packages))

(in-package #:cldocs/manifest)

(defparameter *manifest-file-name* "MANIFEST.sexp"
  "File below the data root recording how the data was produced.")

(defparameter *unknown-version* "unknown"
  "Value recorded when a tool version cannot be determined.")

(defun quicklisp-dist-version ()
  "Return the installed Quicklisp dist version, or \"unknown\" without Quicklisp."
  (let ((package (find-package '#:ql-dist)))
    (if package
        (uiop:symbol-call package '#:version
                          (uiop:symbol-call package '#:dist "quicklisp"))
        *unknown-version*)))

(defun file-sha256 (pathname)
  "Return the lowercase hex SHA-256 digest of the file PATHNAME.

- PATHNAME: the file to hash."
  (ironclad:byte-array-to-hex-string
   (ironclad:digest-file :sha256 pathname)))

(defun package-entry (package-name)
  "Return the manifest entry describing the stored data of PACKAGE-NAME.

- PACKAGE-NAME: the package name as a string."
  (let ((pathname (package-data-pathname package-name)))
    (list package-name
          :sha256 (file-sha256 pathname)
          :definitions (length (getf (read-data-file pathname) :definitions)))))

(defun build-manifest ()
  "Return a manifest plist describing the data currently on disk."
  (list :sbcl-version (lisp-implementation-version)
        :quicklisp-dist (quicklisp-dist-version)
        :packages (mapcar #'package-entry (stored-package-names))))

(defun write-manifest ()
  "Write MANIFEST.sexp for the data currently on disk and return its pathname."
  (let ((pathname (merge-pathnames *manifest-file-name* (data-directory)))
        (manifest (build-manifest)))
    (with-standard-io-syntax
      (let ((*print-readably* nil))
        (with-open-file (out pathname
                             :direction :output
                             :if-exists :supersede
                             :external-format :utf-8)
          (format out ";;;; Generated by CLDocs ingestion; do not edit by hand.~%")
          (format out "(:sbcl-version ~S~% :quicklisp-dist ~S~% :packages~% ("
                  (getf manifest :sbcl-version)
                  (getf manifest :quicklisp-dist))
          (dolist (entry (getf manifest :packages))
            (format out "~%  ~S" entry))
          (format out ")~% )~%"))))
    pathname))

(defun read-manifest ()
  "Return the manifest plist stored on disk."
  (read-data-file (merge-pathnames *manifest-file-name* (data-directory))))

(defun manifest-stale-packages ()
  "Return the names of packages whose data file no longer matches the manifest."
  (let ((recorded (getf (read-manifest) :packages)))
    (loop for (package-name . properties) in recorded
          unless (equal (getf properties :sha256)
                        (file-sha256 (package-data-pathname package-name)))
            collect package-name)))
