;;;; site.lisp --- Build the static site from the versioned data.

(defpackage #:cldocs/site
  (:use #:cl)
  (:import-from #:cldocs/conditions
                #:design-system-missing
                #:output-directory-not-empty)
  (:import-from #:cldocs/community
                #:load-community-examples)
  (:import-from #:cldocs/examples
                #:example-name
                #:example-package
                #:read-examples)
  (:import-from #:cldocs/i18n
                #:*locale*
                #:+locales+
                #:locale-code
                #:tr)
  (:import-from #:cldocs/kinds
                #:+definition-kinds+)
  (:import-from #:cldocs/manifest
                #:read-manifest)
  (:import-from #:cldocs/model
                #:group-definitions)
  (:import-from #:cldocs/related
                #:build-related-index)
  (:import-from #:cldocs/render
                #:*base-path*
                #:*live-api-p*
                #:*repository-url*
                #:*toolchain-note*
                #:render-about
                #:render-examples
                #:render-home
                #:render-not-found
                #:render-package
                #:render-symbol
                #:render-terms
                #:render-trail
                #:render-trails-index)
  (:import-from #:cldocs/trails
                #:load-trails
                #:trail-slug)
  (:import-from #:cldocs/search-index
                #:build-search-index)
  (:import-from #:cldocs/store
                #:read-package-data
                #:read-package-system
                #:stored-package-names)
  (:import-from #:cldocs/urls
                #:*site-url*
                #:+about-path+
                #:+home-path+
                #:+not-found-file+
                #:+robots-file+
                #:+sitemap-file+
                #:+terms-path+
                #:+trails-path+
                #:absolute-url
                #:localized-path
                #:package-path
                #:search-index-file
                #:symbol-path
                #:trail-path)
  (:export #:build-site
           #:design-system-directory))

(in-package #:cldocs/site)

(defparameter *design-system-variable* "CLDOCS_DESIGN_SYSTEM"
  "Environment variable that overrides the design system location.")

(defparameter *vendored-design-system* "vendor/borba-design-system/"
  "Snapshot of the design system kept in this repository.")

(defparameter *tokens-file* "tokens.css"
  "Design token stylesheet inside the design system.")

(defparameter *font-files* '("Inter.ttf" "JetBrainsMono.ttf")
  "Font files copied from the design system; Playfair Display is unused.")

(defparameter *site-marker* ".cldocs-site"
  "File whose presence proves a directory is generated site output.")

(defparameter *index-file* "index.html"
  "File name of every page inside its own directory.")

(defparameter *own-assets* '("site.css" "search.js" "community.js" "favicon.svg" "share.png")
  "Static files that live in this repository's assets/ directory.")

(defun design-system-directory ()
  "Return the directory of the Borba Design System.

Uses the CLDOCS_DESIGN_SYSTEM environment variable when set, otherwise the
snapshot in vendor/borba-design-system/."
  (let ((override (uiop:getenv *design-system-variable*)))
    (uiop:ensure-directory-pathname
     (if (and override (string/= override ""))
         override
         (asdf:system-relative-pathname "cldocs" *vendored-design-system*)))))

(defun write-text-file (pathname text)
  "Write TEXT to PATHNAME as UTF-8, creating parent directories.

- PATHNAME: the destination file.
- TEXT: the file contents, a string."
  (ensure-directories-exist pathname)
  (with-open-file (out pathname
                       :direction :output
                       :if-exists :supersede
                       :external-format :utf-8)
    (write-string text out))
  pathname)

(defun write-page (output path html)
  "Write HTML as the page at PATH below OUTPUT and return the pathname.

- OUTPUT: the site output directory.
- PATH: page path such as \"sym/common-lisp/car/\"; the empty string is the home page.
- HTML: the rendered page, a string."
  (write-text-file (merge-pathnames (concatenate 'string path *index-file*) output)
                   html))

(defun prepare-output-directory (output)
  "Empty OUTPUT when it is a previous CLDocs site, and make sure it exists.

Signals OUTPUT-DIRECTORY-NOT-EMPTY for any other non-empty directory.

- OUTPUT: the directory pathname that will receive the site."
  (let ((marker (merge-pathnames *site-marker* output)))
    (when (uiop:directory-exists-p output)
      (cond ((probe-file marker)
             (uiop:delete-directory-tree output :validate t))
            ((or (uiop:directory-files output)
                 (uiop:subdirectories output))
             (error 'output-directory-not-empty :pathname output))))
    (write-text-file marker "Generated by CLDocs; safe to delete.")))

(defun require-design-file (design-system name)
  "Return the pathname of NAME inside DESIGN-SYSTEM or signal DESIGN-SYSTEM-MISSING.

- DESIGN-SYSTEM: the design system directory.
- NAME: path of the wanted file relative to it."
  (let ((pathname (merge-pathnames name design-system)))
    (unless (probe-file pathname)
      (error 'design-system-missing :pathname pathname))
    pathname))

(defun copy-assets (output design-system)
  "Copy stylesheets, scripts, tokens and fonts into OUTPUT/assets/.

- OUTPUT: the site output directory.
- DESIGN-SYSTEM: the design system directory."
  (let ((assets (merge-pathnames "assets/" output))
        (own (asdf:system-relative-pathname "cldocs" "assets/")))
    (ensure-directories-exist assets)
    (dolist (name *own-assets*)
      (uiop:copy-file (merge-pathnames name own)
                      (merge-pathnames name assets)))
    (uiop:copy-file (require-design-file design-system *tokens-file*)
                    (merge-pathnames *tokens-file* assets))
    (dolist (font *font-files*)
      (let ((target (merge-pathnames (concatenate 'string "fonts/" font) assets)))
        (ensure-directories-exist target)
        (uiop:copy-file (require-design-file design-system
                                             (concatenate 'string "fonts/" font))
                        target)))))

(defun toolchain-note ()
  "Return the footer sentence naming the tools the data was produced with, in the current locale."
  (let ((manifest (read-manifest)))
    (tr :toolchain-note
        (getf manifest :sbcl-version)
        (getf manifest :quicklisp-dist))))

(defparameter *first-package* "COMMON-LISP"
  "Package listed first on the home page; the others follow alphabetically.")

(defun ordered-package-names ()
  "Return the stored package names with COMMON-LISP first."
  (let ((names (stored-package-names)))
    (if (member *first-package* names :test #'string=)
        (cons *first-package* (remove *first-package* names :test #'string=))
        names)))

(defun all-packages ()
  "Return a plist (:name :entries :system) for every stored package, in display order."
  (mapcar (lambda (package-name)
            (list :name package-name
                  :entries (group-definitions (read-package-data package-name))
                  :system (read-package-system package-name)))
          (ordered-package-names)))

(defun examples-by-name (package-name community)
  "Return a table from symbol name to the examples shown for that symbol.

Seeded examples come first, then the community's, in file order.

- PACKAGE-NAME: the documented package, a string.
- COMMUNITY: every loaded community EXAMPLE, of any package."
  (let ((table (make-hash-table :test #'equal)))
    (dolist (example (append (read-examples package-name)
                             (remove-if-not (lambda (example)
                                              (string= (example-package example) package-name))
                                            community))
                     table)
      (setf (gethash (example-name example) table)
            (append (gethash (example-name example) table) (list example))))))

(defun emit-package-pages (emit package community)
  "Emit the package page and every symbol page of one package in the current locale.

- EMIT: function of an unlocalized path and an HTML string that writes and counts a page.
- PACKAGE: a plist (:name :entries :system) as returned by ALL-PACKAGES.
- COMMUNITY: every loaded community EXAMPLE."
  (let* ((package-name (getf package :name))
         (entries (getf package :entries))
         (system (getf package :system))
         (examples (examples-by-name package-name community))
         (related (build-related-index package-name entries)))
    (funcall emit
             (package-path package-name)
             (render-package package-name entries +definition-kinds+ :system system))
    (dolist (entry entries)
      (let ((name (cldocs/model:symbol-entry-name entry)))
        (funcall emit
                 (symbol-path package-name name)
                 (render-symbol entry
                                :examples-html (render-examples (gethash name examples))
                                :system system
                                :related (mapcar (lambda (related-name)
                                                   (cons package-name related-name))
                                                 (gethash name related))))))))

(defun entries-by-symbol (packages)
  "Return a table from (package . name) to the SYMBOL-ENTRY documenting it.

- PACKAGES: the plists returned by ALL-PACKAGES."
  (let ((table (make-hash-table :test #'equal)))
    (dolist (package packages table)
      (dolist (entry (getf package :entries))
        (setf (gethash (cons (getf package :name) (cldocs/model:symbol-entry-name entry)) table)
              entry)))))

(defun emit-locale-pages (emit packages trails community)
  "Emit every page of the current locale.

- EMIT: function of an unlocalized path and an HTML string that writes and counts a page.
- PACKAGES: the plists returned by ALL-PACKAGES.
- TRAILS: the loaded TRAIL records.
- COMMUNITY: every loaded community EXAMPLE."
  (let ((*toolchain-note* (toolchain-note))
        (by-symbol (entries-by-symbol packages)))
    (funcall emit +home-path+
             (render-home (mapcar (lambda (package)
                                    (list (getf package :name)
                                          (length (getf package :entries))
                                          (getf package :system)))
                                  packages)))
    (funcall emit +about-path+ (render-about))
    (funcall emit +terms-path+ (render-terms))
    (funcall emit +trails-path+ (render-trails-index trails))
    (dolist (trail trails)
      (funcall emit (trail-path (trail-slug trail)) (render-trail trail by-symbol)))
    (dolist (package packages)
      (emit-package-pages emit package community))))

(defparameter *sitemap-header*
  "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\" xmlns:xhtml=\"http://www.w3.org/1999/xhtml\">"
  "Opening of the sitemap document, declaring the alternate-language namespace.")

(defparameter *sitemap-footer* "</urlset>"
  "Closing of the sitemap document.")

(defun xml-escape (text)
  "Return TEXT with the characters that XML reserves written as entities.

- TEXT: the string to escape."
  (with-output-to-string (out)
    (loop for char across text
          do (case char
               (#\& (write-string "&amp;" out))
               (#\< (write-string "&lt;" out))
               (#\> (write-string "&gt;" out))
               (#\" (write-string "&quot;" out))
               (t (write-char char out))))))

(defun sitemap-entry (path)
  "Return the sitemap <url> element of the page PATH, one per language.

Each language lists every translation as an alternate, as search engines expect.

- PATH: an unlocalized page path."
  (with-output-to-string (out)
    (dolist (locale +locales+)
      (format out "~&  <url>~%    <loc>~A</loc>~%" (xml-escape (absolute-url path locale)))
      (dolist (alternate +locales+)
        (format out "    <xhtml:link rel=\"alternate\" hreflang=\"~A\" href=\"~A\"/>~%"
                (locale-code alternate)
                (xml-escape (absolute-url path alternate))))
      (format out "  </url>"))))

(defun sitemap-text (paths)
  "Return the sitemap document listing PATHS in every language.

- PATHS: unlocalized page paths, in the order to list them."
  (format nil "~A~%~{~A~^~%~}~%~A~%"
          *sitemap-header*
          (mapcar #'sitemap-entry paths)
          *sitemap-footer*))

(defun robots-text ()
  "Return the robots.txt that allows every crawler and names the sitemap."
  (format nil "User-agent: *~%Allow: /~%~%Sitemap: ~A~%"
          (concatenate 'string *site-url* "/" +sitemap-file+)))

(defun environment-flag (name)
  "Return true when the environment variable NAME is set to a non-empty value.

- NAME: the variable name."
  (let ((value (uiop:getenv name)))
    (and value (string/= value ""))))

(defun build-site (output
                   &key
                     (design-system (design-system-directory))
                     (site-url (uiop:getenv "CLDOCS_SITE_URL")))
  "Generate the whole static site into OUTPUT and return the number of pages.

Reads CLDOCS_REPOSITORY (enables contribution buttons), CLDOCS_BASE_PATH (the
path the site is served under, for the 404 page), CLDOCS_SITE_URL (public
address of the site; enables the sitemap, robots.txt, canonical links and Open
Graph addresses) and CLDOCS_API (adds the
optional live community section). Signals DESIGN-SYSTEM-MISSING when tokens or
fonts cannot be found, OUTPUT-DIRECTORY-NOT-EMPTY when OUTPUT holds files that
are not a CLDocs site, and COMMUNITY-EXAMPLE-INVALID for a broken contribution.

- OUTPUT: directory that will receive the site.
- DESIGN-SYSTEM: directory of the Borba Design System.
- SITE-URL: public address of the site, or NIL; defaults to CLDOCS_SITE_URL."
  (let* ((output (uiop:ensure-directory-pathname output))
         (packages (all-packages))
         (trails (load-trails))
         (community (load-community-examples))
         (pages 0)
         (listed-paths '())
         (*site-url* (and site-url
                          (string/= site-url "")
                          (string-right-trim "/" site-url)))
         (*repository-url* (let ((url (uiop:getenv "CLDOCS_REPOSITORY")))
                             (and url (string/= url "") (string-right-trim "/" url))))
         (*base-path* (let ((path (uiop:getenv "CLDOCS_BASE_PATH")))
                        (if (and path (string/= path "")) path "/")))
         (*live-api-p* (environment-flag "CLDOCS_API")))
    (require-design-file design-system *tokens-file*)
    (prepare-output-directory output)
    (copy-assets output design-system)
    (dolist (locale +locales+)
      (let ((*locale* locale))
        (flet ((emit (path html)
                 (write-page output (localized-path path) html)
                 (when (eq locale (first +locales+))
                   (push path listed-paths))
                 (incf pages)))
          (emit-locale-pages #'emit packages trails community))
        (write-text-file (merge-pathnames (search-index-file) output)
                         (build-search-index (loop for package in packages
                                                   append (getf package :entries))))))
    (let ((*locale* :en))
      (write-text-file (merge-pathnames +not-found-file+ output)
                       (render-not-found)))
    (when *site-url*
      (write-text-file (merge-pathnames +sitemap-file+ output)
                       (sitemap-text (nreverse listed-paths)))
      (write-text-file (merge-pathnames +robots-file+ output)
                       (robots-text)))
    pages))
