;;;; store.lisp --- Versioned, human-readable package data files.

(defpackage #:cldocs/store
  (:use #:cl)
  (:import-from #:cldocs/conditions
                #:malformed-data-file)
  (:import-from #:cldocs/definition
                #:definition->plist
                #:plist->definition)
  (:import-from #:cldocs/slug
                #:slugify)
  (:export #:*data-directory*
           #:data-directory
           #:package-data-pathname
           #:write-package-data
           #:read-package-data
           #:read-data-file
           #:stored-package-names))

(in-package #:cldocs/store)

(defvar *data-directory* nil
  "When non-NIL, a directory pathname that overrides the checked-in data/.")

(defparameter *packages-subdirectory* "packages"
  "Directory below the data root holding one file per ingested package.")

(defparameter *data-file-type* "sexp"
  "File type of every versioned data file.")

(defparameter *generated-header*
  ";;;; Generated by CLDocs ingestion; do not edit by hand."
  "First line of every generated data file.")

(defun data-directory ()
  "Return the directory holding versioned data (data/ unless overridden)."
  (or *data-directory*
      (asdf:system-relative-pathname "cldocs" "data/")))

(defun package-data-pathname (package-name)
  "Return the data file path for the package named PACKAGE-NAME.

- PACKAGE-NAME: the package name as a string."
  (merge-pathnames (make-pathname :directory (list :relative *packages-subdirectory*)
                                  :name (slugify package-name)
                                  :type *data-file-type*)
                   (data-directory)))

(defun read-data-file (pathname)
  "Read the single form stored in PATHNAME, with evaluation disabled.

Signals MALFORMED-DATA-FILE when the file is missing or unreadable.

- PATHNAME: the data file to read."
  (unless (probe-file pathname)
    (error 'malformed-data-file :pathname pathname :reason "file does not exist"))
  (handler-case
      (with-standard-io-syntax
        (let ((*read-eval* nil))
          (with-open-file (in pathname :external-format :utf-8)
            (read in))))
    (reader-error (condition)
      (error 'malformed-data-file
             :pathname pathname
             :reason (princ-to-string condition)))
    (end-of-file ()
      (error 'malformed-data-file :pathname pathname :reason "empty file"))))

(defun write-package-data (package-name definitions)
  "Write DEFINITIONS of PACKAGE-NAME to its data file and return the pathname.

DEFINITIONS are written in the order given, one per line, so diffs stay small.

- PACKAGE-NAME: the package name as a string.
- DEFINITIONS: a list of DEFINITION records."
  (let ((pathname (package-data-pathname package-name)))
    (ensure-directories-exist pathname)
    (with-standard-io-syntax
      (let ((*print-readably* nil))
        (with-open-file (out pathname
                             :direction :output
                             :if-exists :supersede
                             :external-format :utf-8)
          (write-package-form out package-name definitions))))
    pathname))

(defun write-package-form (out package-name definitions)
  "Print the package data form for DEFINITIONS onto the stream OUT.

- OUT: an output character stream.
- PACKAGE-NAME: the package name as a string.
- DEFINITIONS: a list of DEFINITION records."
  (format out "~A~%" *generated-header*)
  (format out "(:package ~S~% :definitions~% (" package-name)
  (dolist (definition definitions)
    (format out "~%  ~S" (definition->plist definition)))
  (format out ")~% )~%"))

(defun read-package-data (package-name)
  "Return the list of DEFINITION records stored for PACKAGE-NAME.

- PACKAGE-NAME: the package name as a string."
  (let* ((pathname (package-data-pathname package-name))
         (form (read-data-file pathname)))
    (unless (and (consp form) (string= (getf form :package) package-name))
      (error 'malformed-data-file
             :pathname pathname
             :reason "package name does not match file"))
    (mapcar (lambda (plist) (plist->definition plist package-name))
            (getf form :definitions))))

(defun stored-package-names ()
  "Return the names of every package with a data file, sorted alphabetically."
  (let ((pattern (merge-pathnames (make-pathname :directory (list :relative
                                                                  *packages-subdirectory*)
                                                 :name :wild
                                                 :type *data-file-type*)
                                  (data-directory))))
    (sort (mapcar (lambda (pathname)
                    (getf (read-data-file pathname) :package))
                  (directory pattern))
          #'string<)))
